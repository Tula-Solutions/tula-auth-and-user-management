# Where the Next.js SERVER reaches the Tula API (never the browser: it talks to /api/tula).
TULA_API_URL=http://localhost:3003
# The environment's publishable key (bun run seed prints one; or bun run api-key:create).
NEXT_PUBLIC_TULA_PUBLISHABLE_KEY=tula_pk_dev_replace_me
# The environment's id: the `aud` of its access tokens.
TULA_ENVIRONMENT_ID=replace-with-the-environment-id
# Only when the API's PUBLIC_URL differs from TULA_API_URL (e.g. an internal address above):
# TULA_ISSUER=https://auth.example.com/v1/environments/<environment id>
# Only for `stateful` session profiles. A SECRET: never give it a NEXT_PUBLIC_ name.
# TULA_SECRET_KEY=tula_sk_dev_replace_me
# This app's public origin, when it is served behind a proxy that rewrites Host:
# TULA_APP_URL=https://app.example.com
