# Copy to .env.local. Both values are public: Expo puts every EXPO_PUBLIC_* variable into
# the app's bundle. Never put a secret key here.

# The Tula API as the phone reaches it. Not localhost on a device: the computer's address
# on the network, or http://10.0.2.2:3003 from the Android emulator.
EXPO_PUBLIC_TULA_API_URL=http://localhost:3003

# The environment's publishable key (bun run api-key:create --environment <id> --kind publishable).
EXPO_PUBLIC_TULA_PUBLISHABLE_KEY=

# Optional. The domain the app shares credentials with: the environment's passkeys.rpId.
# app.config.ts gives it to the config plugin (Associated Domains on iOS).
EXPO_PUBLIC_TULA_DOMAIN=

# Optional. Google's OAuth client ids, for its native sheet: the web client id, and the iOS
# client id for an iPhone. Neither is a secret. The environment's Google provider has the
# web one as its client id and the iOS one among its additional client ids.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
