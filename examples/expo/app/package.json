{
  "name": "tula-example-expo",
  "version": "0.0.0",
  "private": true,
  "description": "An Expo app on @tula/expo: sign up, sign in with a password, an emailed code, a passkey, a provider or Apple's and Google's own sheets, stay signed in with a session bound to a device key. Not a workspace package of the repository: see ../README.md.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform ios --platform android --output-dir .bundle"
  },
  "dependencies": {
    "@tula/contract": "file:../../../.release/tula-contract-0.0.0.tgz",
    "@tula/core": "file:../../../.release/tula-core-0.0.0.tgz",
    "@pagopa/io-react-native-crypto": "~1.2.5",
    "@tula/expo": "file:../../../.release/tula-expo-0.0.0.tgz",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "~2.3.0",
    "react-native-nitro-modules": ">=0.36.0",
    "react-native-passkey": "~3.6.2"
  },
  "overrides": {
    "@tula/contract": "file:../../../.release/tula-contract-0.0.0.tgz",
    "@tula/core": "file:../../../.release/tula-core-0.0.0.tgz"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "^5.9.0"
  }
}
