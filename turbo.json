{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "out/**"] },
    "typecheck": { "outputs": [] },
    "test": { "outputs": [] },
    "test:coverage": { "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
