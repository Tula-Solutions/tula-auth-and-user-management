{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["generate:check"],
      "outputs": []
    },
    "generate:check": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["generate:check"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["generate:check"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL", "DATABASE_MIGRATION_URL", "REDIS_TEST_URL", "CI"]
    }
  }
}
