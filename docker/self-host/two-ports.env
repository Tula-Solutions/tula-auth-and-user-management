# The `two-ports` stack of CI's `self-host` job (.github/workflows/ci.yml): the runner talks to
# each instance on its own port, the only way to say which instance a step went to (the
# `two instances` scenario). A test fixture, read only as
#
#   docker compose -p self-host-two-ports --env-file docker/self-host/two-ports.env ...
#
# Host ports of its own, beside the job's two other stacks. The issuer of the tokens is the
# first instance's address (API_PUBLIC_URL unset). Nothing secret here.
POSTGRES_PORT=5433
REDIS_PORT=6380
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
API_PORT=3013
API_2_PORT=3014
LB_PORT=3015
# The proxy says the address it saw (the default), as a real one must.
LB_CLIENT_ADDRESS=peer
TRUST_PROXY=true
# The mock provider (ADR 0026) and the development SMS inbox (ADR 0037), as in one-address.env.
OAUTH_MOCK_PROVIDER=true
SMS_PROVIDER=dev
