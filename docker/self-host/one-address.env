# The `one-address` stack of CI's `self-host` job (.github/workflows/ci.yml): every scenario
# goes through the proxy in front of both instances, as a real deployment is reached
# (conformance/README.md, "Behind one address"). A test fixture, read only as
#
#   docker compose -p self-host-one-address --env-file docker/self-host/one-address.env ...
#
# The job runs three stacks of one image side by side on one runner, each a Compose project
# of its own, so each has host ports of its own. This one keeps the defaults: the commands of
# conformance/README.md are its commands. Nothing secret here: the master key is the job's.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=3003
API_2_PORT=3004
LB_PORT=3005
# The issuer of the tokens, and where the mock provider's pages are reached.
API_PUBLIC_URL=http://localhost:3005
# The runner sends each scenario from its own address in X-Forwarded-For; the proxy passes it
# through for this run only (docker/lb/forwarded-for.client.conf).
LB_CLIENT_ADDRESS=client
TRUST_PROXY=true
# The OAuth scenarios run against the API's own mock provider (ADR 0026), and the phone number
# scenarios read their codes from the development SMS inbox (ADR 0037). Compose runs the stack
# in the `local` tier, the only one the API accepts either in.
OAUTH_MOCK_PROVIDER=true
SMS_PROVIDER=dev
