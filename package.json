{
  "name": "tula-auth",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "prepare": "husky || true",
    "dev": "turbo run dev --filter=@tula/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsc --noEmit -p scripts && tsc --noEmit -p examples/core-playground && tsc --noEmit -p e2e",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "verify": "bun run check && bun run test:harness && turbo run typecheck generate:check test:coverage && bun run typecheck:scripts && bun run db:check && bun run contract:check && bun run --filter @tula/conformance schema:check && bun run packages:check",
    "verify:changed": "biome check --changed --no-errors-on-unmatched && turbo run typecheck generate:check test --affected",
    "reset:lock": "bun pm cache rm && bun x -y rimraf -g **/bun.lock* **/node_modules; bun install --force;",
    "test:harness": "bun test --timeout 30000 ./.claude/hooks",
    "db:generate": "bun run --filter @tula/db db:generate",
    "db:check": "bun run --filter @tula/db db:check",
    "db:migrate": "bun --env-file=.env run --filter @tula/db db:migrate",
    "seed": "bun --env-file=.env run --filter @tula/db seed",
    "test:integration": "turbo run test:integration",
    "contract:generate": "bun run --filter @tula/api contract:generate",
    "contract:check": "bun run --filter @tula/api contract:check",
    "core:generate": "bun run --filter @tula/core generate",
    "packages:check": "bun run scripts/packages.ts check",
    "release:dry-run": "bun run scripts/packages.ts release",
    "playground": "bun run examples/core-playground/serve.ts",
    "api-key:create": "bun --env-file=.env run apps/api/src/scripts/create-api-key.ts",
    "conformance": "bun run --filter @tula/conformance conformance",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "e2e:screenshots": "SCREENSHOTS=1 playwright test --config e2e/playwright.config.ts screenshots"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "bun-types": "^1.4.2",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "publint": "^0.3.24",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  }
}
