{
  "name": "tula-auth",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "prepare": "husky || true",
    "dev": "turbo run dev --filter=@tula-tech/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsc --noEmit -p scripts && tsc --noEmit -p examples/core-playground && tsc --noEmit -p examples/docs-snippets && tsc --noEmit -p examples/docs-snippets/web &&tsc --noEmit -p examples/expo && tsc --noEmit -p e2e && tsc --noEmit -p native/swift/fixture && tsc --noEmit -p native/android/fixture",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "verify": "bun run check && bun run test:harness && turbo run typecheck generate:check test:coverage && bun run typecheck:scripts && bun run db:check && bun run contract:check && bun run --filter @tula-tech/conformance schema:check && bun run packages:check && bun run registry:check && bun run docs:check",
    "verify:static": "bun run check && bun run test:harness && turbo run typecheck generate:check && bun run typecheck:scripts && bun run db:check && bun run contract:check && bun run --filter @tula-tech/conformance schema:check && bun run packages:check && bun run registry:check && bun run docs:check",
    "test:coverage:api": "turbo run test:coverage --filter=@tula-tech/api",
    "test:coverage:dashboard": "turbo run test:coverage --filter=@tula-tech/dashboard",
    "test:coverage:rest": "turbo run test:coverage --filter=!@tula-tech/api --filter=!@tula-tech/dashboard",
    "verify:changed": "biome check --changed --no-errors-on-unmatched && turbo run typecheck generate:check test --affected",
    "reset:lock": "bun pm cache rm && bun x -y rimraf -g **/bun.lock* **/node_modules; bun install --force;",
    "test:harness": "bun test --timeout 30000 ./.claude/hooks ./e2e/guard.test.ts ./e2e/projects.test.ts ./e2e/chunks.test.ts",
    "db:generate": "bun run --filter @tula-tech/db db:generate",
    "db:check": "bun run --filter @tula-tech/db db:check",
    "db:migrate": "bun --env-file=.env run --filter @tula-tech/db db:migrate",
    "seed": "bun --env-file=.env run --filter @tula-tech/db seed",
    "test:integration": "turbo run test:integration",
    "contract:generate": "bun run --filter @tula-tech/api contract:generate",
    "contract:check": "bun run --filter @tula-tech/api contract:check",
    "core:generate": "bun run --filter @tula-tech/core generate",
    "admin:generate": "bun run --filter @tula-tech/admin generate",
    "native:generate": "bun run --filter @tula-tech/core generate:native",
    "native:check": "bun run --filter @tula-tech/core generate:native:check",
    "native:kotlin:test": "bun run scripts/kotlin-test.ts",
    "dashboard:dev": "bun run --filter @tula-tech/dashboard dev",
    "dashboard:build": "bun run --filter @tula-tech/dashboard build",
    "dashboard:generate": "bun run --filter @tula-tech/dashboard generate",
    "docs-site:dev": "bun run --filter @tula-tech/docs dev",
    "docs-site:build": "bun run --filter @tula-tech/docs build",
    "packages:check": "bun run scripts/packages.ts check",
    "packages:states": "bun run scripts/packages.ts states",
    "registry:generate": "bun run --filter @tula-tech/ui registry:generate",
    "registry:check": "bun run --filter @tula-tech/ui registry:check",
    "docs:generate": "bun run scripts/docs.ts",
    "docs:check": "bun run scripts/docs.ts --check",
    "release:dry-run": "bun run scripts/packages.ts release --dry-run",
    "release:publish": "bun run scripts/packages.ts release --publish",
    "playground": "bun run examples/core-playground/serve.ts",
    "tula": "bun run packages/cli/src/bin.ts",
    "api-key:create": "bun --env-file=.env run apps/api/src/scripts/create-api-key.ts",
    "conformance": "bun run --filter @tula-tech/conformance conformance",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "e2e:screenshots": "SCREENSHOTS=1 playwright test --config e2e/playwright.config.ts screenshots"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "bun-types": "^1.4.2",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "ts-morph": "28.0.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
