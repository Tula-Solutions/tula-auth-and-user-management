{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(bun install)",
      "Bash(bunx biome:*)",
      "Bash(bunx turbo:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx drizzle-kit generate:*)",
      "Bash(bunx drizzle-kit check:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git merge-base:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Skill(otterbot-review)",
      "Skill(verify)",
      "Skill(review-loop)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.dev)",
      "Read(./**/.env.dev)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.prod)",
      "Read(./**/.env.prod)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Read(./.env.qa)",
      "Read(./**/.env.qa)",
      "Read(./.env.ci)",
      "Read(./**/.env.ci)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(bunx drizzle-kit push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
