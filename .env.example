# Copy to .env and adjust. Bun loads .env automatically.

# Deployment tier: local | dev | staging | prod (gates real side effects — never NODE_ENV).
ENVIRONMENT=local

# API runtime connection — the non-owner tula_api role, so row-level security applies.
DATABASE_URL=postgres://tula_api:tula_api@127.0.0.1:5432/tula
# Schema owner, used only by `bun run db:migrate`.
DATABASE_MIGRATION_URL=postgres://tula:tula@127.0.0.1:5432/tula

# --- API (apps/api) ---
PORT=3003
LOG_LEVEL=info
# Public base URL of the API; the `iss` of every access token. Must be https in staging/prod,
# and in every tier while TULA_ADMIN_TOKEN is set unless it is a loopback address (localhost,
# 127.0.0.1, [::1], *.localhost): the server refuses to start otherwise.
PUBLIC_URL=http://localhost:3003
# 32 bytes as hex. Encrypts signing keys at rest; losing it invalidates stored secrets.
# Generate your own: openssl rand -hex 32
TULA_MASTER_KEY=
# Optional. The instance admin token: `tula doctor` and the dashboard sign in with
# it. Unset, the /v1/instance/* routes do not exist. Needs PUBLIC_URL to be https or a
# loopback address (it would cross the network in clear text). At least 32 characters; a short,
# repeated, sequential or placeholder value fails the boot. That check only catches accidents:
# it does not measure randomness. Generate the value: openssl rand -hex 32
TULA_ADMIN_TOKEN=
# Optional. Directory of the dashboard's build output, served at /dashboard. Unset, the API
# looks in apps/dashboard/dist; a directory without an index.html means no dashboard.
# DASHBOARD_DIR=
# Mailpit locally (web UI http://localhost:8025). Staging/prod need a real relay.
SMTP_URL=smtp://127.0.0.1:1025
# Sender of verification emails. Staging/prod need a real domain.
MAIL_FROM=Tula Auth <no-reply@localhost>
# offline | hibp (hibp is required in staging/prod).
BREACH_CHECK=offline
# Default password rules: recommended (NIST: length + breach check) | strict | legacy.
# Applies to an environment until it saves its own settings (PUT /v1/admin/settings).
PASSWORD_POLICY=recommended
# Comma-separated browser origins: allowed for admin routes, and the default allowed origins
# of an environment until it saves its own settings.
# In the `local` tier any http://localhost:<port> origin is also allowed, except for the
# dashboard's session: that takes the API's own origin and this list only.
CORS_ORIGINS=
# Set true only behind a proxy that overwrites X-Forwarded-For. Behind a proxy it MUST be
# true: otherwise every client has the proxy's address and shares one rate-limit bucket.
TRUST_PROXY=false
# on | off. The API reference page at /v1/docs. Unset: on in local and dev, off in staging and
# prod. The page loads nothing from another host. /v1/openapi.json is served either way.
# API_DOCS=
# Days an instance audit entry (dashboard sign-ins, workspaces, projects) is kept (min 30).
# An environment's audit log has its own period: the audit.retentionDays setting.
# INSTANCE_AUDIT_RETENTION_DAYS=365
# Redis for the state API instances share: rate limits, password lockout, revoked sessions.
# Blank keeps it in process memory (one instance only; allowed in local and dev).
# Required in staging/prod. `docker compose up -d` runs one at redis://127.0.0.1:6379.
REDIS_URL=
# api | separate. Where webhook deliveries are made. `api` (the default): inside the API
# instances. `separate`: only in a worker process (the same image, started with
# `bun run src/worker.ts`), and the API instances make no delivery. Give EVERY process the same
# value, and with `separate` run the worker: without one nothing is delivered (`tula doctor`
# then fails `webhook_worker`). docs/self-host.md, "The webhook worker as its own service".
# WEBHOOK_WORKER=api

# Development and tests only. `true` serves every OAuth provider (Google, GitHub, Apple, Microsoft, Discord, LinkedIn) from a
# built-in mock provider whose consent page lets you type the address the "provider" reports,
# so OAuth can be exercised without real credentials. The server refuses to start with it unless
# ENVIRONMENT=local AND PUBLIC_URL is a loopback address (localhost, 127.0.0.1, [::1] or a
# *.localhost name), and logs a warning on every boot while it is on. Never turn it on for an
# API that anyone else can reach: it signs in anyone as any address.
# For real providers leave it off and set credentials per environment: docs/providers/.
OAUTH_MOCK_PROVIDER=false

# How text messages (SMS) are sent. `none`: no sender; a request that would send one is
# answered `sms.unavailable`. `dev`: development and tests only. Nothing is sent; the messages
# are kept in memory (the newest 50) and can be read at GET /v1/dev/sms/messages, codes
# included. The server refuses to start with `dev` unless ENVIRONMENT=local AND PUBLIC_URL is a
# loopback address, and logs a warning on every boot while it is on. Whether an environment
# sends text messages at all, and to which countries, is its `sms` setting (off by default).
SMS_PROVIDER=none
