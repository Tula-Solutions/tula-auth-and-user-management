# Copy to .env and adjust. Bun loads .env automatically.

# Deployment tier: local | dev | staging | prod (gates real side effects — never NODE_ENV).
ENVIRONMENT=local

# API runtime connection — the non-owner tula_api role, so row-level security applies.
DATABASE_URL=postgres://tula_api:tula_api@127.0.0.1:5432/tula
# Schema owner, used only by `bun run db:migrate`.
DATABASE_MIGRATION_URL=postgres://tula:tula@127.0.0.1:5432/tula

# --- API (apps/api) ---
PORT=3003
LOG_LEVEL=info
# Public base URL of the API; the `iss` of every access token. Must be https in staging/prod.
PUBLIC_URL=http://localhost:3003
# 32 bytes as hex. Encrypts signing keys at rest; losing it invalidates stored secrets.
# Generate your own: openssl rand -hex 32
TULA_MASTER_KEY=
# Optional. The instance admin token: `tula doctor` (and, later, the dashboard) sign in with
# it. Unset, the /v1/instance/* routes do not exist. At least 32 characters; a short,
# repeated, sequential or placeholder value fails the boot. That check only catches accidents:
# it does not measure randomness. Generate the value: openssl rand -hex 32
TULA_ADMIN_TOKEN=
# Mailpit locally (web UI http://localhost:8025). Staging/prod need a real relay.
SMTP_URL=smtp://127.0.0.1:1025
# Sender of verification emails. Staging/prod need a real domain.
MAIL_FROM=Tula Auth <no-reply@localhost>
# offline | hibp (hibp is required in staging/prod).
BREACH_CHECK=offline
# Default password rules: recommended (NIST: length + breach check) | strict | legacy.
# Applies to an environment until it saves its own settings (PUT /v1/admin/settings).
PASSWORD_POLICY=recommended
# Comma-separated browser origins: allowed for admin routes, and the default allowed origins
# of an environment until it saves its own settings.
# In the `local` tier any http://localhost:<port> origin is also allowed.
CORS_ORIGINS=
# Set true only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Redis for the state API instances share: rate limits, password lockout, revoked sessions.
# Blank keeps it in process memory (one instance only; allowed in local and dev).
# Required in staging/prod. `docker compose up -d` runs one at redis://127.0.0.1:6379.
REDIS_URL=

# Development and tests only. `true` serves every OAuth provider (Google, GitHub, Apple) from a
# built-in mock provider whose consent page lets you type the address the "provider" reports,
# so OAuth can be exercised without real credentials. The server refuses to start with it unless
# ENVIRONMENT=local AND PUBLIC_URL is a loopback address (localhost, 127.0.0.1, [::1] or a
# *.localhost name), and logs a warning on every boot while it is on. Never turn it on for an
# API that anyone else can reach: it signs in anyone as any address.
# For real providers leave it off and set credentials per environment: docs/providers/.
OAUTH_MOCK_PROVIDER=false
