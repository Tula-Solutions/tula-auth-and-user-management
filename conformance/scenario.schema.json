        "anyOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "request": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
                  },
                  "path": {
                    "type": "string",
                    "format": "starts_with",
                    "pattern": "^\\/.*"
                  },
                  "auth": {
                    "default": "publishable",
                    "type": "string",
                    "enum": ["publishable", "secret", "none"],
                    "ref": "ConformanceAuth"
                  },
                  "accessToken": {
                    "type": "string"
                  },
                  "client": {
                    "type": "string",
                    "enum": ["web", "ios", "android", "server"]
                  },
                  "attempt": {
                    "type": "string"
                  },
                  "body": {},
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "instance": {
                    "type": "string",
                    "enum": ["first", "second"]
                  }
                },
                "required": ["method", "path"],
                "ref": "ConformanceRequest"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
