{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "needsSecretKey": {
      "type": "boolean"
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "generate": {
                "type": "string",
                "enum": ["email", "password"]
              }
            },
            "required": ["generate"],
            "additionalProperties": false
          }
        ],
        "ref": "ConformanceVariable"
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "request": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
                  },
                  "path": {
                    "type": "string",
                    "format": "starts_with",
                    "pattern": "^\\/.*"
                  },
                  "auth": {
                    "default": "publishable",
                    "type": "string",
                    "enum": ["publishable", "secret", "none"],
                    "ref": "ConformanceAuth"
                  },
                  "accessToken": {
                    "type": "string"
                  },
                  "client": {
                    "type": "string",
                    "enum": ["web", "ios", "android", "server"]
                  },
                  "body": {},
                  "instance": {
                    "type": "string",
                    "enum": ["first", "second"]
                  }
                },
                "required": ["method", "path"],
                "ref": "ConformanceRequest"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "body": {},
                  "bodyExcludes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["status"],
                "ref": "ConformanceExpect"
              },
              "times": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "capture": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": ["name", "request", "expect"],
            "additionalProperties": false,
            "ref": "ConformanceRequestStep"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "emailCode": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "string"
                  },
                  "capture": {
                    "type": "string"
                  },
                  "captureWrong": {
                    "type": "string"
                  }
                },
                "required": ["to", "capture"]
              }
            },
            "required": ["name", "emailCode"],
            "additionalProperties": false,
            "ref": "ConformanceEmailCodeStep"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "wait": {
                "type": "string",
                "ref": "Duration"
              }
            },
            "required": ["name", "wait"],
            "additionalProperties": false,
            "ref": "ConformanceWaitStep"
          }
        ],
        "ref": "ConformanceStep"
      }
    }
  },
  "required": ["name", "description", "steps"],
  "additionalProperties": false,
  "ref": "ConformanceScenario"
}
