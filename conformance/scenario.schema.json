    "needsSecretKey": {
      "type": "boolean"
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "generate": {
                "type": "string",
                "enum": ["email", "password"]
              }
            },
            "required": ["generate"],
            "additionalProperties": false
          }
        ],
        "ref": "ConformanceVariable"
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
