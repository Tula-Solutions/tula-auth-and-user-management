{
  "$schema": "../scenario.schema.json",
  "name": "passwordless sign-up",
  "description": "A sign-up must choose a password unless the environment makes it optional. Where it is optional, a sign-up with only an email address creates an account with no password once the address is verified; that account signs in with an emailed code, and a password never works for it. A sign-up that does choose a password works as before. The settings are put back afterwards, even when a step fails.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "other": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    },
    "redirect": "https://app.conformance.example/auth/link"
  },
  "steps": [
    {
      "name": "where a password is required, a sign-up without one is a validation error",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed",
          "errors": [
            {
              "field": "password",
              "code": "validation.failed",
              "message": "$any"
            }
          ]
        }
      }
    },
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any",
          "settings": {
            "signIn": {
              "methods": {
                "password": {
                  "enabled": true
                }
              }
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "origins": "settings.urls.allowedOrigins",
        "audit": "settings.audit",
        "notifications": "settings.notifications"
      }
    },
    {
      "name": "an optional password is refused without the email code: the account could never sign in",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "signUp": {
            "password": "optional"
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "enable the email code and make the sign-up password optional",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "enabled": true
              },
              "emailCode": {
                "enabled": true
              },
              "emailLink": {
                "enabled": false
              }
            }
          },
          "signUp": {
            "password": "optional"
          },
          "urls": {
            "allowedOrigins": {
              "$json": "{{origins}}"
            },
            "allowedRedirectUrls": ["{{redirect}}"]
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "signIn": {
              "methods": {
                "emailCode": {
                  "enabled": true
                },
                "emailLink": {
                  "enabled": false
                }
              }
            },
            "signUp": {
              "password": "optional"
            }
          }
        }
      }
    },
    {
      "name": "the client config says a sign-up may leave the password out",
      "request": {
        "method": "GET",
        "path": "/v1/client/config"
      },
      "expect": {
        "status": 200,
        "body": {
          "signIn": {
            "methods": ["password", "emailCode"]
          },
          "signUp": {
            "password": "optional"
          }
        }
      }
    },
    {
      "name": "start a sign-up with only an email address",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "firstName": "Ines"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification",
            "strategies": ["email_code"]
          }
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "verifying the address creates the account and signs it in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "$any"
          },
          "session": {
            "accessToken": "$any",
            "refreshToken": "$any"
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken"
      }
    },
    {
      "name": "the account exists, with a verified address",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{userId}}",
          "firstName": "Ines",
          "emailVerifiedAt": "$any"
        }
      }
    },
    {
      "name": "it has no password to change",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/password",
        "accessToken": "{{accessToken}}",
        "body": {
          "currentPassword": "{{password}}",
          "newPassword": "{{password}}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "password.not_set"
        }
      }
    },
    {
      "name": "start a sign-in for the new account",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_in",
          "step": {
            "status": "needs_first_factor",
            "strategies": ["password", "email_code"]
          }
        }
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "no password signs it in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "the link was not enabled, so it cannot be asked for",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/first-factor/prepare",
        "attempt": "{{signInSecret}}",
        "body": {
          "strategy": "email_link",
          "redirectUrl": "{{redirect}}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "flow.invalid_step"
        }
      }
    },
    {
      "name": "let the per-address email cooldown pass",
      "wait": "61s"
    },
    {
      "name": "ask for an email code",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/first-factor/prepare",
        "attempt": "{{signInSecret}}",
        "body": {
          "strategy": "email_code"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_first_factor",
            "prepared": {
              "strategy": "email_code"
            }
          }
        }
      }
    },
    {
      "name": "read the sign-in code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signInCode"
      }
    },
    {
      "name": "the code signs the passwordless account in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/first-factor/attempt",
        "attempt": "{{signInSecret}}",
        "body": {
          "strategy": "email_code",
          "code": "{{signInCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          },
          "session": {
            "accessToken": "$any"
          }
        }
      }
    },
    {
      "name": "a sign-up that chooses a password still works",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{other}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_email_verification"
          }
        }
      }
    },
    {
      "name": "and a weak one is still refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{other}}",
          "password": "short"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "password.too_short"
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "signIn": {
              "methods": {
                "password": {
                  "enabled": true
                }
              }
            }
          }
        }
      }
    }
  ]
}
