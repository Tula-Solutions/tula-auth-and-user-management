{
  "$schema": "../scenario.schema.json",
  "name": "password expiry",
  "description": "Where the environment's password policy sets `password.expiryDays`, a sign-in with a password that is right and older than that many days does not sign in: the attempt stops at `needs_new_password` with `reason: \"expired\"`, with no session, and completes only once a new password is set through `/v1/client/sign-ins/{attemptId}/new-password`. A wrong password is answered `auth.invalid_credentials` exactly as before, whatever the password's age. The expired password is refused as its own replacement (`password.reused`, also with no password history), and a password the policy refuses leaves the attempt where it is. Afterwards the old password is wrong and the new one signs in. A password ages by the server's clock and the shortest expiry is one day, so this scenario runs only where the runner can move that clock (`needsTestClock`): in process. A live server skips it; what it cannot show there (the boundary to the millisecond, a second factor first, a password replaced while the attempt waits) is in the API's own tests. The settings are put back afterwards, even when a step fails.",
  "needsSecretKey": true,
  "needsTestClock": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "first": {
      "generate": "password"
    },
    "second": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{first}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signUpCode"
      }
    },
    {
      "name": "verify the address",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{signUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      }
    },
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "app": "settings.app",
        "signIn": "settings.signIn",
        "signUp": "settings.signUp",
        "urls": "settings.urls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfa": "settings.mfa",
        "sessions": "settings.sessions",
        "passkeys": "settings.passkeys",
        "sms": "settings.sms",
        "emails": "settings.emails"
      }
    },
    {
      "name": "passwords expire after one day",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "signIn": {
            "$json": "{{signIn}}"
          },
          "signUp": {
            "$json": "{{signUp}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfa}}"
          },
          "sessions": {
            "$json": "{{sessions}}"
          },
          "passkeys": {
            "$json": "{{passkeys}}"
          },
          "sms": {
            "$json": "{{sms}}"
          },
          "emails": {
            "$json": "{{emails}}"
          },
          "password": {
            "preset": "custom",
            "minLength": 12,
            "maxLength": 128,
            "requireLowercase": false,
            "requireUppercase": false,
            "requireNumber": false,
            "requireSpecial": false,
            "minCharacterClasses": 0,
            "specialChars": "!@#$%^&*()-_=+[]{};:,.?/\\|'\"`~<>",
            "disallowUserInfo": true,
            "disallowCommon": true,
            "breachCheck": "block",
            "maxRepeatedChars": null,
            "blockSequences": false,
            "history": 0,
            "expiryDays": 1
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "password": {
              "expiryDays": 1
            }
          }
        }
      }
    },
    {
      "name": "a sign-in on the day the password was set",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_password"
          }
        }
      },
      "capture": {
        "freshId": "id",
        "freshSecret": "attemptSecret"
      }
    },
    {
      "name": "the password is not a day old: it signs in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{freshId}}/password",
        "attempt": "{{freshSecret}}",
        "body": {
          "password": "{{first}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      }
    },
    {
      "name": "a day passes",
      "wait": "1d"
    },
    {
      "name": "a sign-in with the password, now a day old",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_password"
          }
        }
      },
      "capture": {
        "expiredId": "id",
        "expiredSecret": "attemptSecret"
      }
    },
    {
      "name": "a wrong password is answered as it always is",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{expiredId}}/password",
        "attempt": "{{expiredSecret}}",
        "body": {
          "password": "{{second}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "the right password does not sign in: a new one is asked for, and says why",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{expiredId}}/password",
        "attempt": "{{expiredSecret}}",
        "body": {
          "password": "{{first}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_new_password",
            "destination": "$any",
            "strategies": [],
            "reason": "expired"
          },
          "session": "$absent",
          "attemptSecret": "$absent"
        }
      }
    },
    {
      "name": "the expired password is refused as its own replacement",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{expiredId}}/new-password",
        "attempt": "{{expiredSecret}}",
        "body": {
          "password": "{{first}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "password.reused",
          "params": {
            "history": 1
          },
          "errors": [
            {
              "field": "$any",
              "code": "password.reused",
              "message": "$any",
              "params": {
                "history": 1
              }
            }
          ]
        }
      }
    },
    {
      "name": "a password the policy refuses leaves the attempt where it is",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{expiredId}}/new-password",
        "attempt": "{{expiredSecret}}",
        "body": {
          "password": "short"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "errors": [
            {
              "field": "$any",
              "code": "password.too_short",
              "message": "$any",
              "params": "$any"
            }
          ]
        }
      }
    },
    {
      "name": "a new password completes the sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{expiredId}}/new-password",
        "attempt": "{{expiredSecret}}",
        "body": {
          "password": "{{second}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "accessToken": "session.accessToken"
      }
    },
    {
      "name": "the session is the user's",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "the attempt is spent",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{expiredId}}/new-password",
        "attempt": "{{expiredSecret}}",
        "body": {
          "password": "{{first}}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "code": "flow.not_found"
        }
      }
    },
    {
      "name": "a sign-in with the old password",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_password"
          }
        }
      },
      "capture": {
        "oldId": "id",
        "oldSecret": "attemptSecret"
      }
    },
    {
      "name": "the old password is wrong now",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{oldId}}/password",
        "attempt": "{{oldSecret}}",
        "body": {
          "password": "{{first}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "a sign-in with the new password",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_password"
          }
        }
      },
      "capture": {
        "newId": "id",
        "newSecret": "attemptSecret"
      }
    },
    {
      "name": "the new password signs in, and is not asked to be replaced",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{newId}}/password",
        "attempt": "{{newSecret}}",
        "body": {
          "password": "{{second}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
