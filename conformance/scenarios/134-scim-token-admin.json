{
  "$schema": "../scenario.schema.json",
  "name": "scim tokens: create, use, revoke",
  "description": "An administrator creates a SCIM token for an organization (ADR 0067): it is shown once and not in the list, it opens the SCIM group and nothing else, a secret key does not open the SCIM group, and a revoked token is refused.",
  "needsSecretKey": true,
  "variables": {
    "suffix": {
      "generate": "snowflake"
    }
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "appSettings": "settings.app",
        "passwordSettings": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urlsSettings": "settings.urls",
        "auditSettings": "settings.audit",
        "notificationsSettings": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeysSettings": "settings.passkeys",
        "smsSettings": "settings.sms",
        "emailsSettings": "settings.emails"
      }
    },
    {
      "name": "an administrator switches organizations and single sign-on on",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{appSettings}}"
          },
          "password": {
            "$json": "{{passwordSettings}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urlsSettings}}"
          },
          "audit": {
            "$json": "{{auditSettings}}"
          },
          "notifications": {
            "$json": "{{notificationsSettings}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeysSettings}}"
          },
          "sms": {
            "$json": "{{smsSettings}}"
          },
          "emails": {
            "$json": "{{emailsSettings}}"
          },
          "organizations": {
            "enabled": true,
            "allowUserCreated": false,
            "maxCreatedPerUser": 1,
            "creatorRole": "admin",
            "defaultRole": "member",
            "personalAccount": true
          },
          "sso": {
            "enabled": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sso": {
              "enabled": true
            }
          }
        }
      }
    },
    {
      "name": "an administrator creates an organization",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations",
        "auth": "secret",
        "body": {
          "name": "SCIM Org",
          "slug": "scim-{{suffix}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "orgId": "id"
      }
    },
    {
      "name": "and creates a SCIM token for it",
      "request": {
        "method": "POST",
        "path": "/v1/admin/scim-tokens",
        "auth": "secret",
        "body": {
          "organizationId": "{{orgId}}",
          "name": "Okta"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "token": "$any"
        }
      },
      "capture": {
        "scimToken": "token",
        "scimTokenId": "id"
      }
    },
    {
      "name": "the list shows the token and never its secret",
      "request": {
        "method": "GET",
        "path": "/v1/admin/scim-tokens?organizationId={{orgId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "tokens": [
            {
              "id": "{{scimTokenId}}",
              "token": "$absent"
            }
          ]
        }
      }
    },
    {
      "name": "the token opens the SCIM group",
      "request": {
        "method": "GET",
        "path": "/v1/scim/v2/ServiceProviderConfig",
        "auth": "none",
        "accessToken": "{{scimToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "patch": {
            "supported": true
          }
        }
      }
    },
    {
      "name": "but no admin route",
      "request": {
        "method": "GET",
        "path": "/v1/admin/scim-tokens?organizationId={{orgId}}",
        "auth": "none",
        "accessToken": "{{scimToken}}"
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_key"
        }
      }
    },
    {
      "name": "and a secret key does not open the SCIM group",
      "request": {
        "method": "GET",
        "path": "/v1/scim/v2/Users",
        "auth": "secret"
      },
      "expect": {
        "status": 401,
        "body": {
          "schemas": ["urn:ietf:params:scim:api:messages:2.0:Error"],
          "status": "401"
        }
      }
    },
    {
      "name": "an administrator revokes it",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/scim-tokens/{{scimTokenId}}?organizationId={{orgId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "a revoked token is refused",
      "request": {
        "method": "GET",
        "path": "/v1/scim/v2/Users",
        "auth": "none",
        "accessToken": "{{scimToken}}"
      },
      "expect": {
        "status": 401,
        "body": {
          "schemas": ["urn:ietf:params:scim:api:messages:2.0:Error"],
          "status": "401"
        }
      }
    },
    {
      "name": "a second revocation is not found",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/scim-tokens/{{scimTokenId}}?organizationId={{orgId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 404
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
