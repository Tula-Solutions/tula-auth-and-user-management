{
  "$schema": "../scenario.schema.json",
  "name": "password history",
  "description": "Where the environment's password policy remembers passwords (`password.history`), a user's new password must not be the current one or one of those before it, as many as the number says. The rule is applied where a password replaces one: a change by the signed-in user and a reset. The refusal is `password.reused` with the policy's number and nothing about which password matched; a reset refused that way has not spent its code. A password the user never had is accepted, and with the history back at 0 an old password is accepted again. The settings are put back afterwards, even when a step fails.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "first": {
      "generate": "password"
    },
    "second": {
      "generate": "password"
    },
    "third": {
      "generate": "password"
    },
    "fourth": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{first}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signUpCode"
      }
    },
    {
      "name": "verify the address",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{signUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken"
      }
    },
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "app": "settings.app",
        "signIn": "settings.signIn",
        "signUp": "settings.signUp",
        "urls": "settings.urls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfa": "settings.mfa",
        "sessions": "settings.sessions",
        "passkeys": "settings.passkeys",
        "sms": "settings.sms"
      }
    },
    {
      "name": "remember the last three passwords",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "signIn": {
            "$json": "{{signIn}}"
          },
          "signUp": {
            "$json": "{{signUp}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfa}}"
          },
          "sessions": {
            "$json": "{{sessions}}"
          },
          "passkeys": {
            "$json": "{{passkeys}}"
          },
          "sms": {
            "$json": "{{sms}}"
          },
          "password": {
            "preset": "custom",
            "minLength": 12,
            "maxLength": 128,
            "requireLowercase": false,
            "requireUppercase": false,
            "requireNumber": false,
            "requireSpecial": false,
            "minCharacterClasses": 0,
            "specialChars": "!@#$%^&*()-_=+[]{};:,.?/\\|'\"`~<>",
            "disallowUserInfo": true,
            "disallowCommon": true,
            "breachCheck": "block",
            "maxRepeatedChars": null,
            "blockSequences": false,
            "history": 3,
            "expiryDays": null
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "password": {
              "history": 3
            }
          }
        }
      }
    },
    {
      "name": "the current password is one of the three, and is refused as the new one",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/password",
        "accessToken": "{{accessToken}}",
        "body": {
          "currentPassword": "{{first}}",
          "newPassword": "{{first}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "password.reused",
          "params": {
            "history": 3
          },
          "errors": [
            {
              "field": "$any",
              "code": "password.reused",
              "message": "$any",
              "params": {
                "history": 3
              }
            }
          ]
        }
      }
    },
    {
      "name": "a password the user never had is accepted",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/password",
        "accessToken": "{{accessToken}}",
        "body": {
          "currentPassword": "{{first}}",
          "newPassword": "{{second}}"
        }
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "the password before the current one is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/password",
        "accessToken": "{{accessToken}}",
        "body": {
          "currentPassword": "{{second}}",
          "newPassword": "{{first}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "password.reused",
          "params": {
            "history": 3
          },
          "errors": [
            {
              "field": "$any",
              "code": "password.reused",
              "message": "$any",
              "params": {
                "history": 3
              }
            }
          ]
        }
      }
    },
    {
      "name": "another new password is accepted",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/password",
        "accessToken": "{{accessToken}}",
        "body": {
          "currentPassword": "{{second}}",
          "newPassword": "{{third}}"
        }
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "let the per-address email cooldown pass",
      "wait": "61s"
    },
    {
      "name": "start a password reset",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets",
        "client": "ios",
        "body": {
          "email": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_new_password"
          }
        }
      },
      "capture": {
        "resetId": "id",
        "resetSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed reset code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "a reset to the third-last password is refused, and says only the policy's number",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/password",
        "attempt": "{{resetSecret}}",
        "body": {
          "code": "{{code}}",
          "password": "{{first}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "password.reused",
          "params": {
            "history": 3
          },
          "errors": [
            {
              "field": "$any",
              "code": "password.reused",
              "message": "$any",
              "params": {
                "history": 3
              }
            }
          ]
        }
      }
    },
    {
      "name": "a reset to the current password is refused too",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/password",
        "attempt": "{{resetSecret}}",
        "body": {
          "code": "{{code}}",
          "password": "{{third}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "password.reused",
          "params": {
            "history": 3
          },
          "errors": [
            {
              "field": "$any",
              "code": "password.reused",
              "message": "$any",
              "params": {
                "history": 3
              }
            }
          ]
        }
      }
    },
    {
      "name": "the code was not spent: a password the user never had completes the reset",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/password",
        "attempt": "{{resetSecret}}",
        "body": {
          "code": "{{code}}",
          "password": "{{fourth}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          },
          "session": {
            "accessToken": "$any"
          }
        }
      }
    },
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etagAfter": "ETag"
      }
    },
    {
      "name": "remember no passwords again",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etagAfter}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "signIn": {
            "$json": "{{signIn}}"
          },
          "signUp": {
            "$json": "{{signUp}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfa}}"
          },
          "sessions": {
            "$json": "{{sessions}}"
          },
          "passkeys": {
            "$json": "{{passkeys}}"
          },
          "sms": {
            "$json": "{{sms}}"
          },
          "password": {
            "preset": "custom",
            "minLength": 12,
            "maxLength": 128,
            "requireLowercase": false,
            "requireUppercase": false,
            "requireNumber": false,
            "requireSpecial": false,
            "minCharacterClasses": 0,
            "specialChars": "!@#$%^&*()-_=+[]{};:,.?/\\|'\"`~<>",
            "disallowUserInfo": true,
            "disallowCommon": true,
            "breachCheck": "block",
            "maxRepeatedChars": null,
            "blockSequences": false,
            "history": 0,
            "expiryDays": null
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "password": {
              "history": 0
            }
          }
        }
      }
    },
    {
      "name": "sign in with the password the reset set",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "prove it",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{fourth}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "laterAccessToken": "session.accessToken"
      }
    },
    {
      "name": "with no history an old password is accepted again",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/password",
        "accessToken": "{{laterAccessToken}}",
        "body": {
          "currentPassword": "{{fourth}}",
          "newPassword": "{{first}}"
        }
      },
      "expect": {
        "status": 204
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
