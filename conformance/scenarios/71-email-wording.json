{
  "$schema": "../scenario.schema.json",
  "name": "email wording",
  "description": "An environment changes the subject and the words of its emails with templates in its settings. A template that could not do its message's job is refused when it is saved, with the field named: a code message without its code, and a notice that is given a code or something that reads as a link. A saved template is what the next email says, in the server's layout: the code it carries still completes the sign-up, and a security notice keeps the server's own line of when it happened. The settings are put back afterwards, even when a step fails.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    },
    "newPassword": {
      "generate": "password"
    },
    "codeField": "{{code}}",
    "appField": "{{appName}}",
    "minutesField": "{{expiresInMinutes}}",
    "timeField": "{{time}}"
  },
  "steps": [
    {
      "name": "read the settings, their revision and the app's name",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any",
          "settings": {
            "emails": {
              "templates": "$any"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "capture": {
        "appName": "settings.app.name"
      },
      "captureJson": {
        "original": "settings",
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "signIn": "settings.signIn",
        "signUp": "settings.signUp",
        "urls": "settings.urls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfa": "settings.mfa",
        "passkeys": "settings.passkeys",
        "sessions": "settings.sessions",
        "sms": "settings.sms"
      }
    },
    {
      "name": "a code message whose body lacks the code is refused, naming the field",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "emails": {
            "templates": {
              "email_verification": {
                "body": "Welcome to {{appField}}. Wording 71 without a code."
              }
            }
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed",
          "errors": [
            {
              "field": "emails.templates.email_verification.body",
              "code": "validation.failed",
              "message": "$any"
            }
          ]
        }
      }
    },
    {
      "name": "a security notice cannot be given a code",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "emails": {
            "templates": {
              "password_set_by_admin": {
                "body": "Wording 71. Enter {{codeField}} to keep your account."
              }
            }
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed",
          "errors": [
            {
              "field": "emails.templates.password_set_by_admin.body",
              "code": "validation.failed",
              "message": "$any"
            }
          ]
        }
      }
    },
    {
      "name": "a notice with something that reads as a link is refused",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "emails": {
            "templates": {
              "password_set_by_admin": {
                "body": "Wording 71. Confirm your account at https://wording.conformance.example/confirm today."
              }
            }
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed",
          "errors": [
            {
              "field": "emails.templates.password_set_by_admin.body",
              "code": "validation.failed",
              "message": "$any"
            }
          ]
        }
      }
    },
    {
      "name": "nothing was stored by the refused saves",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "headers": {
          "ETag": "{{etag}}"
        }
      }
    },
    {
      "name": "save a template for the verification code and one for a security notice",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "$json": "{{signIn}}"
          },
          "signUp": {
            "$json": "{{signUp}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfa}}"
          },
          "passkeys": {
            "$json": "{{passkeys}}"
          },
          "sessions": {
            "$json": "{{sessions}}"
          },
          "sms": {
            "$json": "{{sms}}"
          },
          "emails": {
            "templates": {
              "email_verification": {
                "subject": "{{codeField}} opens {{appField}} (wording 71)",
                "body": "Wording 71 welcomes you to {{appField}}.\n\nYour code: {{codeField}}\n\nIt works for {{minutesField}} minutes."
              },
              "password_set_by_admin": {
                "subject": "Wording 71 notice: your {{appField}} password",
                "body": "Wording 71 says an administrator of {{appField}} set a new password for you at {{timeField}}."
              }
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "emails": {
              "templates": {
                "email_verification": {
                  "subject": "{{codeField}} opens {{appField}} (wording 71)",
                  "body": "$any"
                },
                "password_set_by_admin": {
                  "subject": "$any",
                  "body": "$any"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification"
          }
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "the email is in the environment's words, with the code where the template put it",
      "emailMessage": {
        "to": "{{email}}",
        "subjectContains": "(wording 71)",
        "captureCode": "code",
        "subject": "{{code}} opens {{appName}} (wording 71)",
        "textContains": [
          "Wording 71 welcomes you to {{appName}}.",
          "Your code: {{code}}",
          "It works for 10 minutes."
        ],
        "textExcludes": ["Enter this code to verify", "{{codeField}}", "{{appField}}"]
      }
    },
    {
      "name": "the code from the reworded email completes the sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "$any"
          }
        }
      },
      "capture": {
        "userId": "step.userId"
      }
    },
    {
      "name": "an administrator sets the user's password",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/users/{{userId}}/password",
        "auth": "secret",
        "body": {
          "password": "{{newPassword}}"
        }
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "the notice is in the environment's words and keeps the server's own line of when",
      "emailMessage": {
        "to": "{{email}}",
        "subjectContains": "Wording 71 notice",
        "subject": "Wording 71 notice: your {{appName}} password",
        "textContains": [
          "Wording 71 says an administrator of {{appName}} set a new password for you at 20",
          "When: 20"
        ],
        "textExcludes": ["http", "{{timeField}}", "{{newPassword}}"]
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
