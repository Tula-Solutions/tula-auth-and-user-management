{
  "$schema": "../scenario.schema.json",
  "name": "webhook secret rotated with an overlap",
  "description": "An operator replaces an endpoint's signing secret without dropping a delivery. A rotated secret verifies with either during the overlap: the server makes the new secret and returns it once, and from then on every delivery carries two signatures, the new secret's first and the previous secret's after it, so a receiver still on the old secret and one already on the new both verify. A read of the endpoint says a rotation is under way and until when, and never a secret. A second rotation during the overlap is refused (an endpoint never has three secrets). The rotation is in the audit log with the time the previous secret stops signing and nothing of either secret. Ending the overlap early makes the previous secret stop signing at once: the next delivery has one signature, which verifies with the new secret and not with the old one, and another rotation is then possible. Needs a receiver the server can reach. What this scenario cannot stage is the overlap ending by itself: it lasts 24 hours, which a wait step would really sleep against a live server. That the previous secret signs one millisecond before that instant and not at it, on the clock alone, and that its ciphertext is deleted by the worker's next round, is covered by the API's tests on a clock the test controls (apps/api/src/modules/webhook/rotation.test.ts) and, through the typed client and verifyWebhook, by packages/admin/src/webhook-real-api.test.ts.",
  "needsSecretKey": true,
  "needsWebhookReceiver": true,
  "variables": {
    "firstEmail": {
      "generate": "email"
    },
    "secondEmail": {
      "generate": "email"
    },
    "thirdEmail": {
      "generate": "email"
    },
    "fourthEmail": {
      "generate": "email"
    }
  },
  "steps": [
    {
      "name": "start a receiver",
      "webhook": {
        "receiver": "backend",
        "captureUrl": "receiverUrl"
      }
    },
    {
      "name": "register the receiver for user.created: one secret signs",
      "request": {
        "method": "POST",
        "path": "/v1/admin/webhook-endpoints",
        "auth": "secret",
        "body": {
          "url": "{{receiverUrl}}",
          "eventTypes": ["user.created"]
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "rotationOverlapEndsAt": null
        }
      },
      "capture": {
        "endpointId": "id",
        "oldSecret": "secret"
      }
    },
    {
      "name": "rotating a secret takes a secret key",
      "request": {
        "method": "POST",
        "path": "/v1/admin/webhook-endpoints/{{endpointId}}/secret/rotate"
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_key"
        }
      }
    },
    {
      "name": "something happens: an admin creates a user",
      "request": {
        "method": "POST",
        "path": "/v1/admin/users",
        "auth": "secret",
        "body": {
          "email": "{{firstEmail}}"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "before the rotation a delivery has one signature, the registered secret's",
      "webhook": {
        "receiver": "backend",
        "expect": {
          "secret": "{{oldSecret}}",
          "type": "user.created",
          "signatures": 1
        }
      }
    },
    {
      "name": "there is no overlap to end while one secret signs",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/webhook-endpoints/{{endpointId}}/secret/previous",
        "auth": "secret"
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "webhook.rotation_refused",
          "params": {
            "reason": "no_rotation_in_progress"
          }
        }
      }
    },
    {
      "name": "rotate: the new secret is returned once, with when the previous one stops signing",
      "request": {
        "method": "POST",
        "path": "/v1/admin/webhook-endpoints/{{endpointId}}/secret/rotate",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "id": "{{endpointId}}",
          "enabled": true,
          "secret": {
            "$matches": "^whsec_[A-Za-z0-9+/]{43}=$"
          },
          "rotationOverlapEndsAt": {
            "$matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          }
        },
        "bodyExcludes": ["{{oldSecret}}"]
      },
      "capture": {
        "newSecret": "secret"
      }
    },
    {
      "name": "a read says a rotation is under way and until when, and neither secret",
      "request": {
        "method": "GET",
        "path": "/v1/admin/webhook-endpoints/{{endpointId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{endpointId}}",
          "rotationOverlapEndsAt": {
            "$matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "secret": "$absent"
        },
        "bodyExcludes": ["{{oldSecret}}", "{{newSecret}}", "whsec_"]
      }
    },
    {
      "name": "nor does the list",
      "request": {
        "method": "GET",
        "path": "/v1/admin/webhook-endpoints",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "bodyExcludes": ["{{oldSecret}}", "{{newSecret}}", "whsec_"]
      }
    },
    {
      "name": "a second rotation during the overlap is refused: never three secrets",
      "request": {
        "method": "POST",
        "path": "/v1/admin/webhook-endpoints/{{endpointId}}/secret/rotate",
        "auth": "secret"
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "webhook.rotation_refused",
          "params": {
            "reason": "rotation_in_progress"
          }
        },
        "bodyExcludes": ["whsec_"]
      }
    },
    {
      "name": "something happens during the overlap",
      "request": {
        "method": "POST",
        "path": "/v1/admin/users",
        "auth": "secret",
        "body": {
          "email": "{{secondEmail}}"
        }
      },
      "expect": {
        "status": 201
      },
      "capture": {
        "secondUserId": "id"
      }
    },
    {
      "name": "the delivery verifies with the new secret and with the old one: two signatures",
      "webhook": {
        "receiver": "backend",
        "expect": {
          "secret": "{{newSecret}}",
          "alsoSecrets": ["{{oldSecret}}"],
          "signatures": 2,
          "type": "user.created",
          "body": {
            "type": "user.created",
            "target": {
              "type": "user",
              "id": "{{secondUserId}}"
            }
          }
        }
      }
    },
    {
      "name": "send a test event during the overlap",
      "request": {
        "method": "POST",
        "path": "/v1/admin/webhook-endpoints/{{endpointId}}/test",
        "auth": "secret",
        "body": {
          "eventType": "user.deleted"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "outcome": "delivered"
        }
      }
    },
    {
      "name": "a test event is signed the same way: either secret verifies it",
      "webhook": {
        "receiver": "backend",
        "expect": {
          "secret": "{{oldSecret}}",
          "alsoSecrets": ["{{newSecret}}"],
          "signatures": 2,
          "type": "user.deleted",
          "body": {
            "test": true
          }
        }
      }
    },
    {
      "name": "the rotation is in the audit log, with the end of the overlap and nothing of either secret",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?targetId={{endpointId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 2
          },
          "data": [
            {
              "action": "webhook_endpoint.secret_rotated",
              "actor": {
                "type": "admin"
              },
              "target": {
                "type": "webhook_endpoint",
                "id": "{{endpointId}}"
              },
              "metadata": {
                "rotationOverlapEndsAt": {
                  "$matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
                }
              }
            },
            {
              "action": "webhook_endpoint.created"
            }
          ]
        },
        "bodyExcludes": ["{{oldSecret}}", "{{newSecret}}", "whsec_", "{{receiverUrl}}"]
      }
    },
    {
      "name": "end the overlap early: the previous secret stops signing now",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/webhook-endpoints/{{endpointId}}/secret/previous",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{endpointId}}",
          "rotationOverlapEndsAt": null,
          "secret": "$absent"
        },
        "bodyExcludes": ["whsec_"]
      }
    },
    {
      "name": "something happens after the overlap",
      "request": {
        "method": "POST",
        "path": "/v1/admin/users",
        "auth": "secret",
        "body": {
          "email": "{{thirdEmail}}"
        }
      },
      "expect": {
        "status": 201
      },
      "capture": {
        "thirdUserId": "id"
      }
    },
    {
      "name": "the delivery has one signature: the new secret verifies it, the old one no longer does",
      "webhook": {
        "receiver": "backend",
        "expect": {
          "secret": "{{newSecret}}",
          "notSecrets": ["{{oldSecret}}"],
          "signatures": 1,
          "type": "user.created",
          "body": {
            "target": {
              "id": "{{thirdUserId}}"
            }
          }
        }
      }
    },
    {
      "name": "ending the overlap is in the audit log too",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?targetId={{endpointId}}&action=webhook_endpoint.previous_secret_revoked",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 1
          },
          "data": [
            {
              "action": "webhook_endpoint.previous_secret_revoked",
              "actor": {
                "type": "admin"
              },
              "metadata": {}
            }
          ]
        },
        "bodyExcludes": ["whsec_", "{{receiverUrl}}"]
      }
    },
    {
      "name": "with the overlap over, the secret can be rotated again at once",
      "request": {
        "method": "POST",
        "path": "/v1/admin/webhook-endpoints/{{endpointId}}/secret/rotate",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "secret": {
            "$matches": "^whsec_[A-Za-z0-9+/]{43}=$"
          }
        },
        "bodyExcludes": ["{{oldSecret}}", "{{newSecret}}"]
      },
      "capture": {
        "newestSecret": "secret"
      }
    },
    {
      "name": "something happens during the second overlap",
      "request": {
        "method": "POST",
        "path": "/v1/admin/users",
        "auth": "secret",
        "body": {
          "email": "{{fourthEmail}}"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "two secrets sign, the newest and the one before it, and the first one never again",
      "webhook": {
        "receiver": "backend",
        "expect": {
          "secret": "{{newestSecret}}",
          "alsoSecrets": ["{{newSecret}}"],
          "notSecrets": ["{{oldSecret}}"],
          "signatures": 2,
          "type": "user.created"
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "remove the endpoint, and both its secrets with it",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/webhook-endpoints/{{endpointId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    }
  ]
}
