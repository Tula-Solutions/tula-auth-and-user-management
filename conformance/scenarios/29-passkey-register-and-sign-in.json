{
  "$schema": "../scenario.schema.json",
  "name": "passkey registration and sign-in",
  "description": "A signed-in user registers a passkey (options, then the authenticator\u2019s response) and afterwards signs in with it and nothing else: a sign-in with no identifier whose options name no credential, completed by one assertion. The session says how it was authenticated (hwk, user, mfa). The passkey is listed by name and dates only, can be renamed, and works on every instance. The settings are put back afterwards, even when a step fails.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signUpCode"
      }
    },
    {
      "name": "verify the address: the account exists and is signed in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{signUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "passwordMethod": "settings.signIn.methods.password",
        "emailCodeMethod": "settings.signIn.methods.emailCode",
        "emailLinkMethod": "settings.signIn.methods.emailLink",
        "signUpSettings": "settings.signUp",
        "redirects": "settings.urls.allowedRedirectUrls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa"
      }
    },
    {
      "name": "switch passkeys on, with a relying-party id and an origin that belongs to it",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "$json": "{{passwordMethod}}"
              },
              "emailCode": {
                "$json": "{{emailCodeMethod}}"
              },
              "emailLink": {
                "$json": "{{emailLinkMethod}}"
              },
              "passkey": {
                "enabled": true
              }
            }
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "allowedOrigins": ["https://app.passkeys.example"],
            "allowedRedirectUrls": {
              "$json": "{{redirects}}"
            }
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "rpId": "passkeys.example"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "passkeys": {
              "rpId": "passkeys.example"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      }
    },
    {
      "name": "the public config lists the method",
      "request": {
        "method": "GET",
        "path": "/v1/client/config"
      },
      "expect": {
        "status": 200,
        "body": {
          "signIn": {
            "methods": {
              "$set": ["password", "passkey"]
            }
          }
        }
      }
    },
    {
      "name": "a sign-in start offers the passkey beside the password, whatever the identifier",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "nobody-{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_first_factor",
            "strategies": ["password", "passkey"]
          }
        }
      }
    },
    {
      "name": "without an Origin there is no passkey ceremony",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys/options",
        "accessToken": "{{accessToken}}",
        "body": {}
      },
      "expect": {
        "status": 403,
        "body": {
          "status": 403,
          "code": "request.origin_not_allowed"
        }
      }
    },
    {
      "name": "ask for the options to create a passkey",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys/options",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "rp": {
            "id": "passkeys.example",
            "name": "$any"
          },
          "challenge": {
            "$matches": "^[A-Za-z0-9_-]{43}$"
          },
          "authenticatorSelection": {
            "residentKey": "required",
            "requireResidentKey": true,
            "userVerification": "required"
          },
          "attestation": "none"
        }
      },
      "captureJson": {
        "creationOptions": ""
      }
    },
    {
      "name": "the authenticator makes a passkey",
      "passkey": {
        "authenticator": "phone",
        "create": "{{creationOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "registration"
      }
    },
    {
      "name": "finish: the passkey is stored, and the answer holds no key material",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{registration}}"
          },
          "name": "Phone"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "name": "Phone",
          "synced": false,
          "createdAt": "$any",
          "lastUsedAt": null,
          "publicKey": "$absent",
          "credentialId": "$absent"
        }
      },
      "capture": {
        "passkeyId": "id"
      }
    },
    {
      "name": "the list shows the passkey, never its key or credential id",
      "request": {
        "method": "GET",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "passkeys": [
            {
              "id": "{{passkeyId}}",
              "name": "Phone",
              "synced": false,
              "createdAt": "$any",
              "lastUsedAt": null
            }
          ]
        }
      }
    },
    {
      "name": "rename it",
      "request": {
        "method": "PATCH",
        "path": "/v1/client/me/passkeys/{{passkeyId}}",
        "accessToken": "{{accessToken}}",
        "body": {
          "name": "Work phone"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{passkeyId}}",
          "name": "Work phone"
        }
      }
    },
    {
      "name": "the registration response cannot be presented again",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{registration}}"
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "passkey.registration_failed"
        }
      }
    },
    {
      "name": "start a passkey sign-in: no identifier, and options that name no credential",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "ios",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "kind": "sign_in",
            "step": {
              "status": "needs_first_factor",
              "strategies": ["passkey"]
            },
            "attemptSecret": {
              "$matches": "^tula_at_"
            }
          },
          "options": {
            "challenge": {
              "$matches": "^[A-Za-z0-9_-]{43}$"
            },
            "timeout": 300000,
            "rpId": "passkeys.example",
            "userVerification": "required",
            "allowCredentials": "$absent"
          }
        }
      },
      "capture": {
        "signInId": "attempt.id",
        "signInSecret": "attempt.attemptSecret"
      },
      "captureJson": {
        "signInOptions": "options"
      }
    },
    {
      "name": "the authenticator signs the challenge",
      "passkey": {
        "authenticator": "phone",
        "get": "{{signInOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "signInAssertion"
      }
    },
    {
      "name": "the assertion signs the user in: no password, no second step",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/passkey",
        "attempt": "{{signInSecret}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{signInAssertion}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "sub": "{{userId}}",
            "auth_time": "$any",
            "amr": {
              "$set": ["hwk", "user", "mfa"]
            }
          }
        }
      },
      "capture": {
        "passkeyToken": "session.accessToken"
      }
    },
    {
      "name": "the passkey now has a last-used time",
      "request": {
        "method": "GET",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{passkeyToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "passkeys": [
            {
              "id": "{{passkeyId}}",
              "name": "Work phone",
              "synced": false,
              "createdAt": "$any",
              "lastUsedAt": {
                "$not": null
              }
            }
          ]
        }
      }
    },
    {
      "name": "let the other instance see the settings",
      "wait": "6s"
    },
    {
      "name": "start a passkey sign-in on the other instance",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "ios",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "instance": "second",
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "kind": "sign_in",
            "step": {
              "status": "needs_first_factor",
              "strategies": ["passkey"]
            },
            "attemptSecret": {
              "$matches": "^tula_at_"
            }
          },
          "options": {
            "challenge": {
              "$matches": "^[A-Za-z0-9_-]{43}$"
            },
            "timeout": 300000,
            "rpId": "passkeys.example",
            "userVerification": "required",
            "allowCredentials": "$absent"
          }
        }
      },
      "capture": {
        "secondId": "attempt.id",
        "secondSecret": "attempt.attemptSecret"
      },
      "captureJson": {
        "secondOptions": "options"
      }
    },
    {
      "name": "the authenticator signs the challenge",
      "passkey": {
        "authenticator": "phone",
        "get": "{{secondOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "secondAssertion"
      }
    },
    {
      "name": "a passkey registered on one instance signs in on the other",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{secondId}}/passkey",
        "attempt": "{{secondSecret}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "instance": "second",
        "body": {
          "credential": {
            "$json": "{{secondAssertion}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "sub": "{{userId}}",
            "auth_time": "$any",
            "amr": {
              "$set": ["hwk", "user", "mfa"]
            }
          }
        }
      }
    },
    {
      "name": "the audit log records the passkey without key material",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?action=user.passkey_added&targetId={{userId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 1
          },
          "data": [
            {
              "action": "user.passkey_added",
              "actor": {
                "type": "user",
                "id": "{{userId}}"
              },
              "target": {
                "type": "user",
                "id": "{{userId}}"
              },
              "metadata": {
                "passkeyId": "{{passkeyId}}",
                "synced": false
              }
            }
          ]
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
