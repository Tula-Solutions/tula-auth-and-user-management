{
  "$schema": "../scenario.schema.json",
  "name": "the reuse grace window still requires a proof",
  "description": "Inside the grace window a refresh token that was just rotated gets the same next token again, for a client whose first answer was lost. For a bound session that too needs a proof of the session's key: without one the answer is device.proof_invalid and the next token is not handed out. And a rotated token presented without a proof never ends the session, inside the window or after it: reuse is only judged for a request that proved the key. The side after the window is an API test on the clock.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "a start that brings a proof with no nonce is asked for the server's nonce, and starts nothing",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        },
        "proof": {
          "key": "device"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "device.nonce_required"
        },
        "headers": {
          "DPoP-Nonce": "$any"
        }
      },
      "captureHeaders": {
        "nonce": "DPoP-Nonce"
      }
    },
    {
      "name": "the start, repeated with the nonce, binds the session it will end in to the device's key",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        },
        "proof": {
          "key": "device",
          "nonce": "{{nonce}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification"
          }
        },
        "headers": {
          "DPoP-Nonce": "$any"
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "the code completes the sign-up; the access token names the key by its thumbprint and the answer brings a nonce",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "sessionId": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "cnf": {
              "jkt": {
                "$matches": "^[A-Za-z0-9_-]{43}$"
              }
            }
          }
        },
        "headers": {
          "DPoP-Nonce": "$any"
        }
      },
      "capture": {
        "sessionId": "session.sessionId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      },
      "captureHeaders": {
        "nonce": "DPoP-Nonce"
      }
    },
    {
      "name": "a refresh with a proof rotates the token",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        },
        "proof": {
          "key": "device",
          "nonce": "{{nonce}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "sessionId": "{{sessionId}}",
          "accessToken": "$any",
          "refreshToken": {
            "$not": "{{refreshToken}}"
          }
        }
      },
      "capture": {
        "secondToken": "refreshToken"
      }
    },
    {
      "name": "the rotated token at once, without a proof, is refused: the next token is not handed out",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "device.proof_invalid"
        }
      }
    },
    {
      "name": "the rotated token at once, with a proof of another key, is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        },
        "proof": {
          "key": "other",
          "nonce": "{{nonce}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "device.proof_invalid"
        }
      }
    },
    {
      "name": "the rotated token at once, with a proof, returns the same next token and no new one",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        },
        "proof": {
          "key": "device",
          "nonce": "{{nonce}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "sessionId": "{{sessionId}}",
          "accessToken": "$any",
          "refreshToken": "{{secondToken}}"
        }
      }
    },
    {
      "name": "the next token works: nothing was revoked",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{secondToken}}"
        },
        "proof": {
          "key": "device",
          "nonce": "{{nonce}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "sessionId": "{{sessionId}}",
          "accessToken": "$any",
          "refreshToken": {
            "$not": "{{secondToken}}"
          }
        }
      }
    }
  ]
}
