{
  "$schema": "../scenario.schema.json",
  "name": "provider sign-in returned to a custom scheme",
  "description": "An environment lists a custom-scheme redirect URL in reverse-domain form (com.example.app:/oauth/callback) in the same allow-list as its web pages, which is recorded as a weakening by the list’s name and never by the URL. A scheme without a full stop, a scheme a browser or an operating system handles itself, and a custom scheme with a query are refused when the settings are saved. A provider whose code is bound with PKCE (Google) then returns a native client’s sign-in to it: the callback is a bare redirect to exactly the listed URL, with a single-use ticket in the fragment, no cookie and no token. Any app on a device can claim a scheme, so whoever received the redirect has the ticket and the attempt’s id; neither completes anything without the binding the starting app was given. A browser attempt is refused the same URL (client_not_native) before an attempt is made. Uses the server’s mock provider. Cleanup removes the user and the credentials and restores the settings.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "custom": "com.tula.conformance.app:/oauth/callback"
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any",
          "settings": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "origins": "settings.urls.allowedOrigins",
        "audit": "settings.audit",
        "notifications": "settings.notifications"
      }
    },
    {
      "name": "a scheme with no full stop is refused: it could be anyone’s",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "urls": {
            "allowedOrigins": {
              "$json": "{{origins}}"
            },
            "allowedRedirectUrls": ["conformance:/oauth/callback"]
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "a scheme a browser runs is refused",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "urls": {
            "allowedOrigins": {
              "$json": "{{origins}}"
            },
            "allowedRedirectUrls": ["javascript:alert(1)"]
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "a custom scheme with a query is refused",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "urls": {
            "allowedOrigins": {
              "$json": "{{origins}}"
            },
            "allowedRedirectUrls": ["{{custom}}?next=1"]
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "the custom scheme is listed",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "urls": {
            "allowedOrigins": {
              "$json": "{{origins}}"
            },
            "allowedRedirectUrls": ["{{custom}}"]
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "urls": {
              "allowedRedirectUrls": ["{{custom}}"]
            }
          }
        }
      }
    },
    {
      "name": "the audit entry names the list, says it weakens, and never holds the URL",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?action=environment.settings_updated&size=1",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "data": [
            {
              "action": "environment.settings_updated",
              "metadata": {
                "weakened": true
              }
            }
          ],
          "meta": "$any"
        }
      }
    },
    {
      "name": "an administrator sets the environment’s own Google credentials",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/oauth-providers/google",
        "auth": "secret",
        "body": {
          "clientId": "conformance-google-client",
          "clientSecret": "conformance-google-secret"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "provider": "google",
          "configured": true,
          "enabled": true
        }
      }
    },
    {
      "name": "a browser attempt is refused the scheme before anything starts",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth",
        "client": "web",
        "body": {
          "provider": "google",
          "redirectUrl": "{{custom}}"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "status": 400,
          "code": "request.redirect_not_allowed",
          "detail": "$any",
          "params": {
            "reason": "client_not_native"
          }
        },
        "bodyExcludes": ["authorizationUrl", "binding", "attemptSecret"]
      }
    },
    {
      "name": "a native client starts a sign-in that returns to the scheme",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth",
        "client": "ios",
        "body": {
          "provider": "google",
          "redirectUrl": "{{custom}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "id": "$any",
            "kind": "sign_in",
            "step": {
              "status": "needs_first_factor",
              "strategies": ["oauth_google"]
            }
          },
          "authorizationUrl": "$any",
          "binding": "$any"
        }
      },
      "capture": {
        "aUrl": "authorizationUrl",
        "aBinding": "binding"
      }
    },
    {
      "name": "the provider vouches and the callback sends the ticket to exactly that URL, in the fragment",
      "oauth": {
        "authorizationUrl": "{{aUrl}}",
        "email": "{{email}}",
        "expectRedirectTo": "{{custom}}",
        "captureTicket": "aTicket",
        "captureAttempt": "aId"
      }
    },
    {
      "name": "whoever received the redirect has the ticket and the attempt’s id, and completes nothing with them",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth/exchange",
        "client": "ios",
        "body": {
          "ticket": "{{aTicket}}",
          "attemptId": "{{aId}}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "status": 409,
          "code": "oauth.different_browser",
          "detail": "$any"
        }
      }
    },
    {
      "name": "nor with a binding that is not the one the start returned",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth/exchange",
        "client": "ios",
        "body": {
          "ticket": "{{aTicket}}",
          "attemptId": "{{aId}}",
          "binding": "tula_ob_not-the-binding"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "status": 409,
          "code": "oauth.different_browser",
          "detail": "$any"
        }
      }
    },
    {
      "name": "the app that started the sign-in holds the binding and is signed in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth/exchange",
        "client": "ios",
        "body": {
          "ticket": "{{aTicket}}",
          "attemptId": "{{aId}}",
          "binding": "{{aBinding}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_in",
          "step": {
            "status": "complete",
            "userId": "$any",
            "sessionId": "$any"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "refreshToken": "$any"
          }
        }
      },
      "capture": {
        "aUserId": "step.userId"
      }
    }
  ],
  "cleanup": [
    {
      "name": "remove the user the sign-in created",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/users/{{aUserId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "remove the google credentials",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/oauth-providers/google",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
