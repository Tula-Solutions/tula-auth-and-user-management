{
  "$schema": "../scenario.schema.json",
  "name": "scim users: Entra patch shapes",
  "description": "Entra sends capitalized operations and booleans as strings (ADR 0067): \"Replace\" of active with \"False\" deactivates, \"True\" reactivates, \"Add\" of externalId sets it, and a path the server does not store (name.givenName) is accepted and ignored.",
  "needsSecretKey": true,
  "variables": {
    "suffix": {
      "generate": "snowflake"
    }
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "appSettings": "settings.app",
        "passwordSettings": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urlsSettings": "settings.urls",
        "auditSettings": "settings.audit",
        "notificationsSettings": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeysSettings": "settings.passkeys",
        "smsSettings": "settings.sms",
        "emailsSettings": "settings.emails"
      }
    },
    {
      "name": "an administrator switches organizations and single sign-on on",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{appSettings}}"
          },
          "password": {
            "$json": "{{passwordSettings}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urlsSettings}}"
          },
          "audit": {
            "$json": "{{auditSettings}}"
          },
          "notifications": {
            "$json": "{{notificationsSettings}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeysSettings}}"
          },
          "sms": {
            "$json": "{{smsSettings}}"
          },
          "emails": {
            "$json": "{{emailsSettings}}"
          },
          "organizations": {
            "enabled": true,
            "allowUserCreated": false,
            "maxCreatedPerUser": 1,
            "creatorRole": "admin",
            "defaultRole": "member",
            "personalAccount": true
          },
          "sso": {
            "enabled": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sso": {
              "enabled": true
            }
          }
        }
      }
    },
    {
      "name": "an administrator creates an organization",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations",
        "auth": "secret",
        "body": {
          "name": "SCIM Org",
          "slug": "scim-{{suffix}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "orgId": "id"
      }
    },
    {
      "name": "and claims and verifies a domain, so the directory may create accounts on it",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains",
        "auth": "secret",
        "body": {
          "domain": "s{{suffix}}.example",
          "email": "it@s{{suffix}}.example",
          "mode": "suggest"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "domainId": "id"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "it@s{{suffix}}.example",
        "capture": "domainCode"
      }
    },
    {
      "name": "the emailed code verifies the domain",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains/{{domainId}}/verify",
        "auth": "secret",
        "body": {
          "code": "{{domainCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "verified"
        }
      }
    },
    {
      "name": "and creates a SCIM token for it",
      "request": {
        "method": "POST",
        "path": "/v1/admin/scim-tokens",
        "auth": "secret",
        "body": {
          "organizationId": "{{orgId}}",
          "name": "Okta"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "token": "$any"
        }
      },
      "capture": {
        "scimToken": "token",
        "scimTokenId": "id"
      }
    },
    {
      "name": "Entra creates a user",
      "request": {
        "method": "POST",
        "path": "/v1/scim/v2/Users",
        "auth": "none",
        "accessToken": "{{scimToken}}",
        "body": {
          "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
          "userName": "entra-{{suffix}}@s{{suffix}}.example",
          "active": true,
          "name": {
            "givenName": "Maya",
            "familyName": "Okafor"
          },
          "emails": [
            {
              "type": "work",
              "value": "entra-{{suffix}}@s{{suffix}}.example",
              "primary": true
            }
          ]
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
          "id": "$any",
          "active": true
        }
      },
      "capture": {
        "userId": "id"
      }
    },
    {
      "name": "Entra deactivates with a string",
      "request": {
        "method": "PATCH",
        "path": "/v1/scim/v2/Users/{{userId}}",
        "auth": "none",
        "accessToken": "{{scimToken}}",
        "body": {
          "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
          "Operations": [
            {
              "op": "Replace",
              "path": "active",
              "value": "False"
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "active": false
        }
      }
    },
    {
      "name": "and the membership is gone",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/organizations/{{orgId}}/memberships/{{userId}}",
        "auth": "secret",
        "body": {
          "role": "member"
        }
      },
      "expect": {
        "status": 404
      }
    },
    {
      "name": "Entra reactivates with a string",
      "request": {
        "method": "PATCH",
        "path": "/v1/scim/v2/Users/{{userId}}",
        "auth": "none",
        "accessToken": "{{scimToken}}",
        "body": {
          "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
          "Operations": [
            {
              "op": "Replace",
              "path": "active",
              "value": "True"
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "active": true
        }
      }
    },
    {
      "name": "Entra sets the externalId and renames in one request",
      "request": {
        "method": "PATCH",
        "path": "/v1/scim/v2/Users/{{userId}}",
        "auth": "none",
        "accessToken": "{{scimToken}}",
        "body": {
          "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
          "Operations": [
            {
              "op": "Add",
              "path": "externalId",
              "value": "entra-{{suffix}}"
            },
            {
              "op": "Replace",
              "path": "name.givenName",
              "value": "Maya Renamed"
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "externalId": "entra-{{suffix}}",
          "active": true
        }
      }
    },
    {
      "name": "and finds it by that externalId",
      "request": {
        "method": "GET",
        "path": "/v1/scim/v2/Users?filter=externalId%20eq%20%22entra-{{suffix}}%22",
        "auth": "none",
        "accessToken": "{{scimToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "totalResults": 1,
          "Resources": [
            {
              "id": "{{userId}}"
            }
          ]
        }
      }
    },
    {
      "name": "an operation that is none of add, replace and remove is a 400",
      "request": {
        "method": "PATCH",
        "path": "/v1/scim/v2/Users/{{userId}}",
        "auth": "none",
        "accessToken": "{{scimToken}}",
        "body": {
          "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
          "Operations": [
            {
              "op": "move",
              "path": "active",
              "value": true
            }
          ]
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "schemas": ["urn:ietf:params:scim:api:messages:2.0:Error"],
          "status": "400",
          "scimType": "invalidValue"
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
