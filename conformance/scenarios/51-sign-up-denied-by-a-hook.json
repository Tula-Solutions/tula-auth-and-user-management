{
  "$schema": "../scenario.schema.json",
  "name": "sign-up denied by a hook",
  "description": "An operator registers a `before_sign_up` hook: the server generates its signing secret and returns it once. The hook is not asked when a sign-up starts, nor for a wrong code: only when the address has been proven and an account is about to be created. Its question is a signed POST whose body is the contract's allow-list (the address, how the sign-up is made, the client kind, the IP address) and nothing else. When it answers deny, the client gets `hook.denied` with the operator's own message code, the attempt has ended, and no account exists. When it answers allow, the sign-up completes. The registration is in the audit log without the hook's address or its secret. Needs a receiver the server can reach.",
  "needsSecretKey": true,
  "needsWebhookReceiver": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "allowedEmail": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start the operator's endpoint: it denies with a code of its own",
      "hook": {
        "receiver": "validator",
        "captureUrl": "hookUrl",
        "answer": {
          "decision": "deny",
          "code": "disposable_email"
        }
      }
    },
    {
      "name": "registering a hook takes a secret key",
      "request": {
        "method": "POST",
        "path": "/v1/admin/hooks",
        "body": {
          "point": "before_sign_up",
          "url": "{{hookUrl}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_key"
        }
      }
    },
    {
      "name": "a deadline above five seconds is refused",
      "request": {
        "method": "POST",
        "path": "/v1/admin/hooks",
        "auth": "secret",
        "body": {
          "point": "before_sign_up",
          "url": "{{hookUrl}}",
          "deadlineMs": 5001
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "the caller cannot choose the secret",
      "request": {
        "method": "POST",
        "path": "/v1/admin/hooks",
        "auth": "secret",
        "body": {
          "point": "before_sign_up",
          "url": "{{hookUrl}}",
          "secret": "whsec_YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "register the hook: the secret is in this answer, and it refuses on failure by default",
      "request": {
        "method": "POST",
        "path": "/v1/admin/hooks",
        "auth": "secret",
        "body": {
          "point": "before_sign_up",
          "url": "{{hookUrl}}",
          "deadlineMs": 100
        }
      },
      "expect": {
        "status": 201,
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "id": "$any",
          "point": "before_sign_up",
          "url": "{{hookUrl}}",
          "enabled": true,
          "deadlineMs": 100,
          "failureMode": "deny",
          "lastFailedAt": null,
          "lastFailureReason": null,
          "secret": {
            "$matches": "^whsec_[A-Za-z0-9+/]{43}=$"
          }
        }
      },
      "capture": {
        "hookId": "id",
        "secret": "secret"
      }
    },
    {
      "name": "an environment has one hook per point",
      "request": {
        "method": "POST",
        "path": "/v1/admin/hooks",
        "auth": "secret",
        "body": {
          "point": "before_sign_up",
          "url": "{{hookUrl}}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "resource.conflict"
        }
      }
    },
    {
      "name": "reading the hook does not return the secret",
      "request": {
        "method": "GET",
        "path": "/v1/admin/hooks/{{hookId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{hookId}}",
          "secret": "$absent"
        },
        "bodyExcludes": ["{{secret}}", "whsec_"]
      }
    },
    {
      "name": "start a sign-up: the answer is the one every address gets",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification"
          }
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "the start did not ask the hook",
      "hook": {
        "receiver": "validator",
        "expect": {
          "nothing": true
        }
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code",
        "captureWrong": "wrongCode"
      }
    },
    {
      "name": "a wrong code is refused as ever",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{wrongCode}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "verification.invalid_code"
        }
      }
    },
    {
      "name": "a wrong code did not ask the hook either",
      "hook": {
        "receiver": "validator",
        "expect": {
          "nothing": true
        }
      }
    },
    {
      "name": "the right code proves the address, the hook denies, and the client is told its code",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "status": 403,
          "code": "hook.denied",
          "params": {
            "code": "disposable_email"
          },
          "session": "$absent"
        }
      }
    },
    {
      "name": "the question was signed with the hook's secret and held the allow-list only",
      "hook": {
        "receiver": "validator",
        "expect": {
          "secret": "{{secret}}",
          "body": {
            "id": "$any",
            "type": "hook.before_sign_up",
            "schemaVersion": 1,
            "occurredAt": "$any",
            "data": {
              "email": "{{email}}",
              "method": "password",
              "client": "ios"
            }
          }
        }
      }
    },
    {
      "name": "it was asked once",
      "hook": {
        "receiver": "validator",
        "expect": {
          "nothing": true
        }
      }
    },
    {
      "name": "the attempt has ended",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "code": "flow.not_found"
        }
      }
    },
    {
      "name": "no account exists for the address",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users?q={{email}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 0
          },
          "data": []
        }
      }
    },
    {
      "name": "the registration is in the audit log, without the address or the secret",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?targetId={{hookId}}&action=hook.created",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 1
          },
          "data": [
            {
              "action": "hook.created",
              "actor": {
                "type": "admin",
                "id": "$any"
              },
              "target": {
                "type": "hook",
                "id": "{{hookId}}"
              },
              "metadata": {
                "point": "before_sign_up",
                "enabled": true,
                "failureMode": "deny"
              }
            }
          ]
        },
        "bodyExcludes": ["{{secret}}", "{{hookUrl}}", "whsec_"]
      }
    },
    {
      "name": "the operator's endpoint now allows",
      "hook": {
        "receiver": "validator",
        "answer": {
          "decision": "allow"
        }
      }
    },
    {
      "name": "start another sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{allowedEmail}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "allowedId": "id",
        "allowedSecret": "attemptSecret"
      }
    },
    {
      "name": "read its code",
      "emailCode": {
        "to": "{{allowedEmail}}",
        "capture": "allowedCode"
      }
    },
    {
      "name": "allowed, the sign-up completes",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{allowedId}}/verify-email",
        "attempt": "{{allowedSecret}}",
        "body": {
          "code": "{{allowedCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "$any"
          }
        }
      }
    },
    {
      "name": "and the hook was asked about that address",
      "hook": {
        "receiver": "validator",
        "expect": {
          "secret": "{{secret}}",
          "body": {
            "type": "hook.before_sign_up",
            "data": {
              "email": "{{allowedEmail}}"
            }
          }
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "remove the hook",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/hooks/{{hookId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "it is gone",
      "request": {
        "method": "GET",
        "path": "/v1/admin/hooks/{{hookId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 404
      }
    }
  ]
}
