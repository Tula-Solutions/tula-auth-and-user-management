{
  "$schema": "../scenario.schema.json",
  "name": "jwt template custom claims",
  "description": "An environment defines a JWT template, a named set of custom claims read from the user, the session and constants, and a session profile names the template it uses. The claims are issued under the one namespace claim `ext` of the access token. A session of a profile without a template carries no `ext` at all. The claims are read at every issue, so a session that began before the template was saved carries them from its next refresh. A template whose key is a reserved claim name, and a profile that names a template that does not exist, are refused when the settings are saved. The settings are put back afterwards, even when a step fails.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urls": "settings.urls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeySettings": "settings.passkeys",
        "original": "settings"
      }
    },
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "without a template the access token has no namespace claim",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "accessToken": "$any"
          }
        },
        "claims": {
          "session.accessToken": {
            "sub": "$any",
            "sp": "mobile",
            "ext": "$absent"
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "a template cannot set a reserved claim",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeySettings}}"
          },
          "sessions": {
            "jwtTemplates": {
              "conformance": {
                "claims": {
                  "sub": {
                    "value": "someone-else"
                  }
                }
              }
            }
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "a template cannot read a source outside the list",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeySettings}}"
          },
          "sessions": {
            "jwtTemplates": {
              "conformance": {
                "claims": {
                  "ip": {
                    "from": "session.ip_address"
                  }
                }
              }
            }
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "a profile cannot name a template that does not exist",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeySettings}}"
          },
          "sessions": {
            "profiles": {
              "mobile": {
                "jwtTemplate": "conformance-missing"
              }
            }
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "define a template and have the mobile profile use it",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeySettings}}"
          },
          "sessions": {
            "jwtTemplates": {
              "conformance": {
                "claims": {
                  "role": {
                    "value": "member"
                  },
                  "seats": {
                    "value": 3
                  },
                  "email": {
                    "from": "user.email"
                  },
                  "verified": {
                    "from": "user.email_verified"
                  },
                  "client": {
                    "from": "session.client"
                  }
                }
              }
            },
            "profiles": {
              "mobile": {
                "jwtTemplate": "conformance"
              }
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sessions": {
              "jwtTemplates": {
                "conformance": {
                  "claims": {
                    "role": {
                      "value": "member"
                    },
                    "seats": {
                      "value": 3
                    },
                    "email": {
                      "from": "user.email"
                    },
                    "verified": {
                      "from": "user.email_verified"
                    },
                    "client": {
                      "from": "session.client"
                    }
                  }
                }
              },
              "profiles": {
                "mobile": {
                  "jwtTemplate": "conformance"
                },
                "web": {
                  "jwtTemplate": "$absent"
                }
              }
            }
          }
        }
      },
      "captureHeaders": {
        "templatedEtag": "ETag"
      }
    },
    {
      "name": "the session from before carries the claims from its next refresh",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        }
      },
      "expect": {
        "status": 200,
        "claims": {
          "accessToken": {
            "sub": "{{userId}}",
            "sp": "mobile",
            "ext": {
              "role": "member",
              "seats": 3,
              "email": "{{email}}",
              "verified": true,
              "client": "ios"
            }
          }
        }
      },
      "capture": {
        "refreshToken2": "refreshToken"
      }
    },
    {
      "name": "start a sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "a sign-in gets an access token with the custom claims",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        },
        "claims": {
          "session.accessToken": {
            "sub": "{{userId}}",
            "sp": "mobile",
            "ext": {
              "role": "member",
              "seats": 3,
              "email": "{{email}}",
              "verified": true,
              "client": "ios"
            }
          }
        }
      }
    },
    {
      "name": "removing a template a profile still uses is refused",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{templatedEtag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeySettings}}"
          },
          "sessions": {
            "jwtTemplates": {},
            "profiles": {
              "mobile": {
                "jwtTemplate": "conformance"
              }
            }
          }
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "validation.failed"
        }
      }
    },
    {
      "name": "the profile stops using the template",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{templatedEtag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeySettings}}"
          },
          "sessions": {
            "jwtTemplates": {
              "conformance": {
                "claims": {
                  "role": {
                    "value": "member"
                  },
                  "seats": {
                    "value": 3
                  },
                  "email": {
                    "from": "user.email"
                  },
                  "verified": {
                    "from": "user.email_verified"
                  },
                  "client": {
                    "from": "session.client"
                  }
                }
              }
            }
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "and the next refresh has no namespace claim again",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken2}}"
        }
      },
      "expect": {
        "status": 200,
        "claims": {
          "accessToken": {
            "sub": "{{userId}}",
            "ext": "$absent"
          }
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
