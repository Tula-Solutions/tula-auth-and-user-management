{
  "$schema": "../scenario.schema.json",
  "name": "a profile with no device binding refuses a proof",
  "description": "Device binding (ADR 0043). Where the profile a native app's session would get says `deviceBinding: \"none\"`, a start that brings a DPoP proof is refused with `device.binding_not_supported`, before the proof is looked at: a client that asked for a bound session is never given an unbound one. The same start without a proof goes on, and ends in a session that is not bound. The settings are put back afterwards, even when a step fails.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "appSettings": "settings.app",
        "passwordSettings": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urlsSettings": "settings.urls",
        "auditSettings": "settings.audit",
        "notificationsSettings": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeysSettings": "settings.passkeys",
        "smsSettings": "settings.sms",
        "emailsSettings": "settings.emails"
      }
    },
    {
      "name": "the mobile profile binds no session",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{appSettings}}"
          },
          "password": {
            "$json": "{{passwordSettings}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urlsSettings}}"
          },
          "audit": {
            "$json": "{{auditSettings}}"
          },
          "notifications": {
            "$json": "{{notificationsSettings}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeysSettings}}"
          },
          "sms": {
            "$json": "{{smsSettings}}"
          },
          "emails": {
            "$json": "{{emailsSettings}}"
          },
          "sessions": {
            "profiles": {
              "mobile": {
                "deviceBinding": "none"
              }
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sessions": {
              "profiles": {
                "web": {
                  "deviceBinding": "none"
                },
                "mobile": {
                  "deviceBinding": "none"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "a start from an iOS app that brings a proof is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        },
        "proof": {
          "key": "device"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "device.binding_not_supported",
          "id": "$absent",
          "attemptSecret": "$absent"
        }
      }
    },
    {
      "name": "and so is one that brings something that is no proof: nothing is judged",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        },
        "headers": {
          "DPoP": "not.a.proof"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "device.binding_not_supported",
          "id": "$absent",
          "attemptSecret": "$absent"
        }
      }
    },
    {
      "name": "the same start without a proof goes on",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification"
          }
        },
        "headers": {
          "DPoP-Nonce": "$absent"
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "the code completes the sign-up; the session is not bound",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "sessionId": "$any"
          }
        },
        "claims": {
          "session.accessToken": {
            "cnf": "$absent"
          }
        },
        "headers": {
          "DPoP-Nonce": "$absent"
        }
      },
      "capture": {
        "sessionId": "session.sessionId",
        "accessToken": "session.accessToken"
      }
    },
    {
      "name": "the session list says the session is not bound",
      "request": {
        "method": "GET",
        "path": "/v1/client/sessions",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "data": [
            {
              "id": "{{sessionId}}",
              "current": true,
              "deviceBound": false
            }
          ]
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
