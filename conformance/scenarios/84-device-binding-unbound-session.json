{
  "$schema": "../scenario.schema.json",
  "name": "a session that is not bound behaves as before",
  "description": "Binding is the client's choice, made when an attempt starts. A sign-up that brings no proof ends in a session with no key: its access token has no cnf claim, its refresh needs no proof, and a DPoP header on its refresh is ignored. A browser cannot bind a session, and a start whose proof is not valid is refused instead of being read as a start without one.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up without a proof",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification"
          }
        },
        "headers": {
          "DPoP-Nonce": "$absent"
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "the code completes the sign-up; the access token has no key thumbprint and no nonce is handed out",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "sessionId": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "cnf": "$absent"
          }
        },
        "headers": {
          "DPoP-Nonce": "$absent"
        }
      },
      "capture": {
        "sessionId": "session.sessionId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "a refresh without a proof works, as it always did, and brings no nonce",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "sessionId": "{{sessionId}}",
          "accessToken": "$any",
          "refreshToken": {
            "$not": "{{refreshToken}}"
          }
        },
        "headers": {
          "DPoP-Nonce": "$absent"
        },
        "claims": {
          "accessToken": {
            "cnf": "$absent"
          }
        }
      },
      "capture": {
        "secondToken": "refreshToken"
      }
    },
    {
      "name": "a DPoP header on an unbound session's refresh is ignored, whatever it holds",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{secondToken}}"
        },
        "headers": {
          "DPoP": "not.a.proof"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "sessionId": "{{sessionId}}",
          "accessToken": "$any",
          "refreshToken": {
            "$not": "{{secondToken}}"
          }
        },
        "claims": {
          "accessToken": {
            "cnf": "$absent"
          }
        }
      }
    },
    {
      "name": "a browser's start with a proof is refused: a browser's session cannot be bound",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "web",
        "proof": {
          "key": "device"
        },
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "device.binding_not_supported"
        }
      }
    },
    {
      "name": "a start whose proof is not valid is refused, never started unbound",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "headers": {
          "DPoP": "not.a.proof"
        },
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "device.proof_invalid",
          "id": "$absent"
        }
      }
    }
  ]
}
