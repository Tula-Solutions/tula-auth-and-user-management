{
  "$schema": "../scenario.schema.json",
  "name": "setup portal: a whole OIDC setup with a link",
  "description": "The holder of a setup link creates an OIDC connection, is refused when asking for enforcement or a role, is refused activation before a passing test, tests the sign-in at the provider and activates it; an administrator sees the result and the audit log names the setup link.",
  "needsSecretKey": true,
  "variables": {
    "suffix": {
      "generate": "snowflake"
    }
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "appSettings": "settings.app",
        "passwordSettings": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urlsSettings": "settings.urls",
        "auditSettings": "settings.audit",
        "notificationsSettings": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeysSettings": "settings.passkeys",
        "smsSettings": "settings.sms",
        "emailsSettings": "settings.emails"
      }
    },
    {
      "name": "an administrator switches organizations and single sign-on on",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{appSettings}}"
          },
          "password": {
            "$json": "{{passwordSettings}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urlsSettings}}"
          },
          "audit": {
            "$json": "{{auditSettings}}"
          },
          "notifications": {
            "$json": "{{notificationsSettings}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeysSettings}}"
          },
          "sms": {
            "$json": "{{smsSettings}}"
          },
          "emails": {
            "$json": "{{emailsSettings}}"
          },
          "organizations": {
            "enabled": true,
            "allowUserCreated": false,
            "maxCreatedPerUser": 1,
            "creatorRole": "admin",
            "defaultRole": "member",
            "personalAccount": true
          },
          "sso": {
            "enabled": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sso": {
              "enabled": true
            }
          }
        }
      }
    },
    {
      "name": "an administrator creates an organization",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations",
        "auth": "secret",
        "body": {
          "name": "SSO Org",
          "slug": "sso-{{suffix}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "orgId": "id"
      }
    },
    {
      "name": "and claims its domain",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains",
        "auth": "secret",
        "body": {
          "domain": "s{{suffix}}.example",
          "email": "it@s{{suffix}}.example",
          "mode": "suggest"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "domainId": "id"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "it@s{{suffix}}.example",
        "capture": "domainCode"
      }
    },
    {
      "name": "the emailed code verifies the domain",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains/{{domainId}}/verify",
        "auth": "secret",
        "body": {
          "code": "{{domainCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "verified"
        }
      }
    },
    {
      "name": "learn the mock identity provider's issuer",
      "sso": {
        "captureIssuer": "issuer"
      }
    },
    {
      "name": "an administrator creates a setup link for the organization",
      "request": {
        "method": "POST",
        "path": "/v1/admin/setup-links",
        "auth": "secret",
        "body": {
          "organizationId": "{{orgId}}",
          "name": "IT admin"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "token": "$any",
          "url": "$any",
          "id": "$any"
        }
      },
      "capture": {
        "setupToken": "token",
        "setupLinkId": "id"
      }
    },
    {
      "name": "the person with the link creates an OIDC connection, as a draft",
      "request": {
        "method": "POST",
        "path": "/v1/setup/connections",
        "auth": "none",
        "headers": {
          "x-tula-setup-token": "{{setupToken}}"
        },
        "body": {
          "name": "Mock IdP",
          "issuer": "{{issuer}}",
          "clientId": "conformance-sso",
          "clientSecret": "conformance-sso-secret",
          "domains": ["s{{suffix}}.example"]
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "organizationId": "{{orgId}}",
          "status": "draft",
          "defaultRole": "member",
          "clientSecretSet": true
        }
      },
      "capture": {
        "connectionId": "id"
      }
    },
    {
      "name": "a body that sets enforcement is refused",
      "request": {
        "method": "PATCH",
        "path": "/v1/setup/connections/{{connectionId}}",
        "auth": "none",
        "headers": {
          "x-tula-setup-token": "{{setupToken}}"
        },
        "body": {
          "enforced": true
        }
      },
      "expect": {
        "status": 422
      }
    },
    {
      "name": "so is one that sets the default role",
      "request": {
        "method": "PATCH",
        "path": "/v1/setup/connections/{{connectionId}}",
        "auth": "none",
        "headers": {
          "x-tula-setup-token": "{{setupToken}}"
        },
        "body": {
          "defaultRole": "admin"
        }
      },
      "expect": {
        "status": 422
      }
    },
    {
      "name": "activation is refused before a test",
      "request": {
        "method": "PATCH",
        "path": "/v1/setup/connections/{{connectionId}}",
        "auth": "none",
        "headers": {
          "x-tula-setup-token": "{{setupToken}}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "sso.test_required"
        }
      }
    },
    {
      "name": "the person starts a test sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/setup/connections/{{connectionId}}/tests",
        "auth": "none",
        "headers": {
          "x-tula-setup-token": "{{setupToken}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "testId": "$any",
          "authorizationUrl": "$any"
        }
      },
      "capture": {
        "testId": "testId",
        "testUrl": "authorizationUrl"
      }
    },
    {
      "name": "and signs in at the identity provider as someone on the domain",
      "sso": {
        "authorizationUrl": "{{testUrl}}",
        "email": "tester-{{suffix}}@s{{suffix}}.example",
        "captureTest": "returnedTest"
      }
    },
    {
      "name": "the test passed",
      "request": {
        "method": "GET",
        "path": "/v1/setup/connections/{{connectionId}}/tests/{{testId}}",
        "auth": "none",
        "headers": {
          "x-tula-setup-token": "{{setupToken}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "testId": "{{testId}}",
          "status": "passed"
        }
      }
    },
    {
      "name": "the person activates the connection",
      "request": {
        "method": "PATCH",
        "path": "/v1/setup/connections/{{connectionId}}",
        "auth": "none",
        "headers": {
          "x-tula-setup-token": "{{setupToken}}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "active",
          "tested": true
        }
      }
    },
    {
      "name": "an administrator sees it active",
      "request": {
        "method": "GET",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "active"
        }
      }
    },
    {
      "name": "the audit log names the setup link as the actor",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?actorType=setup_link&action=sso_connection.created",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": "$any",
          "data": [{ "actor": { "type": "setup_link" } }]
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "disable the connection",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "status": "disabled"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
