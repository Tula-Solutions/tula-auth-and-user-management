{
  "$schema": "../scenario.schema.json",
  "name": "password reset",
  "description": "A forgotten password is replaced with a code emailed to the address: the response does not reveal whether the address has an account, a rejected password does not spend the code, and completing the reset ends the user's other sessions and retires the old password.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "unknown": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    },
    "newPassword": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signUpCode"
      }
    },
    {
      "name": "verify the address",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{signUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "oldRefreshToken": "session.refreshToken"
      }
    },
    {
      "name": "a reset for an address with no account is answered like any other",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets",
        "client": "ios",
        "body": {
          "email": "{{unknown}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "needs_new_password",
            "strategies": ["email_code"],
            "userId": "$absent"
          },
          "session": "$absent"
        }
      },
      "capture": {
        "decoyId": "id",
        "decoySecret": "attemptSecret"
      }
    },
    {
      "name": "and no guess completes it",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{decoyId}}/password",
        "attempt": "{{decoySecret}}",
        "body": {
          "code": "000000",
          "password": "{{newPassword}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "verification.invalid_code"
        }
      }
    },
    {
      "name": "let the per-address email cooldown pass",
      "wait": "61s"
    },
    {
      "name": "start a password reset",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets",
        "client": "ios",
        "body": {
          "email": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "needs_new_password",
            "strategies": ["email_code"],
            "userId": "$absent"
          },
          "session": "$absent"
        }
      },
      "capture": {
        "resetId": "id",
        "resetSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed reset code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code",
        "captureWrong": "wrongCode"
      }
    },
    {
      "name": "a wrong code is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/password",
        "attempt": "{{resetSecret}}",
        "body": {
          "code": "{{wrongCode}}",
          "password": "{{newPassword}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "verification.invalid_code",
          "params": {
            "attemptsRemaining": 4
          }
        }
      }
    },
    {
      "name": "a new password the policy rejects is refused without spending the code",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/password",
        "attempt": "{{resetSecret}}",
        "body": {
          "code": "{{code}}",
          "password": "short"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "password.too_short"
        }
      }
    },
    {
      "name": "the code and a new password complete the reset and sign the user in",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/password",
        "attempt": "{{resetSecret}}",
        "body": {
          "code": "{{code}}",
          "password": "{{newPassword}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "complete",
            "userId": "{{userId}}",
            "sessionId": "$any"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      }
    },
    {
      "name": "the attempt cannot be used again",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/password",
        "attempt": "{{resetSecret}}",
        "body": {
          "code": "{{code}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "code": "flow.not_found"
        }
      }
    },
    {
      "name": "the session from before the reset has ended",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{oldRefreshToken}}"
        }
      },
      "expect": {
        "status": 401
      }
    },
    {
      "name": "start a sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "the old password no longer works",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "the new password does",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{newPassword}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          }
        }
      }
    }
  ]
}
