{
  "$schema": "../scenario.schema.json",
  "name": "password reset with a second factor",
  "description": "Resetting a forgotten password does not get around two-step verification: the emailed code and a new password yield needs_second_factor and no tokens, and only the authenticator's code completes the reset and signs the user in. The factor outlives the reset.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    },
    "newPassword": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signUpCode"
      }
    },
    {
      "name": "verify the address",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{signUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "start an authenticator enrolment",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/factors/totp",
        "accessToken": "{{accessToken}}",
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "secret": {
            "$matches": "^[A-Z2-7]{32}$"
          },
          "uri": {
            "$matches": "^otpauth://totp/"
          }
        }
      },
      "capture": {
        "secret": "secret"
      }
    },
    {
      "name": "compute the code the authenticator shows",
      "totp": {
        "secret": "{{secret}}",
        "capture": "enrolCode"
      }
    },
    {
      "name": "confirm it: two-step verification is on, with ten backup codes",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/factors/totp/confirm",
        "accessToken": "{{accessToken}}",
        "body": {
          "code": "{{enrolCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "codes": [
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            }
          ]
        }
      },
      "capture": {
        "backupCode": "codes[0]"
      }
    },
    {
      "name": "let the per-address email cooldown pass",
      "wait": "61s"
    },
    {
      "name": "start a password reset",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets",
        "client": "ios",
        "body": {
          "email": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "needs_new_password"
          },
          "session": "$absent"
        }
      },
      "capture": {
        "resetId": "id",
        "resetSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed reset code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "resetCode"
      }
    },
    {
      "name": "the emailed code and a new password yield needs_second_factor and no tokens",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/password",
        "attempt": "{{resetSecret}}",
        "body": {
          "code": "{{resetCode}}",
          "password": "{{newPassword}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "needs_second_factor",
            "options": ["totp", "backup_code"]
          },
          "session": "$absent"
        }
      }
    },
    {
      "name": "compute the code the authenticator shows now",
      "totp": {
        "secret": "{{secret}}",
        "capture": "code",
        "captureWrong": "wrongCode"
      }
    },
    {
      "name": "a wrong code does not complete the reset",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/second-factor",
        "attempt": "{{resetSecret}}",
        "body": {
          "method": "totp",
          "code": "{{wrongCode}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "mfa.invalid_code",
          "session": "$absent"
        }
      }
    },
    {
      "name": "the authenticator's code completes it and signs the user in",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{resetId}}/second-factor",
        "attempt": "{{resetSecret}}",
        "body": {
          "method": "totp",
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "complete",
            "userId": "{{userId}}",
            "sessionId": "$any"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "amr": { "$set": ["email", "otp", "mfa"] },
            "auth_time": "$any"
          }
        }
      }
    },
    {
      "name": "the session from before the reset has ended",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        }
      },
      "expect": {
        "status": 401
      }
    },
    {
      "name": "start a sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_password"
          }
        }
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "the new password still needs the second factor",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{newPassword}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_second_factor",
            "options": ["totp", "backup_code"]
          },
          "session": "$absent"
        }
      }
    }
  ]
}
