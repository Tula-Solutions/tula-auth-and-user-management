{
  "$schema": "../scenario.schema.json",
  "name": "an agent proposes ending a session and a person approves it",
  "description": "An agent key cannot end a session: it asks for the end of one session, named by its own id, and both of the user’s sessions go on working. The secret key approves, that one session’s access token stops at once, on the other instance too, and the user’s other session is untouched. The audit log names the agent as the one who ended it. A production environment refuses every proposal unless its settings accept them (`agents.proposalsInProduction`), when one is made and when one is approved: API tests show that, because this scenario runs against a development environment. The four proposal scenarios together ask for nine proposals, of the ten an environment takes in a minute: against a live server they run one after another, so a step that asks for one more counts against that. Each run leaves one revoked agent key behind.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "verify the address: the sign-up completes with a first session",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken",
        "sessionId": "session.sessionId"
      }
    },
    {
      "name": "start a sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "the password completes it: a second session",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "accessToken2": "session.accessToken",
        "sessionId2": "session.sessionId"
      }
    },
    {
      "name": "and an agent key, shown once",
      "request": {
        "method": "POST",
        "path": "/v1/admin/api-keys",
        "auth": "secret",
        "body": {
          "kind": "agent",
          "name": "conformance agent"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "kind": "agent",
          "key": {
            "$matches": "^tula_ak_"
          }
        }
      },
      "capture": {
        "agentKeyId": "id",
        "agentKey": "key"
      }
    },
    {
      "name": "the agent key reads the user’s sessions",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users/{{userId}}/sessions",
        "auth": "none",
        "accessToken": "{{agentKey}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "data": {
            "$set": [
              {
                "id": "{{sessionId}}"
              },
              {
                "id": "{{sessionId2}}"
              }
            ]
          }
        }
      }
    },
    {
      "name": "it cannot end one itself",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/users/{{userId}}/sessions/{{sessionId}}",
        "auth": "none",
        "accessToken": "{{agentKey}}"
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_key"
        }
      }
    },
    {
      "name": "nor all of them",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/users/{{userId}}/sessions",
        "auth": "none",
        "accessToken": "{{agentKey}}"
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_key"
        }
      }
    },
    {
      "name": "the agent asks for the end of the first session",
      "request": {
        "method": "POST",
        "path": "/v1/agent/proposals",
        "auth": "none",
        "accessToken": "{{agentKey}}",
        "body": {
          "operation": "end_session",
          "target": {
            "type": "session",
            "id": "{{sessionId}}"
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "operation": "end_session",
          "target": {
            "type": "session",
            "id": "{{sessionId}}"
          },
          "summary": {
            "$matches": "^End the session "
          },
          "status": "pending",
          "proposedBy": {
            "type": "agent",
            "id": "{{agentKeyId}}"
          },
          "expiresAt": "$any",
          "approvedBy": null,
          "approvedAt": null,
          "failureReason": null
        }
      },
      "capture": {
        "proposalId": "id"
      }
    },
    {
      "name": "the first session still works",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "the secret key approves exactly what was proposed, and it is carried out",
      "request": {
        "method": "POST",
        "path": "/v1/admin/proposals/{{proposalId}}/approve",
        "auth": "secret",
        "body": {
          "operation": "end_session",
          "target": {
            "type": "session",
            "id": "{{sessionId}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{proposalId}}",
          "status": "executed",
          "approvedBy": {
            "type": "admin",
            "id": "$any"
          },
          "approvedAt": "$any",
          "failureReason": null
        }
      },
      "capture": {
        "approverId": "approvedBy.id"
      }
    },
    {
      "name": "its access token stops working at once",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "session.revoked"
        }
      }
    },
    {
      "name": "on the other instance too",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken}}",
        "instance": "second"
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "session.revoked"
        }
      }
    },
    {
      "name": "the second session is untouched",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken2}}"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "the list now holds the second session only",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users/{{userId}}/sessions",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "data": {
            "$set": [
              {
                "id": "{{sessionId2}}",
                "current": false
              }
            ]
          }
        }
      }
    },
    {
      "name": "a proposal is approved once",
      "request": {
        "method": "POST",
        "path": "/v1/admin/proposals/{{proposalId}}/approve",
        "auth": "secret",
        "body": {
          "operation": "end_session",
          "target": {
            "type": "session",
            "id": "{{sessionId}}"
          }
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "resource.conflict",
          "params": {
            "reason": "already_decided"
          }
        }
      }
    },
    {
      "name": "the end is recorded as the agent's, with its proposal and who approved it",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?action=session.revoked&targetId={{sessionId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 1
          },
          "data": [
            {
              "action": "session.revoked",
              "actor": {
                "type": "agent",
                "id": "{{agentKeyId}}"
              },
              "target": {
                "type": "session",
                "id": "{{sessionId}}"
              },
              "metadata": {
                "proposalId": "{{proposalId}}",
                "approvedBy": {
                  "type": "admin",
                  "id": "{{approverId}}"
                }
              }
            }
          ]
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "revoke the agent key",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/api-keys/{{agentKeyId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "delete the user",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/users/{{userId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    }
  ]
}
