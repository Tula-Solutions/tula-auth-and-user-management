{
  "$schema": "../scenario.schema.json",
  "name": "step-up with a passkey",
  "description": "A user with a passkey can prove it again for the current session: options that name their own passkeys, then an assertion. The fresh access token says so (auth_time now; hwk, user and mfa in amr). The challenge belongs to the session that asked and works once; a wrong assertion is the generic failure and steps up nothing.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    },
    "other": {
      "generate": "email"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signUpCode"
      }
    },
    {
      "name": "verify the address: the account exists and is signed in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{signUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "passwordMethod": "settings.signIn.methods.password",
        "emailCodeMethod": "settings.signIn.methods.emailCode",
        "emailLinkMethod": "settings.signIn.methods.emailLink",
        "signUpSettings": "settings.signUp",
        "redirects": "settings.urls.allowedRedirectUrls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa"
      }
    },
    {
      "name": "switch passkeys on, with a relying-party id and an origin that belongs to it",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "$json": "{{passwordMethod}}"
              },
              "emailCode": {
                "$json": "{{emailCodeMethod}}"
              },
              "emailLink": {
                "$json": "{{emailLinkMethod}}"
              },
              "passkey": {
                "enabled": true
              }
            }
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "allowedOrigins": ["https://app.passkeys.example"],
            "allowedRedirectUrls": {
              "$json": "{{redirects}}"
            }
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "rpId": "passkeys.example"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "passkeys": {
              "rpId": "passkeys.example"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      }
    },
    {
      "name": "ask for the options to create a passkey",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys/options",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "rp": {
            "id": "passkeys.example",
            "name": "$any"
          },
          "challenge": {
            "$matches": "^[A-Za-z0-9_-]{43}$"
          },
          "authenticatorSelection": {
            "residentKey": "required",
            "requireResidentKey": true,
            "userVerification": "required"
          },
          "attestation": "none"
        }
      },
      "captureJson": {
        "creationOptions": ""
      }
    },
    {
      "name": "the authenticator makes a passkey",
      "passkey": {
        "authenticator": "phone",
        "create": "{{creationOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "registration"
      }
    },
    {
      "name": "finish: the passkey is stored, and the answer holds no key material",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{registration}}"
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "name": "Passkey",
          "synced": false,
          "createdAt": "$any",
          "lastUsedAt": null,
          "publicKey": "$absent",
          "credentialId": "$absent"
        }
      },
      "capture": {
        "passkeyId": "id"
      }
    },
    {
      "name": "the options for a step-up name the user\u2019s own passkey",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/step-up/passkey",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "challenge": "$any",
          "rpId": "passkeys.example",
          "userVerification": "required",
          "allowCredentials": [
            {
              "type": "public-key",
              "id": "$any",
              "transports": ["internal"]
            }
          ]
        }
      },
      "captureJson": {
        "badOptions": ""
      }
    },
    {
      "name": "the authenticator signs without verifying the user",
      "passkey": {
        "authenticator": "phone",
        "get": "{{badOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "badAssertion",
        "userVerified": false
      }
    },
    {
      "name": "an assertion without user verification steps up nothing",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/step-up",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "method": "passkey",
          "credential": {
            "$json": "{{badAssertion}}"
          }
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "the authenticator signs the same challenge properly",
      "passkey": {
        "authenticator": "phone",
        "get": "{{badOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "late"
      }
    },
    {
      "name": "the challenge went with the wrong assertion",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/step-up",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "method": "passkey",
          "credential": {
            "$json": "{{late}}"
          }
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "ask again",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/step-up/passkey",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200
      },
      "captureJson": {
        "stepOptions": ""
      }
    },
    {
      "name": "the authenticator signs the challenge",
      "passkey": {
        "authenticator": "phone",
        "get": "{{stepOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "stepAssertion"
      }
    },
    {
      "name": "the passkey steps the session up: a fresh access token, no refresh token",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/step-up",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "method": "passkey",
          "credential": {
            "$json": "{{stepAssertion}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "sessionId": "$any",
          "accessToken": "$any",
          "accessTokenExpiresAt": "$any",
          "refreshToken": "$absent"
        },
        "claims": {
          "accessToken": {
            "sub": "{{userId}}",
            "auth_time": "$any",
            "amr": {
              "$set": ["email", "hwk", "user", "mfa"]
            }
          }
        }
      },
      "capture": {
        "steppedToken": "accessToken"
      }
    },
    {
      "name": "the assertion cannot step up twice",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/step-up",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "method": "passkey",
          "credential": {
            "$json": "{{stepAssertion}}"
          }
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "the fresh token is accepted on a sensitive route",
      "request": {
        "method": "PATCH",
        "path": "/v1/client/me/passkeys/{{passkeyId}}",
        "accessToken": "{{steppedToken}}",
        "body": {
          "name": "Stepped up"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "name": "Stepped up"
        }
      }
    },
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{other}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "othersignUpId": "id",
        "othersignUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{other}}",
        "capture": "othersignUpCode"
      }
    },
    {
      "name": "verify the address: the account exists and is signed in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{othersignUpId}}/verify-email",
        "attempt": "{{othersignUpSecret}}",
        "body": {
          "code": "{{othersignUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "otheruserId": "step.userId",
        "otheraccessToken": "session.accessToken",
        "otherrefreshToken": "session.refreshToken"
      }
    },
    {
      "name": "a user with no passkey gets no options, and is told what they can use",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/step-up/passkey",
        "accessToken": "{{otheraccessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 403,
        "body": {
          "status": 403,
          "code": "auth.step_up_required",
          "params": {
            "methods": "password,email_code"
          }
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
