{
  "$schema": "../scenario.schema.json",
  "name": "sign-in hook that times out",
  "description": "A `before_session` hook whose endpoint takes the question and never answers. The server gives up at the hook's deadline (here the shortest there is, 100 ms; never more than five seconds), so the sign-in fails in bounded time: because a hook refuses on failure by default it is answered `hook.unavailable`, which is not the code of a denial, with no session, and the attempt has ended. The operator sees it on the hook: when it last failed and why, in a fixed word. Switching the hook to allow on failure is recorded as a weakening; after it a sign-in is let through while the endpoint still hangs, and the session's `session.created` entry says the hook was bypassed. Needs a receiver the server can reach.",
  "needsSecretKey": true,
  "needsWebhookReceiver": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up, before any hook exists",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "the account exists",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "userId": "step.userId"
      }
    },
    {
      "name": "start the operator's endpoint: it never answers",
      "hook": {
        "receiver": "gate",
        "captureUrl": "hookUrl",
        "answer": "hang"
      }
    },
    {
      "name": "register the hook with the shortest deadline",
      "request": {
        "method": "POST",
        "path": "/v1/admin/hooks",
        "auth": "secret",
        "body": {
          "point": "before_session",
          "url": "{{hookUrl}}",
          "deadlineMs": 100
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "failureMode": "deny",
          "deadlineMs": 100,
          "lastFailedAt": null,
          "lastFailureReason": null
        }
      },
      "capture": {
        "hookId": "id",
        "secret": "secret"
      }
    },
    {
      "name": "start a sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "the hook does not answer in time: the sign-in is refused as unavailable, not as denied",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 503,
        "body": {
          "status": 503,
          "code": "hook.unavailable",
          "params": "$absent",
          "session": "$absent"
        }
      }
    },
    {
      "name": "the hook was asked",
      "hook": {
        "receiver": "gate",
        "expect": {
          "secret": "{{secret}}",
          "body": {
            "type": "hook.before_session",
            "data": {
              "userId": "{{userId}}"
            }
          }
        }
      }
    },
    {
      "name": "the attempt has ended",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "code": "flow.not_found"
        }
      }
    },
    {
      "name": "the operator sees that the hook failed, and why, in a fixed word",
      "request": {
        "method": "GET",
        "path": "/v1/admin/hooks/{{hookId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "lastFailedAt": "$any",
          "lastFailureReason": "timeout"
        }
      }
    },
    {
      "name": "let sign-ins through when the hook fails",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/hooks/{{hookId}}",
        "auth": "secret",
        "body": {
          "failureMode": "allow"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "failureMode": "allow"
        }
      }
    },
    {
      "name": "that choice is recorded as a weakening",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?targetId={{hookId}}&action=hook.updated",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 1
          },
          "data": [
            {
              "action": "hook.updated",
              "metadata": {
                "point": "before_session",
                "changed": ["failureMode"],
                "weakened": true
              }
            }
          ]
        },
        "bodyExcludes": ["{{secret}}", "{{hookUrl}}"]
      }
    },
    {
      "name": "start another sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "laterId": "id",
        "laterSecret": "attemptSecret"
      }
    },
    {
      "name": "the endpoint still hangs, and the sign-in is let through",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{laterId}}/password",
        "attempt": "{{laterSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "sessionId": "$any"
          }
        }
      },
      "capture": {
        "sessionId": "step.sessionId"
      }
    },
    {
      "name": "the session says it was created while the check was down",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?targetId={{sessionId}}&action=session.created",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 1
          },
          "data": [
            {
              "action": "session.created",
              "metadata": {
                "userId": "{{userId}}",
                "hookBypassed": true
              }
            }
          ]
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "remove the hook",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/hooks/{{hookId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    }
  ]
}
