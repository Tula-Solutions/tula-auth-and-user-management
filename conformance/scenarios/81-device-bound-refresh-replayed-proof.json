{
  "$schema": "../scenario.schema.json",
  "name": "a proof is accepted once",
  "description": "A proof's unique id is remembered in the deployment's shared store for as long as its nonce is accepted, so the same proof presented a second time is refused, on the other instance too: device.proof_invalid, nothing rotated, the session alive. Against a single server the second request goes to the same instance. That the refresh is refused with 503 when the shared store cannot answer is an API test.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "a start that brings a proof with no nonce is asked for the server's nonce, and starts nothing",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        },
        "proof": {
          "key": "device"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "device.nonce_required"
        },
        "headers": {
          "DPoP-Nonce": "$any"
        }
      },
      "captureHeaders": {
        "nonce": "DPoP-Nonce"
      }
    },
    {
      "name": "the start, repeated with the nonce, binds the session it will end in to the device's key",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        },
        "proof": {
          "key": "device",
          "nonce": "{{nonce}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification"
          }
        },
        "headers": {
          "DPoP-Nonce": "$any"
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "the code completes the sign-up; the access token names the key by its thumbprint and the answer brings a nonce",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "sessionId": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "cnf": {
              "jkt": {
                "$matches": "^[A-Za-z0-9_-]{43}$"
              }
            }
          }
        },
        "headers": {
          "DPoP-Nonce": "$any"
        }
      },
      "capture": {
        "sessionId": "session.sessionId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      },
      "captureHeaders": {
        "nonce": "DPoP-Nonce"
      }
    },
    {
      "name": "a refresh with a proof works, and the runner keeps that proof",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        },
        "proof": {
          "key": "device",
          "nonce": "{{nonce}}",
          "capture": "usedProof"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "sessionId": "{{sessionId}}",
          "accessToken": "$any",
          "refreshToken": {
            "$not": "{{refreshToken}}"
          }
        }
      },
      "capture": {
        "secondToken": "refreshToken"
      }
    },
    {
      "name": "the same proof again, with the new refresh token, on the other instance, is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{secondToken}}"
        },
        "headers": {
          "DPoP": "{{usedProof}}"
        },
        "instance": "second"
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "device.proof_invalid"
        }
      }
    },
    {
      "name": "the session is still alive: its access token opens a session route",
      "request": {
        "method": "GET",
        "path": "/v1/client/sessions",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "a new proof with that same refresh token works: the replay used nothing up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{secondToken}}"
        },
        "proof": {
          "key": "device",
          "nonce": "{{nonce}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "sessionId": "{{sessionId}}",
          "accessToken": "$any",
          "refreshToken": {
            "$not": "{{secondToken}}"
          }
        }
      }
    }
  ]
}
