{
  "$schema": "../scenario.schema.json",
  "name": "concurrent session limit",
  "description": "An environment can limit how many live sessions one user has. With end_oldest a sign-in at the limit succeeds and the user's oldest session ends at once: its refresh token and its still-unexpired access token both stop working. With refuse_newest the sign-in is refused with session.limit_reached and creates nothing, until a place is free: the user signs out elsewhere, or an operator ends their sessions. The settings are put back afterwards, even when a step fails.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urls": "settings.urls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeySettings": "settings.passkeys",
        "original": "settings"
      }
    },
    {
      "name": "allow two sessions per user; a third ends the oldest",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeySettings}}"
          },
          "sessions": {
            "maxPerUser": 2,
            "onLimit": "end_oldest"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sessions": {
              "maxPerUser": 2,
              "onLimit": "end_oldest"
            }
          }
        }
      }
    },
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "verify the address: the sign-up completes",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken",
        "sessionId": "session.sessionId"
      }
    },
    {
      "name": "start sign-in 1",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signIn1Id": "id",
        "signIn1Secret": "attemptSecret"
      }
    },
    {
      "name": "a second session is within the limit",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signIn1Id}}/password",
        "attempt": "{{signIn1Secret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "accessToken": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      },
      "capture": {
        "accessToken2": "session.accessToken",
        "refreshToken2": "session.refreshToken"
      }
    },
    {
      "name": "the first session still works",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "start sign-in 2",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signIn2Id": "id",
        "signIn2Secret": "attemptSecret"
      }
    },
    {
      "name": "a third sign-in succeeds",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signIn2Id}}/password",
        "attempt": "{{signIn2Secret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "accessToken": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      },
      "capture": {
        "accessToken3": "session.accessToken",
        "refreshToken3": "session.refreshToken"
      }
    },
    {
      "name": "the oldest session was ended for it: it cannot refresh",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "session.revoked"
        }
      }
    },
    {
      "name": "and its access token is refused before it expires",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "session.revoked"
        }
      }
    },
    {
      "name": "the second session is untouched",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken2}}"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "read the revision again",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag2": "ETag"
      },
      "captureJson": {
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urls": "settings.urls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeySettings": "settings.passkeys"
      }
    },
    {
      "name": "refuse the newest instead",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag2}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urls}}"
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeySettings}}"
          },
          "sessions": {
            "maxPerUser": 2,
            "onLimit": "refuse_newest"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sessions": {
              "maxPerUser": 2,
              "onLimit": "refuse_newest"
            }
          }
        }
      }
    },
    {
      "name": "start sign-in 3",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signIn3Id": "id",
        "signIn3Secret": "attemptSecret"
      }
    },
    {
      "name": "a sign-in at the limit is refused and creates no session",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signIn3Id}}/password",
        "attempt": "{{signIn3Secret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "status": 403,
          "code": "session.limit_reached",
          "session": "$absent"
        },
        "bodyExcludes": ["accessToken", "tula_rt_"],
        "headers": {
          "set-cookie": "$absent"
        }
      }
    },
    {
      "name": "the sessions that exist are untouched",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken3}}"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "sign out of one device",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/sign-out",
        "body": {
          "refreshToken": "{{refreshToken2}}"
        }
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "start sign-in 4",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signIn4Id": "id",
        "signIn4Secret": "attemptSecret"
      }
    },
    {
      "name": "with a place free the sign-in succeeds",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signIn4Id}}/password",
        "attempt": "{{signIn4Secret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "accessToken": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      },
      "capture": {
        "accessToken4": "session.accessToken"
      }
    },
    {
      "name": "start sign-in 5",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signIn5Id": "id",
        "signIn5Secret": "attemptSecret"
      }
    },
    {
      "name": "and the next one is refused again",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signIn5Id}}/password",
        "attempt": "{{signIn5Secret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "status": 403,
          "code": "session.limit_reached"
        }
      }
    },
    {
      "name": "an operator ends the user's sessions",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/users/{{userId}}/sessions",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revoked": 2
        }
      }
    },
    {
      "name": "they stop working at once",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken4}}"
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "session.revoked"
        }
      }
    },
    {
      "name": "start sign-in 6",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signIn6Id": "id",
        "signIn6Secret": "attemptSecret"
      }
    },
    {
      "name": "and the user can sign in again",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signIn6Id}}/password",
        "attempt": "{{signIn6Secret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "accessToken": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
