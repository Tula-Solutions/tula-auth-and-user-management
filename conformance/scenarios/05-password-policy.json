{
  "$schema": "../scenario.schema.json",
  "name": "password policy",
  "description": "The server publishes its password rules, and a password that breaks them is refused with a stable code, before any account or email exists.",
  "variables": {
    "email": {
      "generate": "email"
    }
  },
  "steps": [
    {
      "name": "the policy is readable with a publishable key",
      "request": {
        "method": "GET",
        "path": "/v1/client/password-policy"
      },
      "expect": {
        "status": 200,
        "body": {
          "minLength": "$any",
          "maxLength": "$any"
        }
      }
    },
    {
      "name": "a one-character password is password.too_short, with the rule that failed",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "x"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "password.too_short",
          "errors": [
            {
              "field": "password",
              "code": "password.too_short"
            }
          ]
        }
      }
    },
    {
      "name": "an address that is not an email is email.invalid",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "not-an-email",
          "password": "x"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "email.invalid"
        }
      }
    }
  ]
}
