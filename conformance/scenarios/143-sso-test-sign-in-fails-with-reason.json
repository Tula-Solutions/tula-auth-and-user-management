{
  "$schema": "../scenario.schema.json",
  "name": "sso test sign-in fails with its reason",
  "description": "A test sign-in whose response is meant for another audience fails with the reason and an English sentence for the person setting the connection up (the one place a refusal reason is shown; a real sign-in says only sso.provider_error). The result holds no assertion; the connection is not tested and cannot be activated.",
  "needsSecretKey": true,
  "variables": {
    "suffix": {
      "generate": "snowflake"
    }
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "appSettings": "settings.app",
        "passwordSettings": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urlsSettings": "settings.urls",
        "auditSettings": "settings.audit",
        "notificationsSettings": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeysSettings": "settings.passkeys",
        "smsSettings": "settings.sms",
        "emailsSettings": "settings.emails"
      }
    },
    {
      "name": "an administrator switches organizations and single sign-on on",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{appSettings}}"
          },
          "password": {
            "$json": "{{passwordSettings}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urlsSettings}}"
          },
          "audit": {
            "$json": "{{auditSettings}}"
          },
          "notifications": {
            "$json": "{{notificationsSettings}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeysSettings}}"
          },
          "sms": {
            "$json": "{{smsSettings}}"
          },
          "emails": {
            "$json": "{{emailsSettings}}"
          },
          "organizations": {
            "enabled": true,
            "allowUserCreated": false,
            "maxCreatedPerUser": 1,
            "creatorRole": "admin",
            "defaultRole": "member",
            "personalAccount": true
          },
          "sso": {
            "enabled": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sso": {
              "enabled": true
            }
          }
        }
      }
    },
    {
      "name": "an administrator creates an organization",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations",
        "auth": "secret",
        "body": {
          "name": "SSO Org",
          "slug": "sso-{{suffix}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "orgId": "id"
      }
    },
    {
      "name": "and claims its domain",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains",
        "auth": "secret",
        "body": {
          "domain": "s{{suffix}}.example",
          "email": "it@s{{suffix}}.example",
          "mode": "suggest"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "domainId": "id"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "it@s{{suffix}}.example",
        "capture": "domainCode"
      }
    },
    {
      "name": "the emailed code verifies the domain",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains/{{domainId}}/verify",
        "auth": "secret",
        "body": {
          "code": "{{domainCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "verified"
        }
      }
    },
    {
      "name": "learn the mock identity provider's issuer",
      "sso": {
        "captureIssuer": "issuer"
      }
    },
    {
      "name": "learn the mock identity provider's SAML metadata",
      "sso": {
        "captureSamlMetadata": "samlMetadata"
      }
    },
    {
      "name": "an administrator creates a SAML connection from the provider's metadata, as a draft",
      "request": {
        "method": "POST",
        "path": "/v1/admin/sso-connections",
        "auth": "secret",
        "body": {
          "organizationId": "{{orgId}}",
          "protocol": "saml",
          "name": "Mock SAML IdP",
          "saml": {
            "metadataXml": "{{samlMetadata}}"
          },
          "domains": ["s{{suffix}}.example"]
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "organizationId": "{{orgId}}",
          "protocol": "saml",
          "name": "Mock SAML IdP",
          "status": "draft",
          "clientSecretSet": false,
          "saml": {
            "idpEntityId": "$any",
            "ssoUrl": "$any",
            "metadataUrl": null,
            "certificates": "$any",
            "spEntityId": "$any",
            "acsUrl": "$any",
            "spMetadataUrl": "$any"
          },
          "defaultRole": "member",
          "domains": ["s{{suffix}}.example"],
          "createdAt": "$any",
          "updatedAt": "$any"
        }
      },
      "capture": {
        "connectionId": "id"
      }
    },
    {
      "name": "an administrator starts a test sign-in of the connection",
      "request": {
        "method": "POST",
        "path": "/v1/admin/sso-connections/{{connectionId}}/tests",
        "auth": "secret",
        "body": {
          "redirectUrl": "http://localhost:5174/oauth/callback"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "testId": "$any",
          "authorizationUrl": "$any"
        }
      },
      "capture": {
        "testId": "testId",
        "testUrl": "authorizationUrl"
      }
    },
    {
      "name": "the administrator signs in at the identity provider, which addresses the wrong audience",
      "sso": {
        "authorizationUrl": "{{testUrl}}",
        "email": "tester-{{suffix}}@s{{suffix}}.example",
        "captureTest": "returnedTest",
        "failure": "wrong_audience"
      }
    },
    {
      "name": "the test failed with its reason",
      "request": {
        "method": "GET",
        "path": "/v1/admin/sso-connections/{{connectionId}}/tests/{{testId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "testId": "{{testId}}",
          "status": "failed",
          "reason": "wrong_audience",
          "message": "$any",
          "attributes": [],
          "groups": [],
          "mapped": null
        }
      }
    },
    {
      "name": "the connection is not tested",
      "request": {
        "method": "GET",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "tested": false
        }
      }
    },
    {
      "name": "activation is refused after a failing test",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "sso.test_required"
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "disable the connection",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "status": "disabled"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
