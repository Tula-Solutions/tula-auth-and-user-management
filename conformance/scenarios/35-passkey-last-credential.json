{
  "$schema": "../scenario.schema.json",
  "name": "the last way to sign in cannot be removed",
  "description": "Removing a passkey is refused when nothing else would let its owner in: no password the environment accepts, no emailed code, no connected provider and no other passkey. With another passkey, or once another method counts, it can go; a removed passkey no longer signs in.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signUpCode"
      }
    },
    {
      "name": "verify the address: the account exists and is signed in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{signUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "passwordMethod": "settings.signIn.methods.password",
        "emailCodeMethod": "settings.signIn.methods.emailCode",
        "emailLinkMethod": "settings.signIn.methods.emailLink",
        "signUpSettings": "settings.signUp",
        "redirects": "settings.urls.allowedRedirectUrls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa"
      }
    },
    {
      "name": "switch passkeys on, with a relying-party id and an origin that belongs to it",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "$json": "{{passwordMethod}}"
              },
              "emailCode": {
                "$json": "{{emailCodeMethod}}"
              },
              "emailLink": {
                "$json": "{{emailLinkMethod}}"
              },
              "passkey": {
                "enabled": true
              }
            }
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "allowedOrigins": ["https://app.passkeys.example"],
            "allowedRedirectUrls": {
              "$json": "{{redirects}}"
            }
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "rpId": "passkeys.example"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "passkeys": {
              "rpId": "passkeys.example"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      }
    },
    {
      "name": "ask for the options to create a passkey",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys/options",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "rp": {
            "id": "passkeys.example",
            "name": "$any"
          },
          "challenge": {
            "$matches": "^[A-Za-z0-9_-]{43}$"
          },
          "authenticatorSelection": {
            "residentKey": "required",
            "requireResidentKey": true,
            "userVerification": "required"
          },
          "attestation": "none"
        }
      },
      "captureJson": {
        "creationOptions": ""
      }
    },
    {
      "name": "the authenticator makes a passkey",
      "passkey": {
        "authenticator": "phone",
        "create": "{{creationOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "registration"
      }
    },
    {
      "name": "finish: the passkey is stored, and the answer holds no key material",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{registration}}"
          },
          "name": "First"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "name": "First",
          "synced": false,
          "createdAt": "$any",
          "lastUsedAt": null,
          "publicKey": "$absent",
          "credentialId": "$absent"
        }
      },
      "capture": {
        "passkeyId": "id"
      }
    },
    {
      "name": "ask for the options to create a passkey",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys/options",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "rp": {
            "id": "passkeys.example",
            "name": "$any"
          },
          "challenge": {
            "$matches": "^[A-Za-z0-9_-]{43}$"
          },
          "authenticatorSelection": {
            "residentKey": "required",
            "requireResidentKey": true,
            "userVerification": "required"
          },
          "attestation": "none"
        }
      },
      "captureJson": {
        "secondcreationOptions": ""
      }
    },
    {
      "name": "the authenticator makes a passkey",
      "passkey": {
        "authenticator": "laptop",
        "create": "{{secondcreationOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "secondregistration"
      }
    },
    {
      "name": "finish: the passkey is stored, and the answer holds no key material",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{secondregistration}}"
          },
          "name": "Second"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "name": "Second",
          "synced": false,
          "createdAt": "$any",
          "lastUsedAt": null,
          "publicKey": "$absent",
          "credentialId": "$absent"
        }
      },
      "capture": {
        "secondpasskeyId": "id"
      }
    },
    {
      "name": "read the revision the settings are at",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "passwordMethod": "settings.signIn.methods.password",
        "emailCodeMethod": "settings.signIn.methods.emailCode",
        "emailLinkMethod": "settings.signIn.methods.emailLink",
        "signUpSettings": "settings.signUp",
        "redirects": "settings.urls.allowedRedirectUrls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa"
      }
    },
    {
      "name": "switch passwords off: only the passkeys let this user in",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "enabled": false
              },
              "emailCode": {
                "enabled": false
              },
              "emailLink": {
                "enabled": false
              },
              "passkey": {
                "enabled": true
              }
            }
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "allowedOrigins": ["https://app.passkeys.example"],
            "allowedRedirectUrls": {
              "$json": "{{redirects}}"
            }
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "rpId": "passkeys.example"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "passkeys": {
              "rpId": "passkeys.example"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      }
    },
    {
      "name": "with two passkeys, one can be removed",
      "request": {
        "method": "DELETE",
        "path": "/v1/client/me/passkeys/{{passkeyId}}",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "the last one cannot",
      "request": {
        "method": "DELETE",
        "path": "/v1/client/me/passkeys/{{secondpasskeyId}}",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 409,
        "body": {
          "status": 409,
          "code": "passkey.last_sign_in_method"
        }
      }
    },
    {
      "name": "it is still there",
      "request": {
        "method": "GET",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "passkeys": [
            {
              "id": "{{secondpasskeyId}}",
              "name": "Second",
              "synced": false,
              "createdAt": "$any",
              "lastUsedAt": null
            }
          ]
        }
      }
    },
    {
      "name": "start a passkey sign-in: no identifier, and options that name no credential",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "ios",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "kind": "sign_in",
            "step": {
              "status": "needs_first_factor",
              "strategies": ["passkey"]
            },
            "attemptSecret": {
              "$matches": "^tula_at_"
            }
          },
          "options": {
            "challenge": {
              "$matches": "^[A-Za-z0-9_-]{43}$"
            },
            "timeout": 300000,
            "rpId": "passkeys.example",
            "userVerification": "required",
            "allowCredentials": "$absent"
          }
        }
      },
      "capture": {
        "removedId": "attempt.id",
        "removedSecret": "attempt.attemptSecret"
      },
      "captureJson": {
        "removedOptions": "options"
      }
    },
    {
      "name": "the authenticator signs the challenge",
      "passkey": {
        "authenticator": "phone",
        "get": "{{removedOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "removedAssertion"
      }
    },
    {
      "name": "the removed passkey no longer signs in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{removedId}}/passkey",
        "attempt": "{{removedSecret}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{removedAssertion}}"
          }
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "start a passkey sign-in: no identifier, and options that name no credential",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "ios",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "kind": "sign_in",
            "step": {
              "status": "needs_first_factor",
              "strategies": ["passkey"]
            },
            "attemptSecret": {
              "$matches": "^tula_at_"
            }
          },
          "options": {
            "challenge": {
              "$matches": "^[A-Za-z0-9_-]{43}$"
            },
            "timeout": 300000,
            "rpId": "passkeys.example",
            "userVerification": "required",
            "allowCredentials": "$absent"
          }
        }
      },
      "capture": {
        "keptId": "attempt.id",
        "keptSecret": "attempt.attemptSecret"
      },
      "captureJson": {
        "keptOptions": "options"
      }
    },
    {
      "name": "the authenticator signs the challenge",
      "passkey": {
        "authenticator": "laptop",
        "get": "{{keptOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "keptAssertion"
      }
    },
    {
      "name": "the remaining one does",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{keptId}}/passkey",
        "attempt": "{{keptSecret}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{keptAssertion}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "sub": "{{userId}}",
            "auth_time": "$any",
            "amr": {
              "$set": ["hwk", "user", "mfa"]
            }
          }
        }
      },
      "capture": {
        "keptToken": "session.accessToken"
      }
    },
    {
      "name": "read the revision the settings are at",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "passwordMethod": "settings.signIn.methods.password",
        "emailCodeMethod": "settings.signIn.methods.emailCode",
        "emailLinkMethod": "settings.signIn.methods.emailLink",
        "signUpSettings": "settings.signUp",
        "redirects": "settings.urls.allowedRedirectUrls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa"
      }
    },
    {
      "name": "switch passwords back on",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "enabled": true
              },
              "emailCode": {
                "$json": "{{emailCodeMethod}}"
              },
              "emailLink": {
                "$json": "{{emailLinkMethod}}"
              },
              "passkey": {
                "enabled": true
              }
            }
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "allowedOrigins": ["https://app.passkeys.example"],
            "allowedRedirectUrls": {
              "$json": "{{redirects}}"
            }
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "rpId": "passkeys.example"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "passkeys": {
              "rpId": "passkeys.example"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      }
    },
    {
      "name": "with a password to fall back on, the last passkey can go",
      "request": {
        "method": "DELETE",
        "path": "/v1/client/me/passkeys/{{secondpasskeyId}}",
        "accessToken": "{{keptToken}}"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "removing it again finds nothing",
      "request": {
        "method": "DELETE",
        "path": "/v1/client/me/passkeys/{{secondpasskeyId}}",
        "accessToken": "{{keptToken}}"
      },
      "expect": {
        "status": 404
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
