{
  "$schema": "../scenario.schema.json",
  "name": "an email address for an account without one",
  "description": "An account made by a first sign-in with X has no email address. Its signed-in user asks for a code to be emailed to an address and proves the address with it: until then nothing is on the account, and afterwards the address is there, verified, and the audit log says so without naming it. The two routes are for an account with no address only: once it has one they answer email.already_set. An address another account holds is answered exactly like a free one (the same status and body), is sent no code, and no code confirms it: not a guess, and not the code the address’s owner was once sent. The routes need a recent authentication, which a sign-in a moment ago is; what an older session is told is a journey of each client and an API test. Uses the server’s mock provider (OAUTH_MOCK_PROVIDER, local tier only). The provider’s credentials are removed afterwards, even when a step fails.",
  "needsSecretKey": true,
  "variables": {
    "address": {
      "generate": "email"
    },
    "account": {
      "generate": "snowflake"
    },
    "otherAccount": {
      "generate": "snowflake"
    }
  },
  "steps": [
    {
      "name": "an administrator sets the environment’s own X credentials",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/oauth-providers/x",
        "auth": "secret",
        "body": {
          "clientId": "conformance-x-client",
          "clientSecret": "conformance-x-secret"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "provider": "x",
          "configured": true,
          "enabled": true
        },
        "bodyExcludes": ["conformance-x-secret"]
      }
    },
    {
      "name": "a person starts continuing with X",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth",
        "client": "ios",
        "body": {
          "provider": "x",
          "redirectUrl": "http://localhost:5174/oauth/callback"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "id": "$any",
            "kind": "sign_in",
            "expiresAt": "$any",
            "attemptSecret": "$any",
            "step": {
              "status": "needs_first_factor",
              "strategies": ["oauth_x"]
            }
          },
          "authorizationUrl": "$any",
          "binding": "$any"
        }
      },
      "capture": {
        "aUrl": "authorizationUrl",
        "aBinding": "binding"
      }
    },
    {
      "name": "X names a person’s account by its id and says no address",
      "oauth": {
        "authorizationUrl": "{{aUrl}}",
        "subject": "{{account}}",
        "captureTicket": "aTicket",
        "captureAttempt": "aAttempt"
      }
    },
    {
      "name": "a person is signed in to an account with no email address",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth/exchange",
        "body": {
          "ticket": "{{aTicket}}",
          "attemptId": "{{aAttempt}}",
          "binding": "{{aBinding}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "$any",
          "kind": "sign_in",
          "expiresAt": "$any",
          "step": {
            "status": "complete",
            "userId": "$any",
            "sessionId": "$any"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": "$any"
          }
        }
      },
      "capture": {
        "aId": "step.userId",
        "aToken": "session.accessToken"
      }
    },
    {
      "name": "without a session nothing is asked for",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/email",
        "body": {
          "email": "{{address}}"
        }
      },
      "expect": {
        "status": 401
      }
    },
    {
      "name": "what is not an address is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/email",
        "accessToken": "{{aToken}}",
        "body": {
          "email": "not an address"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "email.invalid"
        }
      }
    },
    {
      "name": "they ask for a code at their address",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/email",
        "accessToken": "{{aToken}}",
        "body": {
          "email": "{{address}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "destination": "$any",
          "expiresAt": "$any"
        },
        "bodyExcludes": ["{{address}}"]
      }
    },
    {
      "name": "the account still has no address: asking stores nothing on it",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{aToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{aId}}",
          "email": "$absent",
          "emailVerifiedAt": "$absent"
        }
      }
    },
    {
      "name": "the code is in their inbox",
      "emailCode": {
        "to": "{{address}}",
        "capture": "code",
        "captureWrong": "wrongCode"
      }
    },
    {
      "name": "a wrong code confirms nothing",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/email/verify",
        "accessToken": "{{aToken}}",
        "body": {
          "code": "{{wrongCode}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "verification.invalid_code"
        }
      }
    },
    {
      "name": "the right code puts the address on the account, verified",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/email/verify",
        "accessToken": "{{aToken}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{aId}}",
          "email": "{{address}}",
          "emailVerifiedAt": "$any",
          "hasPassword": false
        }
      }
    },
    {
      "name": "the account now has it",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{aToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{aId}}",
          "email": "{{address}}",
          "emailVerifiedAt": "$any"
        }
      }
    },
    {
      "name": "an account that has an address is not given another by this route",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/email",
        "accessToken": "{{aToken}}",
        "body": {
          "email": "{{address}}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "status": 409,
          "code": "email.already_set"
        }
      }
    },
    {
      "name": "nor is a code taken for it",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/email/verify",
        "accessToken": "{{aToken}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "status": 409,
          "code": "email.already_set"
        }
      }
    },
    {
      "name": "the audit log says the user added a verified address, and does not name it",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?targetId={{aId}}&action=user.email_added",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 1
          },
          "data": [
            {
              "action": "user.email_added",
              "actor": {
                "type": "user",
                "id": "{{aId}}"
              },
              "target": {
                "type": "user",
                "id": "{{aId}}"
              },
              "metadata": {
                "method": "self",
                "verified": true
              }
            }
          ]
        },
        "bodyExcludes": ["{{address}}", "@example.com"]
      }
    },
    {
      "name": "another person starts continuing with X",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth",
        "client": "ios",
        "body": {
          "provider": "x",
          "redirectUrl": "http://localhost:5174/oauth/callback"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "id": "$any",
            "kind": "sign_in",
            "expiresAt": "$any",
            "attemptSecret": "$any",
            "step": {
              "status": "needs_first_factor",
              "strategies": ["oauth_x"]
            }
          },
          "authorizationUrl": "$any",
          "binding": "$any"
        }
      },
      "capture": {
        "bUrl": "authorizationUrl",
        "bBinding": "binding"
      }
    },
    {
      "name": "X names another person’s account by its id and says no address",
      "oauth": {
        "authorizationUrl": "{{bUrl}}",
        "subject": "{{otherAccount}}",
        "captureTicket": "bTicket",
        "captureAttempt": "bAttempt"
      }
    },
    {
      "name": "another person is signed in to an account with no email address",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth/exchange",
        "body": {
          "ticket": "{{bTicket}}",
          "attemptId": "{{bAttempt}}",
          "binding": "{{bBinding}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "$any",
          "kind": "sign_in",
          "expiresAt": "$any",
          "step": {
            "status": "complete",
            "userId": "$any",
            "sessionId": "$any"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": "$any"
          }
        }
      },
      "capture": {
        "bId": "step.userId",
        "bToken": "session.accessToken"
      }
    },
    {
      "name": "they ask for the address the first account holds: the same answer as for a free one",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/email",
        "accessToken": "{{bToken}}",
        "body": {
          "email": "{{address}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "destination": "$any",
          "expiresAt": "$any"
        },
        "bodyExcludes": ["{{address}}"]
      }
    },
    {
      "name": "the code the address’s owner was sent confirms nothing for them",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/email/verify",
        "accessToken": "{{bToken}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "verification.invalid_code"
        }
      }
    },
    {
      "name": "their account has no address",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{bToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{bId}}",
          "email": "$absent",
          "emailVerifiedAt": "$absent"
        },
        "bodyExcludes": ["{{address}}"]
      }
    }
  ],
  "cleanup": [
    {
      "name": "remove the x credentials",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/oauth-providers/x",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    }
  ]
}
