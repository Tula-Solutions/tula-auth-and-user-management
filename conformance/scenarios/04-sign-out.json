{
  "$schema": "../scenario.schema.json",
  "name": "sign-out",
  "description": "Signing out ends the session at once: its refresh token and its still-unexpired access token both stop working. Signing out always succeeds.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification",
            "strategies": ["email_code"]
          },
          "session": "$absent"
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code",
        "captureWrong": "wrongCode"
      }
    },
    {
      "name": "the right code completes the sign-up and returns tokens in the body for a native client",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "complete",
            "userId": "$any",
            "sessionId": "$any"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "sessionId": "step.sessionId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "sign out with the refresh token",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/sign-out",
        "body": {
          "refreshToken": "{{refreshToken}}"
        }
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "the refresh token is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/refresh",
        "body": {
          "refreshToken": "{{refreshToken}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "session.revoked"
        }
      }
    },
    {
      "name": "the access token is refused before it expires",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "session.revoked"
        }
      }
    },
    {
      "name": "signing out again, or with an unknown token, still succeeds",
      "request": {
        "method": "POST",
        "path": "/v1/client/sessions/sign-out",
        "body": {
          "refreshToken": "tula_rt_0000000000000000000000000000000000000000000"
        }
      },
      "expect": {
        "status": 204
      },
      "times": 2
    }
  ]
}
