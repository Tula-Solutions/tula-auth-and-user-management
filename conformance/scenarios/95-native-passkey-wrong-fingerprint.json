    {
      "name": "the origin an iOS app would present: the authenticator signs the challenge",
      "passkey": {
        "authenticator": "phone",
        "get": "{{iosformOptions}}",
        "capture": "iosformAssertion",
        "origin": "https://{{rpId}}"
      }
    },
    {
      "name": "the origin an iOS app would present: the answer",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{iosformId}}/passkey",
        "attempt": "{{iosformSecret}}",
        "body": {
          "credential": {
            "$json": "{{iosformAssertion}}"
          }
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "auth.invalid_credentials",
          "session": "$absent"
        }
      }
    },
    {
      "name": "an allowed page’s origin, with no Origin header: start a passkey sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "android",
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "step": {
              "status": "needs_first_factor",
              "strategies": ["passkey"]
            }
          },
          "options": {
            "rpId": "{{rpId}}",
            "userVerification": "required",
            "allowCredentials": "$absent"
          }
        }
      },
      "capture": {
        "pageformId": "attempt.id",
        "pageformSecret": "attempt.attemptSecret"
      },
      "captureJson": {
        "pageformOptions": "options"
      }
    },
    {
      "name": "an allowed page’s origin, with no Origin header: the authenticator signs the challenge",
      "passkey": {
        "authenticator": "phone",
        "get": "{{pageformOptions}}",
        "capture": "pageformAssertion",
        "origin": "{{pageOrigin}}"
      }
    },
    {
      "name": "an allowed page’s origin, with no Origin header: the answer",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{pageformId}}/passkey",
        "attempt": "{{pageformSecret}}",
        "body": {
          "credential": {
            "$json": "{{pageformAssertion}}"
          }
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "auth.invalid_credentials",
          "session": "$absent"
        }
      }
    },
    {
      "name": "the passkey is still the account’s, and the only one",
      "request": {
        "method": "GET",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "passkeys": [
            {
              "id": "$any",
              "lastUsedAt": {
                "$not": null
              }
            }
          ]
        }
      }
    },
    {
      "name": "the registered build, after every refusal: start a passkey sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "android",
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "step": {
              "status": "needs_first_factor",
              "strategies": ["passkey"]
            }
          },
          "options": {
            "rpId": "{{rpId}}",
            "userVerification": "required",
            "allowCredentials": "$absent"
          }
        }
      },
      "capture": {
        "lastId": "attempt.id",
        "lastSecret": "attempt.attemptSecret"
      },
      "captureJson": {
        "lastOptions": "options"
      }
    },
    {
      "name": "the registered build, after every refusal: the authenticator signs the challenge",
      "passkey": {
        "authenticator": "phone",
        "get": "{{lastOptions}}",
        "capture": "lastAssertion",
        "androidCertFingerprint": "{{secondFingerprint}}"
      }
    },
    {
      "name": "the registered build, after every refusal: the answer",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{lastId}}/passkey",
        "attempt": "{{lastSecret}}",
        "body": {
          "credential": {
            "$json": "{{lastAssertion}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "set-cookie": "$absent"
        },
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "sub": "{{userId}}",
            "amr": {
              "$set": ["hwk", "user", "mfa"]
            }
          }
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "remove the Android app",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/native-apps/{{androidAppId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    }
  ]
}
