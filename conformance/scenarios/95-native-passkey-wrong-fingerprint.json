      }
    },
    {
      "name": "the right origin with a trailing slash: start a passkey sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "android",
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "step": {
              "status": "needs_first_factor",
