{
  "$schema": "../scenario.schema.json",
  "name": "second factor lockout",
  "description": "Wrong second-factor codes are checked six times for one user; after that every try is answered with rate_limited and a retry time, whatever is sent. The count is the user's, shared by authenticator codes and backup codes and by every sign-in attempt: a correct backup code and a new attempt are locked out too, and no tokens are returned.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signUpCode"
      }
    },
    {
      "name": "verify the address",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{signUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "start an authenticator enrolment",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/factors/totp",
        "accessToken": "{{accessToken}}",
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "secret": {
            "$matches": "^[A-Z2-7]{32}$"
          },
          "uri": {
            "$matches": "^otpauth://totp/"
          }
        }
      },
      "capture": {
        "secret": "secret"
      }
    },
    {
      "name": "compute the code the authenticator shows",
      "totp": {
        "secret": "{{secret}}",
        "capture": "enrolCode",
        "captureWrong": "wrongCode"
      }
    },
    {
      "name": "confirm it: two-step verification is on, with ten backup codes",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/factors/totp/confirm",
        "accessToken": "{{accessToken}}",
        "body": {
          "code": "{{enrolCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "codes": [
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            },
            {
              "$matches": "^[2-9a-hjkmnp-z]{5}-[2-9a-hjkmnp-z]{5}$"
            }
          ]
        }
      },
      "capture": {
        "backupCode": "codes[0]"
      }
    },
    {
      "name": "start a sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_password"
          }
        }
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "the password alone yields needs_second_factor and no tokens",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_second_factor",
            "options": ["totp", "backup_code"]
          },
          "session": "$absent"
        }
      }
    },
    {
      "name": "six wrong authenticator codes are each mfa.invalid_code",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/second-factor",
        "attempt": "{{signInSecret}}",
        "body": {
          "method": "totp",
          "code": "{{wrongCode}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "status": 422,
          "code": "mfa.invalid_code"
        }
      },
      "times": 6
    },
    {
      "name": "the seventh try is locked out, with a Retry-After header",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/second-factor",
        "attempt": "{{signInSecret}}",
        "body": {
          "method": "totp",
          "code": "{{wrongCode}}"
        }
      },
      "expect": {
        "status": 429,
        "body": {
          "status": 429,
          "code": "rate_limited",
          "params": {
            "retryAfter": "$any"
          }
        }
      },
      "captureHeaders": {
        "retryAfter": "Retry-After"
      }
    },
    {
      "name": "a correct backup code is locked out the same: one budget for both methods",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/second-factor",
        "attempt": "{{signInSecret}}",
        "body": {
          "method": "backup_code",
          "code": "{{backupCode}}"
        }
      },
      "expect": {
        "status": 429,
        "body": {
          "status": 429,
          "code": "rate_limited",
          "params": {
            "retryAfter": "$any"
          }
        }
      },
      "captureHeaders": {
        "retryAfterBackup": "Retry-After"
      }
    },
    {
      "name": "start another sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_password"
          }
        }
      },
      "capture": {
        "signIn2Id": "id",
        "signIn2Secret": "attemptSecret"
      }
    },
    {
      "name": "the password is still accepted: its lockout is a separate one",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signIn2Id}}/password",
        "attempt": "{{signIn2Secret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_second_factor",
            "options": ["totp", "backup_code"]
          },
          "session": "$absent"
        }
      }
    },
    {
      "name": "but the second factor is locked for the user, not for the attempt",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signIn2Id}}/second-factor",
        "attempt": "{{signIn2Secret}}",
        "body": {
          "method": "backup_code",
          "code": "{{backupCode}}"
        }
      },
      "expect": {
        "status": 429,
        "body": {
          "status": 429,
          "code": "rate_limited",
          "params": {
            "retryAfter": "$any"
          }
        }
      }
    }
  ]
}
