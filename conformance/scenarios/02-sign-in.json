{
  "$schema": "../scenario.schema.json",
  "name": "sign-in",
  "description": "Sign-in never reveals whether an address has an account: starting one always asks for a password, and every failure is the same error.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    },
    "stranger": {
      "generate": "email"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification",
            "strategies": ["email_code"]
          },
          "session": "$absent"
        }
      },
      "capture": {
        "signUpId": "id"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code",
        "captureWrong": "wrongCode"
      }
    },
    {
      "name": "the right code completes the sign-up and returns tokens in the body for a native client",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "complete",
            "userId": "$any",
            "sessionId": "$any"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "sessionId": "step.sessionId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "starting a sign-in for a known address asks for the password",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_in",
          "step": {
            "status": "needs_password"
          },
          "session": "$absent"
        }
      },
      "capture": {
        "signInId": "id"
      }
    },
    {
      "name": "starting one for an unknown address answers exactly the same",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{stranger}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_in",
          "step": {
            "status": "needs_password"
          },
          "session": "$absent"
        }
      },
      "capture": {
        "strangerSignInId": "id"
      }
    },
    {
      "name": "a wrong password is auth.invalid_credentials",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "body": {
          "password": "{{password}}-wrong"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "so is any password for an unknown address",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{strangerSignInId}}/password",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "status": 401,
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "the right password completes the sign-in with a new session",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}",
            "sessionId": {
              "$not": "{{sessionId}}"
            }
          },
          "session": {
            "accessToken": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        }
      },
      "capture": {
        "secondAccessToken": "session.accessToken",
        "secondSessionId": "step.sessionId"
      }
    },
    {
      "name": "both devices are listed, and the one asking is marked current",
      "request": {
        "method": "GET",
        "path": "/v1/client/sessions",
        "accessToken": "{{secondAccessToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "data": [
            {
              "current": "$any"
            },
            {
              "current": "$any"
            }
          ]
        }
      }
    }
  ]
}
