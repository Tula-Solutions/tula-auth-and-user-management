{
  "$schema": "../scenario.schema.json",
  "name": "passkeys switched off mid-attempt",
  "description": "Switching passkeys off takes effect on every step, not only on new attempts: a sign-in started while they were on cannot finish with one afterwards, nothing is offered or registered, and the refusal uses nothing up. Switched back on, the same assertion completes. A user can still see and remove their passkeys while the method is off.",
  "needsSecretKey": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "signUpCode"
      }
    },
    {
      "name": "verify the address: the account exists and is signed in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{signUpCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          }
        }
      },
      "capture": {
        "userId": "step.userId",
        "accessToken": "session.accessToken",
        "refreshToken": "session.refreshToken"
      }
    },
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "passwordMethod": "settings.signIn.methods.password",
        "emailCodeMethod": "settings.signIn.methods.emailCode",
        "emailLinkMethod": "settings.signIn.methods.emailLink",
        "signUpSettings": "settings.signUp",
        "redirects": "settings.urls.allowedRedirectUrls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa"
      }
    },
    {
      "name": "switch passkeys on, with a relying-party id and an origin that belongs to it",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "$json": "{{passwordMethod}}"
              },
              "emailCode": {
                "$json": "{{emailCodeMethod}}"
              },
              "emailLink": {
                "$json": "{{emailLinkMethod}}"
              },
              "passkey": {
                "enabled": true
              }
            }
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "allowedOrigins": ["https://app.passkeys.example"],
            "allowedRedirectUrls": {
              "$json": "{{redirects}}"
            }
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "rpId": "passkeys.example"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "passkeys": {
              "rpId": "passkeys.example"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      }
    },
    {
      "name": "ask for the options to create a passkey",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys/options",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "rp": {
            "id": "passkeys.example",
            "name": "$any"
          },
          "challenge": {
            "$matches": "^[A-Za-z0-9_-]{43}$"
          },
          "authenticatorSelection": {
            "residentKey": "required",
            "requireResidentKey": true,
            "userVerification": "required"
          },
          "attestation": "none"
        }
      },
      "captureJson": {
        "creationOptions": ""
      }
    },
    {
      "name": "the authenticator makes a passkey",
      "passkey": {
        "authenticator": "phone",
        "create": "{{creationOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "registration"
      }
    },
    {
      "name": "finish: the passkey is stored, and the answer holds no key material",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{registration}}"
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "name": "Passkey",
          "synced": false,
          "createdAt": "$any",
          "lastUsedAt": null,
          "publicKey": "$absent",
          "credentialId": "$absent"
        }
      },
      "capture": {
        "passkeyId": "id"
      }
    },
    {
      "name": "start a passkey sign-in: no identifier, and options that name no credential",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "ios",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "kind": "sign_in",
            "step": {
              "status": "needs_first_factor",
              "strategies": ["passkey"]
            },
            "attemptSecret": {
              "$matches": "^tula_at_"
            }
          },
          "options": {
            "challenge": {
              "$matches": "^[A-Za-z0-9_-]{43}$"
            },
            "timeout": 300000,
            "rpId": "passkeys.example",
            "userVerification": "required",
            "allowCredentials": "$absent"
          }
        }
      },
      "capture": {
        "signInId": "attempt.id",
        "signInSecret": "attempt.attemptSecret"
      },
      "captureJson": {
        "signInOptions": "options"
      }
    },
    {
      "name": "the authenticator signs the challenge",
      "passkey": {
        "authenticator": "phone",
        "get": "{{signInOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "signInAssertion"
      }
    },
    {
      "name": "read the revision the settings are at",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "passwordMethod": "settings.signIn.methods.password",
        "emailCodeMethod": "settings.signIn.methods.emailCode",
        "emailLinkMethod": "settings.signIn.methods.emailLink",
        "signUpSettings": "settings.signUp",
        "redirects": "settings.urls.allowedRedirectUrls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa"
      }
    },
    {
      "name": "switch passkeys off",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "$json": "{{passwordMethod}}"
              },
              "emailCode": {
                "$json": "{{emailCodeMethod}}"
              },
              "emailLink": {
                "$json": "{{emailLinkMethod}}"
              },
              "passkey": {
                "enabled": false
              }
            }
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "allowedOrigins": ["https://app.passkeys.example"],
            "allowedRedirectUrls": {
              "$json": "{{redirects}}"
            }
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "rpId": "passkeys.example"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "passkeys": {
              "rpId": "passkeys.example"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      }
    },
    {
      "name": "the step is refused: the method is off",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/passkey",
        "attempt": "{{signInSecret}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{signInAssertion}}"
          }
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "status": 403,
          "code": "auth.method_disabled",
          "params": {
            "method": "passkey"
          }
        }
      }
    },
    {
      "name": "a new passkey sign-in cannot start",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "ios",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 403,
        "body": {
          "status": 403,
          "code": "auth.method_disabled"
        }
      }
    },
    {
      "name": "a sign-in start no longer offers it",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_password"
          }
        }
      }
    },
    {
      "name": "nothing can be registered",
      "request": {
        "method": "POST",
        "path": "/v1/client/me/passkeys/options",
        "accessToken": "{{accessToken}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 403,
        "body": {
          "status": 403,
          "code": "auth.method_disabled"
        }
      }
    },
    {
      "name": "the user still sees their passkey",
      "request": {
        "method": "GET",
        "path": "/v1/client/me/passkeys",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "passkeys": [
            {
              "id": "{{passkeyId}}",
              "name": "Passkey",
              "synced": false,
              "createdAt": "$any",
              "lastUsedAt": null
            }
          ]
        }
      }
    },
    {
      "name": "read the revision the settings are at",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "passwordMethod": "settings.signIn.methods.password",
        "emailCodeMethod": "settings.signIn.methods.emailCode",
        "emailLinkMethod": "settings.signIn.methods.emailLink",
        "signUpSettings": "settings.signUp",
        "redirects": "settings.urls.allowedRedirectUrls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa"
      }
    },
    {
      "name": "switch passkeys back on",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "$json": "{{passwordMethod}}"
              },
              "emailCode": {
                "$json": "{{emailCodeMethod}}"
              },
              "emailLink": {
                "$json": "{{emailLinkMethod}}"
              },
              "passkey": {
                "enabled": true
              }
            }
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "allowedOrigins": ["https://app.passkeys.example"],
            "allowedRedirectUrls": {
              "$json": "{{redirects}}"
            }
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "rpId": "passkeys.example"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "passkeys": {
              "rpId": "passkeys.example"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      }
    },
    {
      "name": "the refusal used nothing up: the same assertion now signs in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/passkey",
        "attempt": "{{signInSecret}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{signInAssertion}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "sub": "{{userId}}",
            "auth_time": "$any",
            "amr": {
              "$set": ["hwk", "user", "mfa"]
            }
          }
        }
      }
    },
    {
      "name": "read the revision the settings are at",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": "$any"
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "app": "settings.app",
        "passwordPolicy": "settings.password",
        "passwordMethod": "settings.signIn.methods.password",
        "emailCodeMethod": "settings.signIn.methods.emailCode",
        "emailLinkMethod": "settings.signIn.methods.emailLink",
        "signUpSettings": "settings.signUp",
        "redirects": "settings.urls.allowedRedirectUrls",
        "audit": "settings.audit",
        "notifications": "settings.notifications",
        "mfaSettings": "settings.mfa"
      }
    },
    {
      "name": "switch passkeys off again",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{app}}"
          },
          "password": {
            "$json": "{{passwordPolicy}}"
          },
          "signIn": {
            "methods": {
              "password": {
                "$json": "{{passwordMethod}}"
              },
              "emailCode": {
                "$json": "{{emailCodeMethod}}"
              },
              "emailLink": {
                "$json": "{{emailLinkMethod}}"
              },
              "passkey": {
                "enabled": false
              }
            }
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "allowedOrigins": ["https://app.passkeys.example"],
            "allowedRedirectUrls": {
              "$json": "{{redirects}}"
            }
          },
          "audit": {
            "$json": "{{audit}}"
          },
          "notifications": {
            "$json": "{{notifications}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "rpId": "passkeys.example"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "passkeys": {
              "rpId": "passkeys.example"
            }
          }
        }
      },
      "captureHeaders": {
        "etag": "ETag"
      }
    },
    {
      "name": "with the method off the user can still remove their passkey",
      "request": {
        "method": "DELETE",
        "path": "/v1/client/me/passkeys/{{passkeyId}}",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 204
      }
    }
  ],
  "cleanup": [
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
