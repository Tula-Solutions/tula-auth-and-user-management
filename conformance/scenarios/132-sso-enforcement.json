{
  "$schema": "../scenario.schema.json",
  "name": "sso enforcement removes the other first factors of a domain",
  "description": "A connection with enforced on is the only way in for the domains it binds (ADR 0067): the strategies offered are single sign-on alone, the same for an address with an account and one without, and the password route answers both with the generic auth.invalid_credentials, so that a break-glass member's failure is no different. A break-glass role changes nothing for an address that is not a member. The connection and the settings are put back afterwards.",
  "needsSecretKey": true,
  "variables": {
    "suffix": {
      "generate": "snowflake"
    }
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "appSettings": "settings.app",
        "passwordSettings": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urlsSettings": "settings.urls",
        "auditSettings": "settings.audit",
        "notificationsSettings": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeysSettings": "settings.passkeys",
        "smsSettings": "settings.sms",
        "emailsSettings": "settings.emails"
      }
    },
    {
      "name": "an administrator switches organizations and single sign-on on",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{appSettings}}"
          },
          "password": {
            "$json": "{{passwordSettings}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urlsSettings}}"
          },
          "audit": {
            "$json": "{{auditSettings}}"
          },
          "notifications": {
            "$json": "{{notificationsSettings}}"
          },
          "mfa": {
            "policy": "required"
          },
          "passkeys": {
            "$json": "{{passkeysSettings}}"
          },
          "sms": {
            "$json": "{{smsSettings}}"
          },
          "emails": {
            "$json": "{{emailsSettings}}"
          },
          "organizations": {
            "enabled": true,
            "allowUserCreated": false,
            "maxCreatedPerUser": 1,
            "creatorRole": "admin",
            "defaultRole": "member",
            "personalAccount": true
          },
          "sso": {
            "enabled": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sso": {
              "enabled": true
            }
          }
        }
      }
    },
    {
      "name": "an administrator creates an organization",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations",
        "auth": "secret",
        "body": {
          "name": "SSO Org",
          "slug": "sso-{{suffix}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "orgId": "id"
      }
    },
    {
      "name": "and claims its domain",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains",
        "auth": "secret",
        "body": {
          "domain": "s{{suffix}}.example",
          "email": "it@s{{suffix}}.example",
          "mode": "suggest"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "domainId": "id"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "it@s{{suffix}}.example",
        "capture": "domainCode"
      }
    },
    {
      "name": "the emailed code verifies the domain",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains/{{domainId}}/verify",
        "auth": "secret",
        "body": {
          "code": "{{domainCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "verified"
        }
      }
    },
    {
      "name": "learn the mock identity provider's issuer",
      "sso": {
        "captureIssuer": "issuer"
      }
    },
    {
      "name": "an administrator creates an OIDC connection, as a draft",
      "request": {
        "method": "POST",
        "path": "/v1/admin/sso-connections",
        "auth": "secret",
        "body": {
          "organizationId": "{{orgId}}",
          "name": "Mock IdP",
          "issuer": "{{issuer}}",
          "clientId": "conformance-sso",
          "clientSecret": "conformance-sso-secret",
          "domains": ["s{{suffix}}.example"]
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "organizationId": "{{orgId}}",
          "protocol": "oidc",
          "name": "Mock IdP",
          "status": "draft",
          "issuer": "{{issuer}}",
          "clientId": "conformance-sso",
          "clientSecretSet": true,
          "defaultRole": "member",
          "domains": ["s{{suffix}}.example"],
          "createdAt": "$any",
          "updatedAt": "$any"
        },
        "bodyExcludes": ["conformance-sso-secret"]
      },
      "capture": {
        "connectionId": "id"
      }
    },
    {
      "name": "an administrator starts a test sign-in of the connection",
      "request": {
        "method": "POST",
        "path": "/v1/admin/sso-connections/{{connectionId}}/tests",
        "auth": "secret",
        "body": {
          "redirectUrl": "http://localhost:5174/oauth/callback"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "testId": "$any",
          "authorizationUrl": "$any"
        }
      },
      "capture": {
        "testId": "testId",
        "testUrl": "authorizationUrl"
      }
    },
    {
      "name": "the administrator signs in at the identity provider as someone on the domain",
      "sso": {
        "authorizationUrl": "{{testUrl}}",
        "email": "tester-{{suffix}}@s{{suffix}}.example",
        "captureTest": "returnedTest"
      }
    },
    {
      "name": "the test passed",
      "request": {
        "method": "GET",
        "path": "/v1/admin/sso-connections/{{connectionId}}/tests/{{testId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "testId": "{{testId}}",
          "status": "passed",
          "reason": null,
          "message": null,
          "attributes": "$any",
          "groups": "$any",
          "mapped": {
            "email": "tester-{{suffix}}@s{{suffix}}.example",
            "givenName": null,
            "familyName": null,
            "emailOnVerifiedDomain": true
          }
        }
      }
    },
    {
      "name": "the administrator activates it",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "active"
        }
      }
    },
    {
      "name": "the administrator enforces it and activates it",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "enforced": true,
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "enforced": true,
          "status": "active"
        }
      }
    },
    {
      "name": "an address on the domain is offered single sign-on alone",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "ada-{{suffix}}@s{{suffix}}.example"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_first_factor",
            "strategies": ["sso"]
          }
        }
      },
      "capture": {
        "knownId": "id",
        "knownSecret": "attemptSecret"
      }
    },
    {
      "name": "an address with no account is offered the same",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "nobody-{{suffix}}@s{{suffix}}.example"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_first_factor",
            "strategies": ["sso"]
          }
        }
      },
      "capture": {
        "unknownId": "id",
        "unknownSecret": "attemptSecret"
      }
    },
    {
      "name": "the password route refuses the first",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{knownId}}/password",
        "client": "ios",
        "attempt": "{{knownSecret}}",
        "body": {
          "password": "Correct-Horse-9-battery"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "and the second the same way",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{unknownId}}/password",
        "client": "ios",
        "attempt": "{{unknownSecret}}",
        "body": {
          "password": "Correct-Horse-9-battery"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "a break-glass role is set",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "breakGlassRole": "admin"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "breakGlassRole": "admin"
        }
      }
    },
    {
      "name": "a non-member starts again",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "ghost-{{suffix}}@s{{suffix}}.example"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "strategies": ["sso"]
          }
        }
      },
      "capture": {
        "ghostId": "id",
        "ghostSecret": "attemptSecret"
      }
    },
    {
      "name": "and the password is still refused for them",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{ghostId}}/password",
        "client": "ios",
        "attempt": "{{ghostSecret}}",
        "body": {
          "password": "Correct-Horse-9-battery"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "the administrator switches enforcement off",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "enforced": false
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "enforced": false
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "disable the connection",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "status": "disabled"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
