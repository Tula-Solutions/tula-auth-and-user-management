{
  "$schema": "../scenario.schema.json",
  "name": "dashboard credential rules",
  "description": "An admin route takes a secret key, or a dashboard session together with an environment header: never a mix, and a request that says it is the dashboard's (x-tula-dashboard) is held to the browser rules before anything else is looked at. Without a session cookie it is simply not signed in, whatever environment it names. From another site's origin, marked cross-site by the browser, or changing state with no Origin, it is refused. A secret key by itself works as it always did.",
  "needsSecretKey": true,
  "steps": [
    {
      "name": "a secret key by itself works",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users?size=1",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "a dashboard request with no session is not signed in",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users",
        "auth": "none",
        "headers": {
          "x-tula-dashboard": "1"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.unauthenticated"
        }
      }
    },
    {
      "name": "whatever environment it names: nothing is told about environments",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users",
        "auth": "none",
        "headers": {
          "x-tula-dashboard": "1",
          "x-tula-environment": "00000000-0000-7000-8000-00000000dead"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.unauthenticated"
        }
      }
    },
    {
      "name": "a secret key and the dashboard header together are refused",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users",
        "auth": "secret",
        "headers": {
          "x-tula-dashboard": "1"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "request.malformed"
        }
      }
    },
    {
      "name": "a secret key cannot choose an environment with a header",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users",
        "auth": "secret",
        "headers": {
          "x-tula-environment": "00000000-0000-7000-8000-00000000dead"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "request.malformed"
        }
      }
    },
    {
      "name": "a dashboard request from another site's origin is refused",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users",
        "auth": "none",
        "headers": {
          "x-tula-dashboard": "1",
          "Origin": "https://conformance-foreign.example"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "request.origin_not_allowed"
        }
      }
    },
    {
      "name": "one the browser marks cross-site is refused",
      "request": {
        "method": "GET",
        "path": "/v1/admin/users",
        "auth": "none",
        "headers": {
          "x-tula-dashboard": "1",
          "Sec-Fetch-Site": "cross-site"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "request.origin_not_allowed"
        }
      }
    },
    {
      "name": "one that changes state with no Origin is refused",
      "request": {
        "method": "POST",
        "path": "/v1/admin/users",
        "auth": "none",
        "headers": {
          "x-tula-dashboard": "1"
        },
        "body": {
          "email": "nobody@conformance.example"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "request.origin_not_allowed"
        }
      }
    },
    {
      "name": "and the secret key still works afterwards",
      "request": {
        "method": "GET",
        "path": "/v1/admin/environments",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
