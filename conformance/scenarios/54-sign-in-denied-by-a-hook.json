{
  "$schema": "../scenario.schema.json",
  "name": "sign-in denied by a hook",
  "description": "An operator registers a `before_session` hook. It is asked when every factor of a sign-in has been proven and its session is about to be created, and at no earlier step: a sign-in's start and a wrong password do not reach it, so whether it was asked says nothing to someone who cannot sign in. Its question is a signed POST whose body is the contract's allow-list (the user's id, the client kind, the session profile, what was proven, whether the sign-in created the account, the IP address) and holds no email address. When it answers deny, the client gets `hook.denied` with the operator's own message code and no session, the attempt has ended, and no `session.created` entry was written; the account is untouched. When it answers allow, a new sign-in completes. Needs a receiver the server can reach.",
  "needsSecretKey": true,
  "needsWebhookReceiver": true,
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "start a sign-up, before any hook exists",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "the account exists and has its first session",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "$any"
          }
        }
      },
      "capture": {
        "userId": "step.userId"
      }
    },
    {
      "name": "start the operator's endpoint: it denies with a code of its own",
      "hook": {
        "receiver": "gate",
        "captureUrl": "hookUrl",
        "answer": {
          "decision": "deny",
          "code": "account_suspended"
        }
      }
    },
    {
      "name": "register the hook that is asked before a session",
      "request": {
        "method": "POST",
        "path": "/v1/admin/hooks",
        "auth": "secret",
        "body": {
          "point": "before_session",
          "url": "{{hookUrl}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "point": "before_session",
          "enabled": true,
          "failureMode": "deny",
          "secret": "$any"
        }
      },
      "capture": {
        "hookId": "id",
        "secret": "secret"
      }
    },
    {
      "name": "start a sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "a wrong password is refused as ever",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "not-{{password}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "auth.invalid_credentials"
        }
      }
    },
    {
      "name": "neither the start nor the wrong password asked the hook",
      "hook": {
        "receiver": "gate",
        "expect": {
          "nothing": true
        }
      }
    },
    {
      "name": "the right password proves the user, the hook denies, and the client is told its code",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "status": 403,
          "code": "hook.denied",
          "params": {
            "code": "account_suspended"
          },
          "session": "$absent",
          "step": "$absent"
        }
      }
    },
    {
      "name": "the question was signed with the hook's secret and held the allow-list only",
      "hook": {
        "receiver": "gate",
        "expect": {
          "secret": "{{secret}}",
          "body": {
            "id": "$any",
            "type": "hook.before_session",
            "schemaVersion": 1,
            "occurredAt": "$any",
            "data": {
              "userId": "{{userId}}",
              "client": "ios",
              "profile": "mobile",
              "amr": {
                "$set": ["pwd"]
              },
              "signUp": false,
              "email": "$absent"
            }
          }
        }
      }
    },
    {
      "name": "the attempt has ended",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "code": "flow.not_found"
        }
      }
    },
    {
      "name": "the user's only session is still the sign-up's: the denied sign-in made none",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?actorId={{userId}}&action=session.created",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 1
          }
        },
        "bodyExcludes": ["account_suspended"]
      }
    },
    {
      "name": "the endpoint now allows",
      "hook": {
        "receiver": "gate",
        "answer": {
          "decision": "allow"
        }
      }
    },
    {
      "name": "start a new sign-in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "laterId": "id",
        "laterSecret": "attemptSecret"
      }
    },
    {
      "name": "it completes",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{laterId}}/password",
        "attempt": "{{laterSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          },
          "session": {
            "accessToken": "$any"
          }
        }
      }
    },
    {
      "name": "and the hook was asked about it",
      "hook": {
        "receiver": "gate",
        "expect": {
          "secret": "{{secret}}",
          "body": {
            "type": "hook.before_session",
            "data": {
              "userId": "{{userId}}",
              "signUp": false
            }
          }
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "remove the hook",
      "request": {
        "method": "DELETE",
        "path": "/v1/admin/hooks/{{hookId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 204
      }
    }
  ]
}
