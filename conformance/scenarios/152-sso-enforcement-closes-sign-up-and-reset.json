{
  "$schema": "../scenario.schema.json",
  "name": "sso enforcement closes sign-up and password reset to the domain",
  "description": "On an enforced domain (ADR 0067, decisions 8 and 12) a sign-up by password is refused with auth.method_disabled whoever asks, an address with an account and one without; a password reset is answered with the same step for an unknown address and a member, but no code is sent and no guess completes it; only a break-glass member is emailed a code and can set a password. The connection is disabled afterwards.",
  "needsSecretKey": true,
  "variables": {
    "suffix": {
      "generate": "snowflake"
    },
    "password": {
      "generate": "password"
    },
    "newPassword": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "read the settings and their revision",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "etag": "ETag"
      },
      "captureJson": {
        "original": "settings",
        "appSettings": "settings.app",
        "passwordSettings": "settings.password",
        "signInSettings": "settings.signIn",
        "signUpSettings": "settings.signUp",
        "urlsSettings": "settings.urls",
        "auditSettings": "settings.audit",
        "notificationsSettings": "settings.notifications",
        "mfaSettings": "settings.mfa",
        "passkeysSettings": "settings.passkeys",
        "smsSettings": "settings.sms",
        "emailsSettings": "settings.emails"
      }
    },
    {
      "name": "an administrator switches organizations and single sign-on on",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{etag}}"
        },
        "body": {
          "app": {
            "$json": "{{appSettings}}"
          },
          "password": {
            "$json": "{{passwordSettings}}"
          },
          "signIn": {
            "$json": "{{signInSettings}}"
          },
          "signUp": {
            "$json": "{{signUpSettings}}"
          },
          "urls": {
            "$json": "{{urlsSettings}}"
          },
          "audit": {
            "$json": "{{auditSettings}}"
          },
          "notifications": {
            "$json": "{{notificationsSettings}}"
          },
          "mfa": {
            "$json": "{{mfaSettings}}"
          },
          "passkeys": {
            "$json": "{{passkeysSettings}}"
          },
          "sms": {
            "$json": "{{smsSettings}}"
          },
          "emails": {
            "$json": "{{emailsSettings}}"
          },
          "organizations": {
            "enabled": true,
            "allowUserCreated": false,
            "maxCreatedPerUser": 1,
            "creatorRole": "admin",
            "defaultRole": "member",
            "personalAccount": true
          },
          "sso": {
            "enabled": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "settings": {
            "sso": {
              "enabled": true
            }
          }
        }
      }
    },
    {
      "name": "an administrator creates an organization",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations",
        "auth": "secret",
        "body": {
          "name": "SSO Org",
          "slug": "sso-{{suffix}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "orgId": "id"
      }
    },
    {
      "name": "and claims its domain",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains",
        "auth": "secret",
        "body": {
          "domain": "s{{suffix}}.example",
          "email": "it@s{{suffix}}.example",
          "mode": "suggest"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any"
        }
      },
      "capture": {
        "domainId": "id"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "it@s{{suffix}}.example",
        "capture": "domainCode"
      }
    },
    {
      "name": "the emailed code verifies the domain",
      "request": {
        "method": "POST",
        "path": "/v1/admin/organizations/{{orgId}}/domains/{{domainId}}/verify",
        "auth": "secret",
        "body": {
          "code": "{{domainCode}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "verified"
        }
      }
    },
    {
      "name": "learn the mock identity provider's issuer",
      "sso": {
        "captureIssuer": "issuer"
      }
    },
    {
      "name": "an administrator creates an OIDC connection, as a draft",
      "request": {
        "method": "POST",
        "path": "/v1/admin/sso-connections",
        "auth": "secret",
        "body": {
          "organizationId": "{{orgId}}",
          "name": "Mock IdP",
          "issuer": "{{issuer}}",
          "clientId": "conformance-sso",
          "clientSecret": "conformance-sso-secret",
          "domains": ["s{{suffix}}.example"]
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "$any",
          "organizationId": "{{orgId}}",
          "protocol": "oidc",
          "name": "Mock IdP",
          "status": "draft",
          "issuer": "{{issuer}}",
          "clientId": "conformance-sso",
          "clientSecretSet": true,
          "defaultRole": "member",
          "domains": ["s{{suffix}}.example"],
          "createdAt": "$any",
          "updatedAt": "$any"
        },
        "bodyExcludes": ["conformance-sso-secret"]
      },
      "capture": {
        "connectionId": "id"
      }
    },
    {
      "name": "a sign-in on the domain starts while the connection is a draft",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "ada-{{suffix}}@s{{suffix}}.example"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "draftId": "id",
        "draftSecret": "attemptSecret"
      }
    },
    {
      "name": "and is not offered single sign-on",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{draftId}}/sso",
        "client": "ios",
        "attempt": "{{draftSecret}}",
        "body": {
          "redirectUrl": "http://localhost:5174/oauth/callback"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "flow.invalid_step"
        }
      }
    },
    {
      "name": "an administrator starts a test sign-in of the connection",
      "request": {
        "method": "POST",
        "path": "/v1/admin/sso-connections/{{connectionId}}/tests",
        "auth": "secret",
        "body": {
          "redirectUrl": "http://localhost:5174/oauth/callback"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "testId": "$any",
          "authorizationUrl": "$any"
        }
      },
      "capture": {
        "testId": "testId",
        "testUrl": "authorizationUrl"
      }
    },
    {
      "name": "the administrator signs in at the identity provider as someone on the domain",
      "sso": {
        "authorizationUrl": "{{testUrl}}",
        "email": "tester-{{suffix}}@s{{suffix}}.example",
        "captureTest": "returnedTest"
      }
    },
    {
      "name": "the test passed",
      "request": {
        "method": "GET",
        "path": "/v1/admin/sso-connections/{{connectionId}}/tests/{{testId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "testId": "{{testId}}",
          "status": "passed",
          "reason": null,
          "message": null,
          "attributes": "$any",
          "groups": "$any",
          "mapped": {
            "email": "tester-{{suffix}}@s{{suffix}}.example",
            "givenName": null,
            "familyName": null,
            "emailOnVerifiedDomain": true
          }
        }
      }
    },
    {
      "name": "the administrator activates the connection",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "active"
        }
      }
    },
    {
      "name": "a new employee starts a sign-in with an address on the domain",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "ada-{{suffix}}@s{{suffix}}.example"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_first_factor"
          }
        }
      },
      "capture": {
        "firstId": "id",
        "firstSecret": "attemptSecret"
      }
    },
    {
      "name": "a new employee continues with single sign-on",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{firstId}}/sso",
        "client": "ios",
        "attempt": "{{firstSecret}}",
        "body": {
          "redirectUrl": "http://localhost:5174/oauth/callback"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "authorizationUrl": "$any",
          "binding": "$any",
          "attempt": {
            "id": "{{firstId}}"
          }
        }
      },
      "capture": {
        "firstUrl": "authorizationUrl",
        "firstBinding": "binding"
      }
    },
    {
      "name": "a new employee signs in at the identity provider; the callback hands the app a ticket",
      "sso": {
        "authorizationUrl": "{{firstUrl}}",
        "email": "ada-{{suffix}}@s{{suffix}}.example",
        "captureTicket": "firstTicket",
        "captureAttempt": "firstAttempt"
      }
    },
    {
      "name": "the ticket and the binding sign a new employee in",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/oauth/exchange",
        "client": "ios",
        "body": {
          "ticket": "{{firstTicket}}",
          "attemptId": "{{firstAttempt}}",
          "binding": "{{firstBinding}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "$any",
            "sessionId": "$any"
          },
          "session": {
            "accessToken": "$any",
            "refreshToken": "$any"
          }
        }
      },
      "capture": {
        "firstUserId": "step.userId",
        "firstToken": "session.accessToken"
      }
    },
    {
      "name": "the administrator enforces the connection",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "body": {
          "enforced": true
        },
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "enforced": true
        }
      }
    },
    {
      "name": "a sign-up with a new address on the domain is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "body": {
          "email": "newbie-{{suffix}}@s{{suffix}}.example",
          "password": "{{password}}"
        },
        "client": "ios"
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "auth.method_disabled"
        }
      }
    },
    {
      "name": "and one with an address that has an account is refused the same way",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "body": {
          "email": "ada-{{suffix}}@s{{suffix}}.example",
          "password": "{{password}}"
        },
        "client": "ios"
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "auth.method_disabled"
        }
      }
    },
    {
      "name": "a reset for an address with no account is answered like any other",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets",
        "body": {
          "email": "nobody-{{suffix}}@s{{suffix}}.example"
        },
        "client": "ios"
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "needs_new_password",
            "strategies": ["email_code"],
            "userId": "$absent"
          },
          "session": "$absent"
        }
      },
      "capture": {
        "unknownResetId": "id",
        "unknownResetSecret": "attemptSecret"
      }
    },
    {
      "name": "and no guess completes it",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{unknownResetId}}/password",
        "body": {
          "code": "000000",
          "password": "{{newPassword}}"
        },
        "attempt": "{{unknownResetSecret}}"
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "verification.invalid_code"
        }
      }
    },
    {
      "name": "a reset for a member who is not break-glass is answered the same",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets",
        "body": {
          "email": "ada-{{suffix}}@s{{suffix}}.example"
        },
        "client": "ios"
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "needs_new_password",
            "strategies": ["email_code"],
            "userId": "$absent"
          },
          "session": "$absent"
        }
      },
      "capture": {
        "memberResetId": "id",
        "memberResetSecret": "attemptSecret"
      }
    },
    {
      "name": "and no guess completes it either: no code was sent",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{memberResetId}}/password",
        "body": {
          "code": "000000",
          "password": "{{newPassword}}"
        },
        "attempt": "{{memberResetSecret}}"
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "verification.invalid_code"
        }
      }
    },
    {
      "name": "a break-glass role the member holds is set",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "body": {
          "breakGlassRole": "member"
        },
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "breakGlassRole": "member"
        }
      }
    },
    {
      "name": "let the per-address email cooldown pass",
      "wait": "61s"
    },
    {
      "name": "a reset for a break-glass member is answered the same",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets",
        "body": {
          "email": "ada-{{suffix}}@s{{suffix}}.example"
        },
        "client": "ios"
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "needs_new_password",
            "strategies": ["email_code"],
            "userId": "$absent"
          },
          "session": "$absent"
        }
      },
      "capture": {
        "glassResetId": "id",
        "glassResetSecret": "attemptSecret"
      }
    },
    {
      "name": "and a code is emailed to them",
      "emailCode": {
        "to": "ada-{{suffix}}@s{{suffix}}.example",
        "capture": "glassCode"
      }
    },
    {
      "name": "the code and a new password complete the break-glass reset",
      "request": {
        "method": "POST",
        "path": "/v1/client/password-resets/{{glassResetId}}/password",
        "body": {
          "code": "{{glassCode}}",
          "password": "{{newPassword}}"
        },
        "attempt": "{{glassResetSecret}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "password_reset",
          "step": {
            "status": "complete",
            "userId": "{{firstUserId}}"
          }
        }
      }
    }
  ],
  "cleanup": [
    {
      "name": "disable the connection",
      "request": {
        "method": "PATCH",
        "path": "/v1/admin/sso-connections/{{connectionId}}",
        "auth": "secret",
        "body": {
          "enforced": false,
          "status": "disabled"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "read the revision the settings are at now",
      "request": {
        "method": "GET",
        "path": "/v1/admin/settings",
        "auth": "secret"
      },
      "expect": {
        "status": 200
      },
      "captureHeaders": {
        "cleanupEtag": "ETag"
      }
    },
    {
      "name": "put the original settings back",
      "request": {
        "method": "PUT",
        "path": "/v1/admin/settings",
        "auth": "secret",
        "headers": {
          "If-Match": "{{cleanupEtag}}"
        },
        "body": {
          "$json": "{{original}}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
