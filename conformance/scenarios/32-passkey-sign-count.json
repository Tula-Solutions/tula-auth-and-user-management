        "capture": "sixAssertion",
        "counter": 6
      }
    },
    {
      "name": "the stored counter did not move: 6 is accepted",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{sixId}}/passkey",
        "attempt": "{{sixSecret}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{sixAssertion}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete",
            "userId": "{{userId}}"
          },
          "session": {
            "sessionId": "$any",
            "accessToken": "$any",
            "accessTokenExpiresAt": "$any",
            "refreshToken": {
              "$matches": "^tula_rt_"
            }
          }
        },
        "claims": {
          "session.accessToken": {
            "sub": "{{userId}}",
