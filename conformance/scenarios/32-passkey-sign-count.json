        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "ios",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "attempt": {
            "kind": "sign_in",
            "step": {
