            "userVerification": "required",
            "allowCredentials": "$absent"
          }
        }
      },
      "capture": {
        "zeroId": "attempt.id",
        "zeroSecret": "attempt.attemptSecret"
      },
      "captureJson": {
        "zeroOptions": "options"
      }
    },
    {
      "name": "the authenticator signs the challenge",
      "passkey": {
        "authenticator": "phone",
        "get": "{{zeroOptions}}",
        "origin": "https://app.passkeys.example",
        "capture": "zeroAssertion",
        "counter": 0
      }
    },
    {
      "name": "a counter back at zero is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{zeroId}}/passkey",
        "attempt": "{{zeroSecret}}",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {
          "credential": {
            "$json": "{{zeroAssertion}}"
          }
        }
      },
