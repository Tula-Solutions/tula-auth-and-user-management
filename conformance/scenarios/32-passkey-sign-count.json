    {
      "name": "each refusal is in the audit log, without the credential",
      "request": {
        "method": "GET",
        "path": "/v1/admin/audit-logs?action=user.passkey_counter_regressed&targetId={{userId}}",
        "auth": "secret"
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "totalCount": 3
          },
          "data": [
            {
              "action": "user.passkey_counter_regressed",
              "target": {
                "type": "user",
                "id": "{{userId}}"
              },
              "metadata": {
                "passkeyId": "{{passkeyId}}"
              }
            },
            {
              "action": "user.passkey_counter_regressed"
            },
            {
              "action": "user.passkey_counter_regressed"
            }
          ]
        }
      }
    },
    {
      "name": "start a passkey sign-in: no identifier, and options that name no credential",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/passkey",
        "client": "ios",
        "headers": {
          "Origin": "https://app.passkeys.example"
        },
        "body": {}
      },
