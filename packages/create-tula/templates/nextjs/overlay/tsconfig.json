{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": false,
    "incremental": false,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "app/**/*",
    "proxy.ts",
    "next.config.ts",
    "types.d.ts",
    "tula.config.ts",
    "next-env.d.ts"
  ]
}
