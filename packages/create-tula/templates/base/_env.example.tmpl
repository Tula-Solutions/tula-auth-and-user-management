# What .env holds. create-tula generated the real one (it is ignored by git); a teammate copies
# this file to .env and fills in values of their own:
#   openssl rand -hex 32   # for each of the four secrets
COMPOSE_PROJECT_NAME={{name}}
TULA_API_IMAGE={{apiImage}}
TULA_MASTER_KEY=
TULA_ADMIN_TOKEN=
POSTGRES_PASSWORD=
TULA_API_DB_PASSWORD=
API_PORT={{apiPort}}
MAILPIT_UI_PORT={{mailpitPort}}
# Local development only. Serves every OAuth provider from a built-in mock provider that
# signs in as any address typed into its consent page: for trying the provider buttons before
# you have real credentials. Never on an API anyone else can reach.
# OAUTH_MOCK_PROVIDER=true
# Text messages (a phone number on an account). `dev` keeps them in a local inbox instead of
# sending them (local development only). `twilio` really sends them: it needs the account,
# ONE way to authenticate (an API key and its secret, or the auth token) and ONE sender (a
# Messaging Service, or a number in E.164 form). Each environment also has to switch text
# messages on in its settings, and say which countries.
# SMS_PROVIDER=dev
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=
