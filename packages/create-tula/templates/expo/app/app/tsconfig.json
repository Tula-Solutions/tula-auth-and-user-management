{
  // The app's own configuration, for when it is installed (`README.md`): Expo's base and
  // strict mode. The repository checks the same sources with `../tsconfig.json`, which has
  // no React Native to read declarations from.
  "extends": "expo/tsconfig.base",
  "compilerOptions": { "strict": true },
  "include": ["**/*.ts", "**/*.tsx"]
}
