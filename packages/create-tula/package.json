{
  "name": "create-tula",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Scaffold a Tula Auth project: a Compose file, a .env with generated secrets, tula.config.ts and an example app (`bun create tula`).",
  "keywords": [
    "tula",
    "auth",
    "authentication",
    "user-management",
    "create",
    "scaffold",
    "starter",
    "self-hosted"
  ],
  "homepage": "https://github.com/Tula-Solutions/tula-auth-and-user-management/tree/main/packages/create-tula#readme",
  "bugs": {
    "url": "https://github.com/Tula-Solutions/tula-auth-and-user-management/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tula-Solutions/tula-auth-and-user-management.git",
    "directory": "packages/create-tula"
  },
  "sideEffects": false,
  "bin": {
    "create-tula": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "bin": {
      "create-tula": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "templates:sync": "bun run scripts/sync-templates.ts && bun run ../mcp/scripts/sync-scaffolds.ts",
    "generate:check": "bun run scripts/sync-templates.ts --check"
  },
  "devDependencies": {
    "@tula-tech/example-nextjs": "workspace:*",
    "@tula-tech/example-react-vite": "workspace:*",
    "@tula-tech/tsconfig": "workspace:*"
  }
}
