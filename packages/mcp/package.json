{
  "name": "@tula-tech/mcp",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Tula's Model Context Protocol server (`tula mcp`): tools that read an environment's users, sessions, audit entries and settings, scaffolds for the provider, a protected route and a sign-in page, and one tool that runs a sign-in test where the environment allows one (a throwaway user, made and deleted). It changes nothing else and returns no secret.",
  "keywords": [
    "tula",
    "auth",
    "authentication",
    "user-management",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ],
  "homepage": "https://github.com/Tula-Solutions/tula-auth-and-user-management/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/Tula-Solutions/tula-auth-and-user-management/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tula-Solutions/tula-auth-and-user-management.git",
    "directory": "packages/mcp"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "generate": "bun run scripts/sync-scaffolds.ts",
    "generate:check": "bun run scripts/sync-scaffolds.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "@tula-tech/admin": "workspace:*",
    "@tula-tech/config": "workspace:*",
    "@tula-tech/contract": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@tula-tech/api": "workspace:*",
    "@tula-tech/tsconfig": "workspace:*",
    "create-tula": "workspace:*"
  }
}
