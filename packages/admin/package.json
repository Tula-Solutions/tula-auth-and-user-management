{
  "name": "@tula-tech/admin",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Tula's typed admin API client for servers and tooling: every /v1/admin operation, generated from the OpenAPI contract. Takes a secret key; never for a browser.",
  "keywords": [
    "tula",
    "auth",
    "authentication",
    "user-management",
    "admin",
    "api-client",
    "webhooks"
  ],
  "homepage": "https://github.com/Tula-Solutions/tula-auth-and-user-management/tree/main/packages/admin#readme",
  "bugs": {
    "url": "https://github.com/Tula-Solutions/tula-auth-and-user-management/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tula-Solutions/tula-auth-and-user-management.git",
    "directory": "packages/admin"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "edge-light": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "workerd": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "browser": {
          "types": "./dist/index.d.ts",
          "default": "./dist/browser.js"
        },
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit -p . && bun run typecheck:portable",
    "typecheck:portable": "tsc --noEmit -p tsconfig.portable.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "generate": "bun run scripts/generate.ts",
    "generate:check": "bun run scripts/generate.ts --check"
  },
  "dependencies": {
    "@tula-tech/contract": "workspace:*"
  },
  "devDependencies": {
    "@tula-tech/api": "workspace:*",
    "@tula-tech/tsconfig": "workspace:*"
  }
}
