{
  "name": "@tula-tech/core",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Tula's headless TypeScript client for browsers, Node, Bun and edge runtimes: server-driven flows, sessions and single-flight token refresh.",
  "keywords": [
    "tula",
    "auth",
    "authentication",
    "user-management",
    "client",
    "sdk",
    "sessions",
    "passkeys"
  ],
  "homepage": "https://github.com/Tula-Solutions/tula-auth-and-user-management/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Tula-Solutions/tula-auth-and-user-management/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tula-Solutions/tula-auth-and-user-management.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit -p . && bun run typecheck:portable",
    "typecheck:portable": "tsc --noEmit -p tsconfig.portable.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "generate": "bun run scripts/generate.ts",
    "generate:native": "bun run scripts/generate-native.ts",
    "generate:native:check": "bun run scripts/generate-native.ts --check",
    "generate:check": "bun run scripts/generate.ts --check && bun run scripts/generate-native.ts --check"
  },
  "dependencies": {
    "@tula-tech/contract": "workspace:*"
  },
  "devDependencies": {
    "@tula-tech/tsconfig": "workspace:*"
  }
}
