{
  "name": "@tula-tech/nextjs",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Tula's Next.js SDK: a same-origin proxy route handler, middleware that verifies sessions offline, server helpers and the React components for the App Router.",
  "keywords": [
    "tula",
    "auth",
    "authentication",
    "user-management",
    "nextjs",
    "next",
    "app-router",
    "middleware"
  ],
  "homepage": "https://github.com/Tula-Solutions/tula-auth-and-user-management/tree/main/packages/nextjs#readme",
  "bugs": {
    "url": "https://github.com/Tula-Solutions/tula-auth-and-user-management/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tula-Solutions/tula-auth-and-user-management.git",
    "directory": "packages/nextjs"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./middleware": "./src/middleware.ts",
    "./handlers": "./src/handlers.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./middleware": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.js"
      },
      "./handlers": {
        "types": "./dist/handlers.d.ts",
        "default": "./dist/handlers.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@tula-tech/contract": "workspace:*",
    "@tula-tech/core": "workspace:*",
    "@tula-tech/react": "workspace:*",
    "jose": "^6.2.12",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tula-tech/api": "workspace:*",
    "@tula-tech/tsconfig": "workspace:*",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
