{
  "name": "@tula/nextjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tula's Next.js SDK: a same-origin proxy route handler, middleware that verifies sessions offline, server helpers and the React components for the App Router.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./middleware": "./src/middleware.ts",
    "./handlers": "./src/handlers.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./middleware": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.js"
      },
      "./handlers": {
        "types": "./dist/handlers.d.ts",
        "default": "./dist/handlers.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@tula/contract": "workspace:*",
    "@tula/core": "workspace:*",
    "@tula/react": "workspace:*",
    "jose": "^6.2.12",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tula/api": "workspace:*",
    "@tula/tsconfig": "workspace:*",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
