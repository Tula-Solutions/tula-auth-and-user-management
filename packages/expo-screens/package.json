{
  "name": "@tula-tech/expo-screens",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Tula's native screens (SwiftUI, Compose) as Expo components, on the native clients: an Expo native module of its own, apart from the headless @tula-tech/expo, so that only an app that installs it compiles it.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./plugin": {
        "import": {
          "types": "./dist/plugin.d.ts",
          "default": "./dist/plugin.js"
        },
        "require": {
          "types": "./dist/plugin.d.cts",
          "default": "./dist/plugin.cjs"
        }
      },
      "./package.json": "./package.json"
    },
    "peerDependenciesMeta": {}
  },
  "files": [
    "dist",
    "android",
    "ios",
    "expo-module.config.json"
  ],
  "scripts": {
    "prebuild": "bun run scripts/vendor-native.ts",
    "build": "bunup",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@tula-tech/contract": "workspace:*",
    "@tula-tech/core": "workspace:*"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": "^19.0.0",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tula-tech/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react-dom": "^19.3.0"
  }
}
