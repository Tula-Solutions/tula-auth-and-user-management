# dependencies & build output
node_modules/
dist/
.release/
out/
.turbo/
coverage/
*.tsbuildinfo

# Swift Package Manager (swift build / swift test in native/swift)
.build/
.swiftpm/

# Playwright (bun run e2e)
e2e/test-results/
e2e/playwright-report/

# env — only the example is committed
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log

# Claude Code — shared harness is committed; personal + runtime state is not
.claude/settings.local.json
.claude/.state/
.claude/worktrees/
# a preview configuration the desktop app writes
.claude/launch.json

# Next.js (examples/nextjs-app-router)
.next/
next-env.d.ts

# The native SDKs' sources as @tula/expo-screens ships them: copied by its build
# (packages/expo-screens/scripts/vendor-native.ts), never edited, never committed.
packages/expo-screens/ios/vendor/
packages/expo-screens/android/vendor/

# Gradle and the IDEs that build with it (native/android, examples/compose, a scaffolded
# Compose project). A build started from a module's own directory leaves a `.gradle/`
# there, and an editor's Java support compiles into `bin/` beside each module's sources.
.gradle/
.kotlin/
native/android/*/bin/
