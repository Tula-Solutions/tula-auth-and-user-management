# dependencies & build output
node_modules/
dist/
.release/
out/
.turbo/
coverage/
*.tsbuildinfo

# Swift Package Manager (swift build / swift test in native/swift)
.build/
.swiftpm/

# Playwright (bun run e2e)
e2e/test-results/
e2e/playwright-report/

# env — only the example is committed
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log

# Claude Code — shared harness is committed; personal + runtime state is not
.claude/settings.local.json
.claude/.state/
.claude/worktrees/
# a preview configuration the desktop app writes
.claude/launch.json

# Next.js (examples/nextjs-app-router)
.next/
next-env.d.ts

# The native SDKs' sources as @tula/expo ships them: copied by its build
# (packages/expo/scripts/vendor-native.ts), never edited, never committed.
packages/expo/ios/vendor/
packages/expo/android/vendor/
