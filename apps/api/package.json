{
  "name": "@tula/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tula's auth API: Bun + Hono over Postgres.",
  "scripts": {
    "dev": "bun --env-file=../../.env run --hot src/server.ts",
    "start": "bun --env-file=../../.env run src/server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "contract:generate": "bun run src/scripts/generate-openapi.ts",
    "contract:check": "bun run src/scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@scalar/hono-api-reference": "^0.12.6",
    "@tula/contract": "workspace:*",
    "@tula/db": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "hono-openapi": "^1.3.3",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.12",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tula/tsconfig": "workspace:*",
    "@types/nodemailer": "^8.0.2"
  }
}
