{
  "name": "@tula-tech/docs",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "The documentation site: docs/**/*.md prerendered to static HTML. Never served by the API, never published.",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "serve": "bun run scripts/serve.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build:versions": "bun run scripts/build-versions.ts",
    "generate:check": "bun run scripts/build.ts --check"
  },
  "dependencies": {
    "@shikijs/transformers": "^4.5.0",
