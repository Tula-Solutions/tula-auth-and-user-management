        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/conformance/README.md",
        "$TURBO_ROOT$/apps/*/README.md",
        "$TURBO_ROOT$/packages/*/README.md",
        "$TURBO_ROOT$/examples/*/README.md"
